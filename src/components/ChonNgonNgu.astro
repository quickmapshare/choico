---
// Bộ chọn ngôn ngữ trên thanh đầu. Chọn xong chuyển sang cùng trang ở ngôn ngữ đó và nhớ lựa chọn.
import { NGON_NGU, t, duongDan } from "../i18n/strings.js";
const { lang = "vi", duongGoc = "/" } = Astro.props;
---
<label class="chon-ngon-ngu">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.6 2.7 3.9 5.7 3.9 9S14.6 18.3 12 21c-2.6-2.7-3.9-5.7-3.9-9S9.4 5.7 12 3z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
  <select id="chon-ngon-ngu" aria-label={t(lang, "ngonNguAria")}>
    {NGON_NGU.map((n) => <option value={duongDan(n.ma, duongGoc)} data-ma={n.ma} selected={n.ma === lang}>{n.ten}</option>)}
  </select>
</label>

<style is:global>
  .chon-ngon-ngu { position: relative; display: inline-flex; align-items: center; color: var(--phu); }
  .chon-ngon-ngu svg { position: absolute; left: .55rem; pointer-events: none; }
  .chon-ngon-ngu select {
    appearance: none; -webkit-appearance: none; font: inherit; font-size: .88rem; font-weight: 600; color: var(--phu);
    height: 2.1rem; padding: 0 .8rem 0 1.9rem; border: 1px solid var(--vien); border-radius: 999px; background: var(--mat); cursor: pointer;
    transition: border-color .15s, color .15s;
  }
  .chon-ngon-ngu select:hover { border-color: var(--nhan); color: var(--nhan); }
</style>

<script>
  // Nhớ lựa chọn rõ ràng của người dùng rồi mới chuyển trang. Lựa chọn này thắng ngôn ngữ trình duyệt ở lần sau.
  const chon = document.getElementById("chon-ngon-ngu") as HTMLSelectElement | null;
  chon?.addEventListener("change", () => {
    const ma = chon.selectedOptions[0]?.dataset.ma;
    try {
      if (ma) localStorage.setItem("choico-lang", ma);
    } catch {
      // không nhớ được thì vẫn chuyển trang
    }
    location.href = chon.value + location.search + location.hash;
  });
</script>

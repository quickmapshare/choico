---
// Nút chọn giao diện: tự động theo máy, sáng hoặc tối. Lựa chọn lưu trong trình duyệt của người dùng.
const { lang = "vi" } = Astro.props;
---
<button type="button" class="chuyen-theme" id="chuyen-theme" data-lang={lang}></button>

<script>
  import { t } from "../i18n/strings.js";

  const KHOA = "chophien-theme";
  const THU_TU = ["auto", "light", "dark"];
  const nut = document.getElementById("chuyen-theme");
  const lang = nut.dataset.lang ?? "vi";

  // Đọc lựa chọn đã lưu; localStorage có thể bị chặn nên luôn bọc try/catch
  function docLuaChon() {
    try {
      const luu = localStorage.getItem(KHOA);
      return THU_TU.includes(luu) ? luu : "auto";
    } catch {
      return "auto";
    }
  }

  // Biểu tượng SVG cho từng chế độ, vẽ bằng currentColor để theo màu chữ của nút
  const BIEU_TUONG = {
    auto: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" /></svg>',
    light: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M4.7 4.7l1.6 1.6M17.7 17.7l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.7 19.3l1.6-1.6M17.7 6.3l1.6-1.6" /></svg>',
    dark: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>',
  };

  function apDung(che) {
    const html = document.documentElement;
    if (che === "auto") html.removeAttribute("data-theme");
    else html.setAttribute("data-theme", che);
    html.style.colorScheme = che === "auto" ? "light dark" : che;
    const nhan = `${t(lang, "themeTieuDe")}: ${t(lang, "theme")[che]}`;
    nut.innerHTML = BIEU_TUONG[che];
    nut.title = nhan;
    nut.setAttribute("aria-label", nhan);
  }

  let che = docLuaChon();
  apDung(che);

  nut.addEventListener("click", () => {
    che = THU_TU[(THU_TU.indexOf(che) + 1) % THU_TU.length];
    try {
      localStorage.setItem(KHOA, che);
    } catch {
      // Không lưu được thì vẫn đổi giao diện cho lần xem này
    }
    apDung(che);
  });
</script>

<style>
  .chuyen-theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    color: var(--chu);
    background: var(--mat);
    border: 1px solid var(--vien);
    border-radius: .3rem;
    cursor: pointer;
  }
  .chuyen-theme:hover { border-color: var(--nhan); color: var(--nhan); }
</style>

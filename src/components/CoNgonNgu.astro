---
// Nút chuyển ngôn ngữ: cờ SVG và mã viết tắt. Hiển thị ngôn ngữ đích (ngôn ngữ sẽ chuyển sang).
const { lang, href } = Astro.props;
const dich = lang === "en" ? "vi" : "en";
const ten = dich === "en" ? "English" : "Tiếng Việt";
const ma = dich === "en" ? "EN" : "VN";
---
<a class="chuyen-ngu" href={href} hreflang={dich} lang={dich} aria-label={ten} title={ten}>
  {dich === "vi" ? (
    <svg class="co" viewBox="0 0 3 2" aria-hidden="true" focusable="false">
      <rect width="3" height="2" fill="#DA251D" />
      <polygon fill="#FFFF00" points="1.5,0.5 1.6117,0.8463 1.9755,0.8455 1.6807,1.0587 1.7939,1.4045 1.5,1.19 1.2061,1.4045 1.3193,1.0587 1.0245,0.8455 1.3883,0.8463" />
    </svg>
  ) : (
    <svg class="co" viewBox="0 0 60 30" aria-hidden="true" focusable="false">
      <clipPath id="co-uk-s"><path d="M0,0 v30 h60 v-30 z" /></clipPath>
      <clipPath id="co-uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <g clip-path="url(#co-uk-s)">
        <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#co-uk-t)" stroke="#C8102E" stroke-width="4" />
        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
        <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
      </g>
    </svg>
  )}
  <span>{ma}</span>
</a>

<style>
  .chuyen-ngu { display: inline-flex; align-items: center; gap: .35rem; font-size: .9rem; text-decoration: none; border: 1px solid var(--vien); border-radius: .3rem; padding: .15rem .5rem; }
  .co { width: 1.4rem; height: .95rem; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,.15); }
</style>

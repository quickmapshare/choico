---
// Form góp ý: "bao_sai" (báo thông tin sai ở một chợ) hoặc "them_cho" (đề xuất chợ mới ở một khu vực).
// Góp ý đi vào hàng chờ, không hiện lên web cho đến khi được duyệt.
import { t } from "../i18n/strings.js";
const { loai, choId = "", khuId = "", lang = "vi", tinhMacDinh = "" } = Astro.props;
const tieuDe = loai === "bao_sai" ? t(lang, "gopYBaoSai") : t(lang, "gopYThemCho");
const idForm = `gop-y-${loai}`;
---
<section class={loai === "them_cho" ? "gop-y-khung gop-y-widget" : "gop-y-khung"}>
  {loai === "them_cho" && <p class="gop-y-gioi-thieu">{t(lang, "gopYGioiThieu")}</p>}
  <details>
    <summary class={loai === "bao_sai" ? "nut-gop-y nut-gop-y-phu" : "nut-gop-y"}>
      {loai === "them_cho" ? (
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
      ) : (
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2.5 20h19L12 3Z" /><path d="M12 10v4.5" /><path d="M12 17.4v.2" /></svg>
      )}
      <span>{tieuDe}</span>
    </summary>
    <form id={idForm} data-lang={lang} data-loai={loai} data-cho={choId} data-khu={khuId} class="gop-y">
      {loai === "them_cho" && (
        <>
          <label>{t(lang, "gopYTenCho")} <input name="ten_cho" maxlength="200" required /></label>
          <label>{t(lang, "gopYDiaChi")} <input name="dia_chi" maxlength="500" /></label>
          {!khuId && (
            <>
              <label>{t(lang, "gopYTinh")} <input name="tinh_goi_y" maxlength="100" value={tinhMacDinh} /></label>
              <label>{t(lang, "gopYXa")} <input name="xa_goi_y" maxlength="100" /></label>
            </>
          )}
        </>
      )}
      <label>{loai === "bao_sai" ? t(lang, "gopYNoiDungSai") : t(lang, "gopYNoiDungThem")}
        <textarea name="noi_dung" minlength="10" maxlength="2000" required rows="4"></textarea>
      </label>
      <label>{t(lang, "gopYNguon")} <input name="nguon_url" type="url" maxlength="500" /></label>
      <label>{t(lang, "gopYNguoiGui")} <input name="nguoi_gui" maxlength="100" /></label>
      <label>{t(lang, "gopYEmail")} <input name="email" type="email" /></label>
      <button type="submit">{t(lang, "gopYGui")}</button>
      <p class="phu" role="status"></p>
    </form>
  </details>
</section>

<style>
  .gop-y label { display: block; margin: .5rem 0; font-size: .95rem; }
  .gop-y input, .gop-y textarea { display: block; width: 100%; box-sizing: border-box; margin-top: .25rem; padding: .4rem; font: inherit; color: inherit; background: transparent; border: 1px solid var(--vien); border-radius: .3rem; }
  .gop-y button { margin-top: .5rem; padding: .45rem 1rem; font: inherit; border-radius: .3rem; border: 1px solid var(--vien); background: var(--nen); color: var(--chu); cursor: pointer; }
  details summary { cursor: pointer; }
  /* Nút "Thêm chợ": hiện ngay dưới tiêu đề, bấm mới mở form */
  .nut-gop-y {
    display: inline-block;
    padding: .5rem 1.1rem;
    border-radius: 999px;
    background: var(--nhan);
    color: var(--nen);
    font-weight: 600;
    font-size: .95rem;
    list-style: none;
  }
  .nut-gop-y { display: inline-flex; align-items: center; gap: .4rem; }
  .nut-gop-y svg { flex: none; }
  .nut-gop-y-phu { background: transparent; color: var(--nhan); border: 1px solid var(--nhan); padding: calc(.5rem - 1px) calc(1.1rem - 1px); }
  .nut-gop-y::-webkit-details-marker { display: none; }
  .nut-gop-y:hover { text-decoration: none; opacity: .92; }
  .gop-y-khung details[open] > .nut-gop-y { margin-bottom: .75rem; }
  /* Widget "Thêm chợ": thẻ có lời mời và nút, nằm cùng dòng tiêu đề */
  .gop-y-widget { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1rem; padding: .8rem 1rem; background: var(--mat); border: 1px solid var(--vien); border-radius: 14px; box-shadow: var(--bong); }
  .gop-y-widget .gop-y-gioi-thieu { flex: 1 1 auto; margin: 0; font-size: .95rem; }
  .gop-y-widget details { margin-left: auto; }
  /* Khi mở form, form chiếm cả dòng dưới nút */
  .gop-y-widget details[open] { flex-basis: 100%; margin-left: 0; }
  .gop-y-widget .gop-y { box-shadow: none; background: var(--nen); }
  .gop-y-khung .gop-y { background: var(--mat); border: 1px solid var(--vien); border-radius: 14px; padding: .9rem 1.1rem; box-shadow: var(--bong); }
  .gop-y-khung .gop-y button { background: var(--nhan); color: var(--nen); border-color: var(--nhan); font-weight: 600; }
</style>

<script>
  import { t } from "../i18n/strings.js";
  // Địa chỉ PocketBase công khai (chỉ cho phép tạo bản ghi trong hàng chờ, không đọc được).
  const PB_CONG_KHAI = "https://api.botgap.dev";

  for (const form of document.querySelectorAll("form.gop-y")) {
    const lang = form.dataset.lang || "vi";
    const trangThai = form.querySelector('[role="status"]');
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button");
      const fd = new FormData(form);
      const loai = form.dataset.loai;
      const body = {
        loai,
        trang_thai: "cho_duyet",
        noi_dung: String(fd.get("noi_dung") || "").trim(),
        nguon_url: String(fd.get("nguon_url") || "").trim(),
        nguoi_gui: String(fd.get("nguoi_gui") || "").trim(),
        email: String(fd.get("email") || "").trim(),
      };
      if (loai === "them_cho") {
        body.ten_cho = String(fd.get("ten_cho") || "").trim();
        body.dia_chi = String(fd.get("dia_chi") || "").trim();
        if (form.dataset.khu) body.khu_vuc = form.dataset.khu;
        body.tinh_goi_y = String(fd.get("tinh_goi_y") || "").trim();
        body.xa_goi_y = String(fd.get("xa_goi_y") || "").trim();
      } else if (form.dataset.cho) {
        body.cho = form.dataset.cho;
      }
      // Bỏ các trường rỗng để PocketBase không kiểm tra định dạng trên chuỗi rỗng
      for (const k of Object.keys(body)) if (body[k] === "") delete body[k];

      btn.disabled = true;
      trangThai.textContent = t(lang, "gopYDangGui");
      try {
        const r = await fetch(`${PB_CONG_KHAI}/api/collections/cho_phien_gop_y/records`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        trangThai.textContent = t(lang, "gopYCamOn");
      } catch (err) {
        trangThai.textContent = t(lang, "gopYLoi");
        console.error(err);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

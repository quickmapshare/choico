---
// Lịch phiên của một chợ đã xác minh: mô tả quy tắc và 3 phiên tiếp theo tính theo ngày hiện tại.
// Chỉ dùng khi chợ đã xác minh (trang chợ đã lọc trước).
import { t } from "../i18n/strings.js";
const { lich, lang = "vi" } = Astro.props;
const mota = lich.map((q) => ({ loai: q.loai, ngay: q.ngay, thang_nhuan: q.thang_nhuan, ngay_goc: q.ngay_goc, chu_ky: q.chu_ky }));
---
<div class="the" data-lang={lang}>
  <p><strong>{t(lang, "phienHop")}</strong> <span id="lich-mota"></span></p>
  <p id="lich-tiep" class="phu">{t(lang, "dangTinh")}</p>
  <script id="lich-du-lieu" type="application/json" set:html={JSON.stringify(mota)}></script>
</div>

<script>
  import { cacPhienTiepTheo, dinhDangDuong, moTaQuy, ngayHienTai } from "../lib/lich-phien.js";
  import { t } from "../i18n/strings.js";

  const khung = document.getElementById("lich-du-lieu")?.closest(".the");
  const lang = khung?.dataset.lang ?? "vi";
  const nhan = document.getElementById("lich-du-lieu");
  const moTaEl = document.getElementById("lich-mota");
  const tiepEl = document.getElementById("lich-tiep");

  try {
    const lich = JSON.parse(nhan.textContent || "[]");
    moTaEl.textContent = lich.map((q) => moTaQuy(q, lang)).filter(Boolean).join("; ") || "—";
    const ds = cacPhienTiepTheo(lich, ngayHienTai(), 3);
    if (ds.length === 0) {
      tiepEl.textContent = t(lang, "chuaTimThayPhien");
    } else {
      tiepEl.innerHTML = "";
      const tieu = document.createElement("strong");
      tieu.textContent = t(lang, "phienTiepTheo");
      const ul = document.createElement("ul");
      for (const ngay of ds) {
        const li = document.createElement("li");
        li.textContent = dinhDangDuong(ngay, lang);
        ul.append(li);
      }
      tiepEl.append(tieu, ul);
    }
  } catch (err) {
    tiepEl.textContent = t(lang, "khongTaiLich");
    console.error(err);
  }
</script>

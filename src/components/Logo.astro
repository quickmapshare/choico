---
// Logo ChoiCo: quân cờ tròn đỏ đậm, chữ C và chấm tròn (ghép thành "Co") màu kem phóng to gần kín quân, dễ nhận ở cỡ nhỏ.
const { size = 32 } = Astro.props;
---
<svg class="logo" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="#b3261e" />
  <g transform="translate(32 32) scale(1.38) translate(-32 -32)" fill="none" stroke="#fbf6e6">
    <path d="M41 21.3A14 14 0 1 0 41 42.7" stroke-width="9" stroke-linecap="round" />
    <circle cx="46" cy="32" r="4.5" fill="#fbf6e6" stroke="none" />
  </g>
</svg>

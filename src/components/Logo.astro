---
// Logo ChoiCo: quân cờ tròn đỏ đậm, chữ C và chấm tròn (ghép thành "Co") màu kem, dễ nhận ở cỡ nhỏ.
const { size = 32 } = Astro.props;
---
<svg class="logo" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="#b3261e" />
  <circle cx="32" cy="32" r="26" fill="none" stroke="#fbf6e6" stroke-width="1.8" />
  <path d="M41 21.3A14 14 0 1 0 41 42.7" fill="none" stroke="#fbf6e6" stroke-width="9" stroke-linecap="round" />
  <circle cx="44" cy="32" r="5" fill="#fbf6e6" />
</svg>

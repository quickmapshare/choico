---
// Logo ChoiCo: quân cờ tròn đỏ đậm, chữ C và chữ o cùng cỡ màu kem (ghép thành "Co"), dễ nhận ở cỡ nhỏ.
const { size = 32 } = Astro.props;
---
<svg class="logo" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="#b3261e" />
  <path d="M27.43 24.34A10 10 0 1 0 27.43 39.66" fill="none" stroke="#fbf6e6" stroke-width="6" stroke-linecap="round" />
  <circle cx="43" cy="32" r="10" fill="none" stroke="#fbf6e6" stroke-width="6" />
</svg>

---
// Khung mã nhúng ngay dưới widget. loc: { khu }, { tinh } hoặc { cho } (slug) để nhúng đúng phạm vi; không có thì là cả nước.
import { t } from "../i18n/strings.js";
const { loc = {}, lang = "vi" } = Astro.props;

const src = new URL("/nhung/", Astro.site);
if (loc.khu) src.searchParams.set("khu", loc.khu);
else if (loc.tinh) src.searchParams.set("tinh", loc.tinh);
else if (loc.cho) src.searchParams.set("cho", loc.cho);

// Mã nhúng: một iframe và một đoạn script nhỏ để khung tự cao theo nội dung
const ma = [
  `<iframe src="${src.href}" title="Hôm nay có phiên không?" style="width:100%;border:0;height:300px" loading="lazy"></iframe>`,
  `<script>`,
  `addEventListener("message", (e) => {`,
  `  if (e.origin !== "${src.origin}" || !e.data?.chophienCao) return;`,
  `  for (const f of document.querySelectorAll("iframe")) if (f.contentWindow === e.source) f.style.height = e.data.chophienCao + "px";`,
  `});`,
  `</script>`,
].join("\n");
---
<section class="the ma-nhung-khung">
  <h3>{t(lang, "nhungTieuDe")}</h3>
  <p class="phu">{t(lang, "nhungMoTa")}</p>
  <div class="ma-nhung-o-boc">
    <textarea readonly rows="9" class="ma-nhung-o">{ma}</textarea>
    <div class="ma-nhung-hang">
      <a class="ma-nhung-xem" href={src.href} target="_blank" rel="noopener">{t(lang, "nhungXemTruoc")} ↗</a>
      <button type="button" class="ma-nhung-nut" data-nhan-chep={t(lang, "nhungSaoChep")} data-nhan-da-chep={t(lang, "nhungDaChep")} data-nhan-chon-tay={t(lang, "nhungChonTay")}>{t(lang, "nhungSaoChep")}</button>
    </div>
  </div>
</section>

<style>
  .ma-nhung-khung { margin-top: 1rem; }
  .ma-nhung-khung h3 { font-size: 1rem; margin: .1rem 0 .3rem; }
  .ma-nhung-khung .phu { margin: 0 0 .6rem; font-size: .88rem; }
  .ma-nhung-o-boc { position: relative; }
  .ma-nhung-o {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    margin: 0;
    font: .8rem/1.5 ui-monospace, Consolas, monospace;
    background: var(--nen);
    color: var(--chu);
    border: 1px solid var(--vien);
    border-radius: 8px;
    padding: 2.6rem .7rem .6rem;
    resize: vertical;
  }
  /* Hai nút nằm trong ô mã, góc trên bên phải */
  .ma-nhung-hang {
    position: absolute;
    top: .45rem;
    right: .45rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .ma-nhung-xem { font-size: .85rem; background: var(--mat); padding: .2rem .5rem; border-radius: 6px; border: 1px solid var(--vien); }
  .ma-nhung-nut {
    font: inherit;
    font-size: .85rem;
    padding: .2rem .6rem;
    border-radius: 8px;
    border: 1px solid var(--nhan);
    background: var(--mat);
    color: var(--nhan);
    cursor: pointer;
  }
  .ma-nhung-nut:hover { background: var(--nhan-nhe); }
</style>

<script>
  for (const nut of document.querySelectorAll(".ma-nhung-nut")) {
    nut.addEventListener("click", async () => {
      const o = nut.closest(".ma-nhung-khung")?.querySelector("textarea");
      if (!o) return;
      try {
        await navigator.clipboard.writeText(o.value);
        nut.textContent = nut.dataset.nhanDaChep;
      } catch {
        o.select();
        nut.textContent = nut.dataset.nhanChonTay;
      }
      setTimeout(() => (nut.textContent = nut.dataset.nhanChep), 2000);
    });
  }
</script>

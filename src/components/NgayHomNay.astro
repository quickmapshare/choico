---
// Hiện ngày dương và âm hôm nay, tính phía trình duyệt theo múi giờ Việt Nam.
import { t, duongDan } from "../i18n/strings.js";
const { lang = "vi" } = Astro.props;
---
<div class="ngay-hom-nay" data-lang={lang}>
  <span id="ngay-duong"></span>
  <span class="chan" aria-hidden="true">·</span>
  <span id="ngay-am"><a class="lien-am-lich" href={duongDan(lang, "/am-lich/")}>{t(lang, "amLich")}</a> <span id="ngay-am-gia-tri"></span></span>
</div>

<script>
  import { dinhDangAm, dinhDangDuong, ngayHienTai } from "../lib/lich-phien.js";
  import { t } from "../i18n/strings.js";

  const khung = document.querySelector(".ngay-hom-nay");
  const lang = khung?.dataset.lang ?? "vi";
  try {
    const hom = ngayHienTai();
    document.getElementById("ngay-duong").textContent = `${t(lang, "duongLich")} ${dinhDangDuong(hom, lang)}`;
    document.getElementById("ngay-am-gia-tri").textContent = dinhDangAm(hom, lang);
  } catch (err) {
    console.error(err);
  }
</script>

<style>
  .ngay-hom-nay {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .6rem;
    align-items: baseline;
    font-size: .95rem;
    color: var(--chu);
    border-bottom: 1px solid var(--vien);
    padding-bottom: .5rem;
    margin-bottom: .5rem;
  }
  .chan { color: var(--phu); }
  .lien-am-lich { color: var(--nhan); text-decoration: underline dotted; text-underline-offset: 3px; }
</style>

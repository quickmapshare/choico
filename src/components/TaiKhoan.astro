---
// Nút đăng nhập Google / đăng xuất trên thanh đầu, dùng chung cho mọi trang. Dạng biểu tượng tròn nhỏ như nút giao diện sáng/tối.
// Trạng thái chỉ dựa vào việc có token hay không (không gọi máy chủ để thanh đầu hiện ngay). Trang nào cần phản ứng thì nghe sự kiện:
//   choico:dang-xuat (cancelable): bấm đăng xuất; trang tự xử lý tại chỗ thì gọi preventDefault(), không thì tải lại trang.
// Trang đổi trạng thái đăng nhập (ví dụ token bị từ chối) thì phát sự kiện choico:taikhoan để thanh đầu cập nhật lại.
import { t } from "../i18n/strings.js";
const { lang = "vi" } = Astro.props;
const nhanDangNhap = t(lang, "dangNhapNut");
const nhanDangXuat = t(lang, "dangXuat");
const loi = t(lang, "loiDangNhap");
---
<div class="tai-khoan" data-loi={loi}>
  <button type="button" id="tk-dang-nhap" class="tk-nut tk-google" aria-label={nhanDangNhap} title={nhanDangNhap} hidden>
    <svg viewBox="0 0 48 48" width="16" height="16" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
  </button>
  <button type="button" id="tk-dang-xuat" class="tk-nut" aria-label={nhanDangXuat} title={nhanDangXuat} hidden>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M10 4H5v16h5M15 8l4 4-4 4M19 12H9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <span class="tk-loi" role="alert" hidden></span>
</div>

<style is:global>
  .tai-khoan { position: relative; display: inline-flex; }
  .tk-nut {
    flex: none; width: 2.1rem; height: 2.1rem; min-width: 2.1rem; padding: 0; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 1px solid var(--vien); background: var(--mat); color: var(--phu); cursor: pointer;
    transition: border-color .15s, color .15s, opacity .15s;
  }
  .tk-nut:hover:not(:disabled) { border-color: var(--nhan); color: var(--nhan); }
  .tk-nut:disabled { opacity: .55; cursor: progress; }
  .tk-nut[hidden] { display: none; }
  /* Nút Google luôn nền sáng theo quy định thương hiệu, trong giao diện tối thì nền tối viền xám */
  .tk-google { background: #fff; border-color: #dadce0; }
  .tk-google:hover:not(:disabled) { background: #f8f9fa; border-color: #d2e3fc; }
  :root[data-theme="dark"] .tk-google { background: #131314; border-color: #8e918f; }
  :root[data-theme="dark"] .tk-google:hover:not(:disabled) { background: #1f1f20; border-color: #a8abad; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tk-google { background: #131314; border-color: #8e918f; }
    :root:not([data-theme="light"]) .tk-google:hover:not(:disabled) { background: #1f1f20; border-color: #a8abad; }
  }
  /* Thông báo lỗi nhỏ dưới nút khi không chuyển sang Google được */
  .tk-loi { position: absolute; right: 0; top: calc(100% + .4rem); z-index: 20; width: max-content; max-width: 14rem; padding: .4rem .7rem; font-size: .82rem; color: var(--chu); background: var(--mat); border: 1px solid var(--do); border-radius: .5rem; box-shadow: var(--bong); }
  .tk-loi[hidden] { display: none; }
</style>

<script>
  import { docToken, xoaToken, batDauDangNhap } from "../lib/co-tuong-tai-khoan.js";

  const vung = document.querySelector(".tai-khoan") as HTMLElement | null;
  const nutVao = document.getElementById("tk-dang-nhap") as HTMLButtonElement | null;
  const nutRa = document.getElementById("tk-dang-xuat") as HTMLButtonElement | null;
  const loiEl = document.querySelector(".tk-loi") as HTMLElement | null;

  function capNhat() {
    const dang = !!docToken();
    if (nutVao) nutVao.hidden = dang;
    if (nutRa) nutRa.hidden = !dang;
  }
  capNhat();
  document.addEventListener("choico:taikhoan", capNhat);
  window.addEventListener("storage", capNhat); // đăng nhập hoặc đăng xuất ở tab khác

  nutVao?.addEventListener("click", async () => {
    nutVao.disabled = true;
    try {
      await batDauDangNhap(); // thành công thì trang chuyển sang Google, giữ nút khóa
    } catch {
      nutVao.disabled = false;
      if (loiEl && vung) {
        loiEl.textContent = vung.dataset.loi || "";
        loiEl.hidden = false;
        setTimeout(() => (loiEl.hidden = true), 4000);
      }
    }
  });

  nutRa?.addEventListener("click", () => {
    xoaToken();
    capNhat();
    // Trang tự xử lý tại chỗ (chơi với máy) thì gọi preventDefault; các trang khác tải lại để bỏ dữ liệu của tài khoản
    const daXuLy = !document.dispatchEvent(new CustomEvent("choico:dang-xuat", { cancelable: true }));
    if (!daXuLy) location.reload();
  });
</script>

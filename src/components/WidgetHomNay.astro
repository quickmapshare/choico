---
// Widget "hôm nay có phiên không": tính phía trình duyệt theo múi giờ Asia/Ho_Chi_Minh.
// Chỉ nhận chợ đã xác minh (lich đã được lọc ở lớp dữ liệu).
import { t } from "../i18n/strings.js";
// nhung: bản để nhúng, lọc theo ?tinh= hoặc ?khu= trên URL (chỉ dùng ở trang /nhung/)
const { chos, lang = "vi", nhung = false } = Astro.props;
// Tên trường khớp với coPhienHomNay (trang_thai_xac_minh, lich_phien). Chợ đã được lọc là đã xác minh.
const duLieu = chos.map((c) => ({
  ten: c.ten,
  slug: c.slug,
  // Nơi hiển thị: "Xã/phường, Tỉnh/thành"
  noi: [c.khu?.ten, c.khu?.tinh?.ten].filter(Boolean).join(", "),
  // Slug để lọc trên trang nhúng
  khu_slug: c.khu?.slug ?? "",
  tinh_slug: c.khu?.tinh?.slug ?? "",
  trang_thai_xac_minh: "da_xac_minh",
  lich_phien: c.lich ?? [],
}));
const tien = lang === "en" ? "/en" : "";
---
<section class="the widget-hom-nay" aria-live="polite" data-lang={lang} data-tien={tien} data-nhung={String(nhung)}>
  <h2>{t(lang, "widgetTieuDe")}</h2>
  <p id="widget-tong" class="phu">{t(lang, "widgetDangTinh")}</p>
  <ul id="widget-ds"></ul>
  <script id="widget-du-lieu" type="application/json" set:html={JSON.stringify(duLieu)}></script>
</section>

<style>
  /* Nền xanh nhạt, viền rõ hơn, đệm ngang rộng để khung rộng hơn nội dung. Pha màu nên tự đổi theo chế độ sáng/tối */
  .widget-hom-nay {
    background: color-mix(in srgb, var(--xanh) 6%, var(--mat));
    border: 1px solid color-mix(in srgb, var(--xanh) 55%, var(--vien));
    padding: 1.1rem 1.5rem 1.25rem;
  }
</style>

<script>
  import { coPhienHomNay, ngayHienTai } from "../lib/lich-phien.js";
  import { t } from "../i18n/strings.js";

  const khung = document.querySelector("#widget-tong")?.closest("section");
  const lang = khung?.dataset.lang ?? "vi";
  const tien = khung?.dataset.tien ?? "";
  const nhan = document.getElementById("widget-du-lieu");
  const tong = document.getElementById("widget-tong");
  const ds = document.getElementById("widget-ds");

  try {
    const chos = JSON.parse(nhan.textContent || "[]");
    const hom = ngayHienTai();
    // Trang nhúng: chỉ lấy chợ của xã/phường hoặc tỉnh/thành trên URL
    let pool = chos;
    if (khung.dataset.nhung === "true") {
      const tham = new URLSearchParams(location.search);
      if (tham.get("khu")) pool = chos.filter((c) => c.khu_slug === tham.get("khu"));
      else if (tham.get("tinh")) pool = chos.filter((c) => c.tinh_slug === tham.get("tinh"));
      else if (tham.get("cho")) pool = chos.filter((c) => c.slug === tham.get("cho"));
    }
    const coPhien = pool.filter((c) => coPhienHomNay(c, hom) === true);
    tong.textContent = coPhien.length ? t(lang, "widgetCo", coPhien.length) : t(lang, "widgetKhong");
    for (const c of coPhien) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `${tien}/cho/${c.slug}/`;
      a.textContent = c.ten;
      li.append(a);
      // Dòng dưới: xã/phường, tỉnh/thành (nếu có)
      if (c.noi) {
        const dong = document.createElement("div");
        dong.className = "phu";
        dong.textContent = c.noi;
        li.append(dong);
      }
      ds.append(li);
    }
  } catch (err) {
    tong.textContent = t(lang, "chuaTaiLichHomNay");
    console.error(err);
  }
</script>

---
// Widget "hôm nay có phiên không": tính phía trình duyệt theo múi giờ Asia/Ho_Chi_Minh.
// Chỉ nhận chợ đã xác minh (lich đã được lọc ở lớp dữ liệu).
import { t } from "../i18n/strings.js";
const { chos, lang = "vi" } = Astro.props;
// Tên trường khớp với coPhienHomNay (trang_thai_xac_minh, lich_phien). Chợ đã được lọc là đã xác minh.
const duLieu = chos.map((c) => ({
  ten: c.ten,
  slug: c.slug,
  dia_chi: c.dia_chi ?? "",
  trang_thai_xac_minh: "da_xac_minh",
  lich_phien: c.lich ?? [],
}));
const tien = lang === "en" ? "/en" : "";
---
<section class="the" aria-live="polite" data-lang={lang} data-tien={tien}>
  <h2>{t(lang, "widgetTieuDe")}</h2>
  <p id="widget-tong" class="phu">{t(lang, "widgetDangTinh")}</p>
  <ul id="widget-ds"></ul>
  <script id="widget-du-lieu" type="application/json" set:html={JSON.stringify(duLieu)}></script>
</section>

<script>
  import { coPhienHomNay, ngayHienTai } from "../lib/lich-phien.js";
  import { t } from "../i18n/strings.js";

  const khung = document.querySelector("#widget-tong")?.closest("section");
  const lang = khung?.dataset.lang ?? "vi";
  const tien = khung?.dataset.tien ?? "";
  const nhan = document.getElementById("widget-du-lieu");
  const tong = document.getElementById("widget-tong");
  const ds = document.getElementById("widget-ds");

  try {
    const chos = JSON.parse(nhan.textContent || "[]");
    const hom = ngayHienTai();
    const coPhien = chos.filter((c) => coPhienHomNay(c, hom) === true);
    tong.textContent = coPhien.length ? t(lang, "widgetCo", coPhien.length) : t(lang, "widgetKhong");
    for (const c of coPhien) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `${tien}/cho/${c.slug}/`;
      a.textContent = c.ten;
      li.append(a);
      if (c.dia_chi) {
        const span = document.createElement("span");
        span.className = "phu";
        span.textContent = ` — ${c.dia_chi}`;
        li.append(span);
      }
      ds.append(li);
    }
  } catch (err) {
    tong.textContent = t(lang, "chuaTaiLichHomNay");
    console.error(err);
  }
</script>

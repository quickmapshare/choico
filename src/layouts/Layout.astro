---
// Khung tối giản cho trang cờ tướng: chỉ có biến màu, giao diện sáng/tối theo máy và báo chiều cao cho trang cha khi nhúng iframe.
// nhung: bản nhúng vào web khác (iframe), không lập chỉ mục, mở liên kết ở tab mới.
import Logo from "../components/Logo.astro";
import ChuyenTheme from "../components/ChuyenTheme.astro";
import ChonNgonNgu from "../components/ChonNgonNgu.astro";
import TaiKhoan from "../components/TaiKhoan.astro";
import { NGON_NGU, t, thongTin, duongDan, boTienTo } from "../i18n/strings.js";
// khongDich: trang không có bản theo ngôn ngữ (ví dụ /dang-nhap/), không hiện bộ chọn ngôn ngữ và không có hreflang.
// khongLapChiMuc: trang có nội dung phụ thuộc mã trong địa chỉ (?ma=...), không nên xuất hiện trên công cụ tìm kiếm.
const { tieuDe, moTa, lang = "vi", nhung = false, khongDich = false, khongLapChiMuc = false } = Astro.props;
const duongCanhTac = new URL(Astro.url.pathname, Astro.site);
const duongGoc = boTienTo(Astro.url.pathname); // đường dẫn tiếng Việt của cùng trang
// Mọi trang của loại cờ tướng (cổng, chơi với máy, thượng đài, chơi với bạn, xem lại, nhúng) làm sáng mục menu Cờ tướng
const thuocCoTuong = /^\/(co-tuong|thuong-dai|tran|xem-van|nhung)\//.test(duongGoc);
// Tự chọn ngôn ngữ chỉ ở trang tiếng Việt thường (không phải bản nhúng, không phải trang trung tính)
const tuChonNgonNgu = lang === "vi" && !nhung && !khongDich;
// Thẻ Open Graph và Twitter: tiêu đề, mô tả và ảnh hiện ra khi dán link vào mạng xã hội. Ảnh theo ngôn ngữ của trang
// (public/og/<ngôn ngữ>.png, tạo bằng tools/tao-anh-chia-se.mjs).
const anhChiaSe = new URL(`/og/${lang}.png`, Astro.site);
const OG_LOCALE: Record<string, string> = { vi: "vi_VN", en: "en_US", "zh-tw": "zh_TW", ko: "ko_KR", ja: "ja_JP" };
---
<!doctype html>
<html lang={thongTin(lang).html} data-tien-to={thongTin(lang).tienTo} data-tu-chon={tuChonNgonNgu ? "1" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={moTa} />
    {(nhung || khongLapChiMuc) && <meta name="robots" content="noindex" />}
    {nhung && <base target="_blank" />}
    <link rel="canonical" href={duongCanhTac} />
    {!nhung && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="ChoiCo" />
        <meta property="og:title" content={tieuDe} />
        <meta property="og:description" content={moTa} />
        {/* Trang phụ thuộc mã trong địa chỉ (link mời ?ma=...) không khai og:url, để mạng xã hội giữ nguyên link có mã */}
        {!khongLapChiMuc && <meta property="og:url" content={duongCanhTac} />}
        <meta property="og:locale" content={OG_LOCALE[lang] ?? "vi_VN"} />
        <meta property="og:image" content={anhChiaSe} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={tieuDe} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {!khongDich && NGON_NGU.map((n) => <link rel="alternate" hreflang={n.html} href={new URL(duongDan(n.ma, duongGoc), Astro.site)} />)}
    {!khongDich && <link rel="alternate" hreflang="x-default" href={new URL(duongDan("en", duongGoc), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Chọn ngôn ngữ lần đầu: theo lựa chọn đã lưu, không có thì theo ngôn ngữ trình duyệt, không thuộc 5 ngôn ngữ thì tiếng Anh.
      // Chỉ chạy ở trang tiếng Việt thường. Trang có tiền tố (/en/, /ja/...) là địa chỉ chủ ý, giữ nguyên.
      try {
        const goc = document.documentElement;
        if (goc.dataset.tuChon === "1" && !/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) {
          const TIEN_TO = { en: "/en", "zh-tw": "/zh-tw", ko: "/ko", ja: "/ja" };
          const theoMay = () => {
            for (const l of navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"]) {
              const s = String(l).toLowerCase();
              if (s === "vi" || s.startsWith("vi-")) return "vi";
              if (s === "en" || s.startsWith("en-")) return "en";
              if (s === "ko" || s.startsWith("ko-")) return "ko";
              if (s === "ja" || s.startsWith("ja-")) return "ja";
              if (/^zh-(tw|hk|mo|hant)/.test(s)) return "zh-tw";
            }
            return "en";
          };
          let chon = null;
          try { chon = localStorage.getItem("choico-lang"); } catch (e) {}
          const ma = chon === "vi" || TIEN_TO[chon] ? chon : theoMay();
          if (ma !== "vi") location.replace(TIEN_TO[ma] + location.pathname + location.search + location.hash);
        }
      } catch (err) {
        // lỗi gì thì ở lại trang hiện tại
      }
    </script>
    <script is:inline>
      // Áp giao diện đã chọn (sáng hoặc tối) trước khi vẽ trang để không chớp sáng. Không có lựa chọn thì theo máy.
      try {
        const luu = localStorage.getItem("choico-theme");
        if (luu === "light" || luu === "dark") document.documentElement.setAttribute("data-theme", luu);
      } catch (err) {
        // localStorage bị chặn thì theo giao diện của máy
      }
    </script>
    <style is:global>
      :root {
        color-scheme: light dark;
        --nen: #f7f5f0;
        --mat: #ffffff;
        --chu: #1f2421;
        --phu: #5f6764;
        --vien: #e6e1d6;
        --nhan: #b5472b;
        --nhan-nhe: #f8e9e3;
        --xanh: #2f7d57;
        --do: #b03a2e;
        --bong: 0 1px 2px rgba(31, 36, 33, .06), 0 4px 16px rgba(31, 36, 33, .05);
      }
      :root[data-theme="light"] { color-scheme: light; }
      :root[data-theme="dark"] { color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --nen: #14161a;
          --mat: #1d2026;
          --chu: #ecebe6;
          --phu: #a3aaa6;
          --vien: #2d3138;
          --nhan: #e58a6b;
          --nhan-nhe: #2e2420;
          --xanh: #5fbf8a;
          --do: #e0796b;
          --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
        }
      }
      :root[data-theme="dark"] {
        --nen: #14161a;
        --mat: #1d2026;
        --chu: #ecebe6;
        --phu: #a3aaa6;
        --vien: #2d3138;
        --nhan: #e58a6b;
        --nhan-nhe: #2e2420;
        --xanh: #5fbf8a;
        --do: #e0796b;
        --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: var(--nen);
        color: var(--chu);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .thanh-tren { position: sticky; top: 0; z-index: 10; background: var(--nen); border-bottom: 1px solid var(--vien); }
      .thanh-tren-noi { max-width: 46rem; margin: 0 auto; padding: .6rem 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem 1rem; }
      .ten-web { display: inline-flex; align-items: center; gap: .55rem; font-size: 1.2rem; font-weight: 800; letter-spacing: -.02em; color: var(--chu); text-decoration: none; }
      .ten-web:hover { text-decoration: none; }
      .ten-web .logo { flex: none; }
      .ten-web span span { color: var(--nhan); }
      .thanh-tren-phai { display: flex; align-items: center; gap: .9rem; }
      .thanh-tren nav { display: flex; gap: 1rem; font-size: .93rem; font-weight: 600; }
      .nut-menu { display: none; width: 2.1rem; height: 2.1rem; padding: 0; align-items: center; justify-content: center; border: 1px solid var(--vien); border-radius: 50%; background: var(--mat); color: var(--phu); cursor: pointer; transition: border-color .15s, color .15s; }
      .nut-menu:hover, .thanh-tren[data-mo] .nut-menu { border-color: var(--nhan); color: var(--nhan); }
      /* Điện thoại: menu gọn lại sau nút ☰, bấm vào thì thả xuống dưới thanh đầu (giữ cú pháp media query cũ cho iOS cũ) */
      @media (max-width: 640px) {
        .nut-menu { display: inline-flex; }
        .thanh-tren nav { display: none; }
        .thanh-tren[data-mo] nav { display: flex; flex-direction: column; gap: 0; position: absolute; left: 0; right: 0; top: 100%; padding: .3rem 1rem .6rem; background: var(--nen); border-bottom: 1px solid var(--vien); font-size: 1rem; }
        .thanh-tren nav a { padding: .7rem 0; border-top: 1px solid var(--vien); }
        .thanh-tren nav a:first-child { border-top: 0; }
      }
      /* Màn hình rất hẹp: ẩn chữ ChoiCo, chỉ giữ logo để các nút vừa cùng một hàng với logo */
      @media (max-width: 420px) {
        .thanh-tren-noi { flex-wrap: nowrap; }
        .ten-web span { display: none; }
      }
      .thanh-tren nav a { color: var(--phu); }
      .thanh-tren nav a:hover, .thanh-tren nav a[aria-current="page"] { color: var(--nhan); }
      .chan-trang { max-width: 46rem; margin: 0 auto; padding: 1rem 1rem 2rem; border-top: 1px solid var(--vien); color: var(--phu); font-size: .85rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      main { max-width: 46rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
      a { color: var(--nhan); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; letter-spacing: -.02em; margin: .6rem 0 .8rem; }
      h2 { font-size: 1.1rem; letter-spacing: -.01em; margin: 1.8rem 0 .6rem; }
      p { margin: .5rem 0; }
      .phu { color: var(--phu); font-size: .93rem; }
      .the {
        background: var(--mat);
        border: 1px solid var(--vien);
        border-radius: 14px;
        padding: .9rem 1.1rem;
        margin: .75rem 0;
        box-shadow: var(--bong);
      }
      .canh-bao {
        background: var(--nhan-nhe);
        color: var(--chu);
        border-radius: 10px;
        padding: .6rem .9rem;
        border-left: 3px solid var(--do);
      }
      ul { padding-left: 1.2rem; }
      ul li { margin: .2rem 0; }
      body.nhung main { max-width: none; padding: .5rem; }
      :focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; border-radius: 4px; }
    </style>
  </head>
  <body class={nhung ? "nhung" : undefined}>
    {!nhung && (
      <header class="thanh-tren">
        <div class="thanh-tren-noi">
          <a class="ten-web" href={duongDan(lang, "/")} aria-label={t(lang, "logoAria")}><Logo size={30} /><span>Choi<span>Co</span></span></a>
          <div class="thanh-tren-phai">
            <nav id="menu-chinh" aria-label={t(lang, "menuAria")}>
              <a href={duongDan(lang, "/co-tuong/")} aria-current={thuocCoTuong ? "page" : undefined}>{t(lang, "menuCoTuong")}</a>
            </nav>
            <ChuyenTheme lang={lang} />
            {!khongDich && <TaiKhoan lang={lang} />}
            {!khongDich && <ChonNgonNgu lang={lang} duongGoc={duongGoc} />}
            <button type="button" class="nut-menu" aria-expanded="false" aria-controls="menu-chinh" aria-label={t(lang, "menuNut")}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!nhung && (
      <footer class="chan-trang">
        <a href={duongDan(lang, "/")}>{t(lang, "chanTrangVe")}</a>
        <span>{t(lang, "chanTrangMoTa")}</span>
      </footer>
    )}
    <script is:inline>
      // Menu trên điện thoại: bấm ☰ để mở/đóng; đóng khi chọn một mục, bấm ra ngoài hoặc nhấn Esc
      (function () {
        var thanh = document.querySelector(".thanh-tren");
        var nut = document.querySelector(".nut-menu");
        if (!thanh || !nut) return;
        function dat(mo) {
          if (mo) thanh.setAttribute("data-mo", ""); else thanh.removeAttribute("data-mo");
          nut.setAttribute("aria-expanded", mo ? "true" : "false");
        }
        nut.addEventListener("click", function () { dat(!thanh.hasAttribute("data-mo")); });
        document.addEventListener("click", function (e) { if (!thanh.contains(e.target)) dat(false); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") dat(false); });
        thanh.querySelectorAll("nav a").forEach(function (a) { a.addEventListener("click", function () { dat(false); }); });
      })();
    </script>
    <script is:inline>
      // Báo chiều cao cho trang cha để khung iframe vừa nội dung
      if (window.parent !== window) {
        const baoCao = () => window.parent.postMessage({ choicoCao: document.documentElement.scrollHeight }, "*");
        new ResizeObserver(baoCao).observe(document.body);
        baoCao();
      }
    </script>
  </body>
</html>

---
// Khung chung cho mọi trang. lang: "vi" hoặc "en".
import NgayHomNay from "../components/NgayHomNay.astro";
import CoNgonNgu from "../components/CoNgonNgu.astro";
import Logo from "../components/Logo.astro";
import { t, duongDan } from "../i18n/strings.js";
// nhung: trang con để nhúng vào web khác (iframe), không có thanh tiêu đề, không lập chỉ mục.
const { tieuDe, moTa, lang = "vi", nhung = false } = Astro.props;
// Đường dẫn cùng trang ở ngôn ngữ còn lại: /tinh/x/ <-> /en/tinh/x/
const duongHienTai = Astro.url.pathname;
const duongKhac = lang === "en" ? (duongHienTai.replace(/^\/en/, "") || "/") : ("/en" + duongHienTai);
const duongCanhTac = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={moTa} />
    {nhung && <meta name="robots" content="noindex" />}
    {nhung && <base target="_blank" />}
    <link rel="canonical" href={duongCanhTac} />
    <link rel="alternate" hreflang="vi" href={new URL(lang === "vi" ? Astro.url.pathname : duongKhac, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(lang === "en" ? Astro.url.pathname : duongKhac, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161a" media="(prefers-color-scheme: dark)" />
    <style>
      :root {
        color-scheme: light dark;
        --nen: #f7f5f0;
        --mat: #ffffff;
        --chu: #1f2421;
        --phu: #5f6764;
        --vien: #e6e1d6;
        --nhan: #b5472b;
        --nhan-nhe: #f8e9e3;
        --xanh: #2f7d57;
        --do: #b03a2e;
        --bong: 0 1px 2px rgba(31, 36, 33, .06), 0 4px 16px rgba(31, 36, 33, .05);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --nen: #14161a;
          --mat: #1d2026;
          --chu: #ecebe6;
          --phu: #a3aaa6;
          --vien: #2d3138;
          --nhan: #e58a6b;
          --nhan-nhe: #2e2420;
          --xanh: #5fbf8a;
          --do: #e0796b;
          --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
        }
      }
      :root[data-theme="dark"] {
        --nen: #14161a;
        --mat: #1d2026;
        --chu: #ecebe6;
        --phu: #a3aaa6;
        --vien: #2d3138;
        --nhan: #e58a6b;
        --nhan-nhe: #2e2420;
        --xanh: #5fbf8a;
        --do: #e0796b;
        --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: var(--nen);
        color: var(--chu);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .thanh-tren {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--nen) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(8px);
        border-bottom: 1px solid var(--vien);
      }
      .thanh-tren-noi {
        max-width: 46rem;
        margin: 0 auto;
        padding: .7rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .ten-web { font-weight: 700; text-decoration: none; letter-spacing: -.01em; display: inline-flex; align-items: center; gap: .5rem; color: var(--chu); }
      /* :global vì SVG nằm trong component Logo nên không có data-astro-cid của khung này. Thiếu flex: none thì logo bị co và đè lên chữ. */
      .ten-web :global(.logo) { color: var(--nhan); flex: none; }

      main { max-width: 46rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
      a { color: var(--nhan); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; letter-spacing: -.02em; margin: .6rem 0 .8rem; }
      h2 { font-size: 1.1rem; letter-spacing: -.01em; margin: 1.8rem 0 .6rem; }
      p { margin: .5rem 0; }
      .phu { color: var(--phu); font-size: .93rem; }
      .the {
        background: var(--mat);
        border: 1px solid var(--vien);
        border-radius: 14px;
        padding: .9rem 1.1rem;
        margin: .75rem 0;
        box-shadow: var(--bong);
      }
      .canh-bao {
        background: var(--nhan-nhe);
        color: var(--chu);
        border-radius: 10px;
        padding: .6rem .9rem;
        border-left: 3px solid var(--do);
      }
      ul { padding-left: 1.2rem; }
      ul li { margin: .2rem 0; }
      .vet { color: var(--phu); font-size: .88rem; }
      .vet a { color: var(--phu); }
      .chan-trang { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--vien); color: var(--phu); font-size: .85rem; }

      :focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; border-radius: 4px; }
    </style>
  </head>
  <body>
    {!nhung && (
      <header class="thanh-tren">
        <div class="thanh-tren-noi">
          <a class="ten-web" href={duongDan(lang, "/")}><Logo /><span>{t(lang, "tenTrang")}</span></a>
          <CoNgonNgu lang={lang} href={duongKhac} />
        </div>
      </header>
    )}
    <main>
      <NgayHomNay lang={lang} />
      <slot />
      {!nhung && (
        <footer class="chan-trang">
          {lang === "en"
            ? "Session schedules are shown only once verified. Other information cites its source."
            : "Lịch phiên chỉ hiển thị khi đã xác minh. Thông tin còn lại có ghi nguồn."}
        </footer>
      )}
    </main>
    {nhung && (
      <script is:inline>
        // Báo chiều cao cho trang cha để khung iframe vừa nội dung
        if (window.parent !== window) {
          const baoCao = () => window.parent.postMessage({ chophienCao: document.documentElement.scrollHeight }, "*");
          new ResizeObserver(baoCao).observe(document.body);
          baoCao();
        }
      </script>
    )}
  </body>
</html>

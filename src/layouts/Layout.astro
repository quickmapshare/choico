---
// Khung tối giản cho mọi trang: chỉ có biến màu, giao diện sáng/tối theo máy và báo chiều cao cho trang cha khi nhúng iframe.
// nhung: bản nhúng vào web khác (iframe), không lập chỉ mục, mở liên kết ở tab mới.
import Logo from "../components/Logo.astro";
import ChuyenTheme from "../components/ChuyenTheme.astro";
import ChonNgonNgu from "../components/ChonNgonNgu.astro";
import TaiKhoan from "../components/TaiKhoan.astro";
import { NGON_NGU, t, thongTin, duongDan, boTienTo } from "../i18n/strings.js";
import { TRO_CHOI } from "../lib/tro-choi.js";
// khongDich: trang không có bản theo ngôn ngữ (ví dụ /dang-nhap/), không hiện bộ chọn ngôn ngữ và không có hreflang.
// khongLapChiMuc: trang có nội dung phụ thuộc mã trong địa chỉ (?ma=...), không nên xuất hiện trên công cụ tìm kiếm.
// troChoi: loại cờ của trang dùng chung cho mọi loại cờ (trận, sảnh), để làm sáng đúng mục menu.
const { tieuDe, moTa, lang = "vi", nhung = false, khongDich = false, khongLapChiMuc = false, troChoi = "" } = Astro.props;
const duongCanhTac = new URL(Astro.url.pathname, Astro.site);
const duongGoc = boTienTo(Astro.url.pathname); // đường dẫn tiếng Việt của cùng trang
// Mục menu đang sáng: trang dưới /co-vua/ hoặc /caro/ (và bản nhúng, mã nhúng tương ứng) thuộc loại cờ đó; trang cờ
// tướng giữ đường dẫn cũ ở gốc (/co-tuong/, /thuong-dai/, /tran/, /xem-van/, /nhung/co-tuong/). Trang /nhung/ chung
// (liệt kê mọi loại cờ) không sáng tab nào. Trang trận và sảnh truyền troChoi; trang trận đổi lại bằng script khi biết
// loại cờ của trận (sangMenu trong src/lib/chung/trinh-duyet.js).
const menuSang = troChoi || (/^\/(co-vua|nhung\/co-vua)\//.test(duongGoc) ? "co_vua" : /^\/(caro|nhung\/caro)\//.test(duongGoc) ? "caro" : /^\/(co-tuong|thuong-dai|tran|xem-van|nhung\/co-tuong)\//.test(duongGoc) ? "co_tuong" : "");
const MENU = [
  { ma: "co_tuong", href: "/co-tuong/", khoa: "menuCoTuong" },
  { ma: "co_vua", href: "/co-vua/", khoa: "menuCoVua" },
  { ma: "caro", href: "/caro/", khoa: "menuCaro" },
];
// Menu con của loại cờ đang chọn (nằm sát dưới tab loại cờ): chơi với máy, chơi với bạn, thượng đài.
// Mục sáng theo đường dẫn; /tran/ dùng chung cho chơi với bạn và thượng đài nên mặc định là chơi với bạn,
// trang trận đổi lại bằng sangMenu khi biết loại trận.
const MUC_CON = [
  { ma: "may", khoa: "menuMay" },
  { ma: "tran", khoa: "menuKhepKin" },
  { ma: "dai", khoa: "menuThuongDai" },
];
const troChoiMenu = menuSang ? TRO_CHOI[menuSang] : null;
const mucConSang = troChoiMenu ? (MUC_CON.find((m) => troChoiMenu.duong[m.ma] === duongGoc)?.ma ?? "") : "";
// Tự chọn ngôn ngữ chỉ ở trang tiếng Việt thường (không phải bản nhúng, không phải trang trung tính)
const tuChonNgonNgu = lang === "vi" && !nhung && !khongDich;
// Thẻ Open Graph và Twitter: tiêu đề, mô tả và ảnh hiện ra khi dán link vào mạng xã hội. Ảnh theo ngôn ngữ của trang
// và loại cờ (cờ tướng và trang chủ: public/og/<ngôn ngữ>.png, cờ vua: public/og/co-vua/<ngôn ngữ>.png, caro:
// public/og/caro/<ngôn ngữ>.png; tạo bằng tools/tao-anh-chia-se.mjs).
const THU_MUC_OG: Record<string, string> = { co_vua: "co-vua/", caro: "caro/" };
const anhChiaSe = new URL(`/og/${THU_MUC_OG[menuSang] || ""}${lang}.png`, Astro.site);
const OG_LOCALE: Record<string, string> = {
  vi: "vi_VN", en: "en_US", "zh-tw": "zh_TW", ko: "ko_KR", ja: "ja_JP",
  "zh-cn": "zh_CN", es: "es_ES", ru: "ru_RU", "pt-br": "pt_BR", fr: "fr_FR", de: "de_DE", id: "id_ID",
};
---
<!doctype html>
<html lang={thongTin(lang).html} data-tien-to={thongTin(lang).tienTo} data-tu-chon={tuChonNgonNgu ? "1" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={moTa} />
    {(nhung || khongLapChiMuc) && <meta name="robots" content="noindex" />}
    {nhung && <base target="_blank" />}
    <link rel="canonical" href={duongCanhTac} />
    {!nhung && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="ChoiCo" />
        <meta property="og:title" content={tieuDe} />
        <meta property="og:description" content={moTa} />
        {/* Trang phụ thuộc mã trong địa chỉ (link mời ?ma=...) không khai og:url, để mạng xã hội giữ nguyên link có mã */}
        {!khongLapChiMuc && <meta property="og:url" content={duongCanhTac} />}
        <meta property="og:locale" content={OG_LOCALE[lang] ?? "vi_VN"} />
        <meta property="og:image" content={anhChiaSe} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={tieuDe} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {!khongDich && NGON_NGU.map((n) => <link rel="alternate" hreflang={n.html} href={new URL(duongDan(n.ma, duongGoc), Astro.site)} />)}
    {!khongDich && <link rel="alternate" hreflang="x-default" href={new URL(duongDan("en", duongGoc), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!nhung && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YXVCXJ9ZXQ"></script>
        {/* Bỏ query string khỏi địa chỉ gửi đi: link mời (?ma=...) không được lọt vào Google Analytics */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", "G-YXVCXJ9ZXQ", {
            page_location: location.origin + location.pathname,
            page_referrer: document.referrer.split(/[?#]/)[0],
          });
        </script>
      </>
    )}
    <script is:inline>
      // Chọn ngôn ngữ lần đầu: theo lựa chọn đã lưu, không có thì theo ngôn ngữ trình duyệt, không thuộc 5 ngôn ngữ thì tiếng Anh.
      // Chỉ chạy ở trang tiếng Việt thường. Trang có tiền tố (/en/, /ja/...) là địa chỉ chủ ý, giữ nguyên.
      try {
        const goc = document.documentElement;
        if (goc.dataset.tuChon === "1" && !/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) {
          const TIEN_TO = { en: "/en", "zh-tw": "/zh-tw", ko: "/ko", ja: "/ja", "zh-cn": "/zh-cn", es: "/es", ru: "/ru", "pt-br": "/pt-br", fr: "/fr", de: "/de", id: "/id" };
          const theoMay = () => {
            for (const l of navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"]) {
              const s = String(l).toLowerCase();
              if (s === "vi" || s.startsWith("vi-")) return "vi";
              // zh-TW/HK/MO là phồn thể, các zh khác là giản thể; pt là Brazil; còn lại khớp mã 2 chữ
              if (/^zh-(tw|hk|mo|hant)/.test(s)) return "zh-tw";
              if (s.startsWith("zh")) return "zh-cn";
              if (s.startsWith("pt")) return "pt-br";
              if (s.slice(0, 2) in TIEN_TO) return s.slice(0, 2);
            }
            return "en";
          };
          let chon = null;
          try { chon = localStorage.getItem("choico-lang"); } catch (e) {}
          const ma = chon === "vi" || TIEN_TO[chon] ? chon : theoMay();
          if (ma !== "vi") location.replace(TIEN_TO[ma] + location.pathname + location.search + location.hash);
        }
      } catch (err) {
        // lỗi gì thì ở lại trang hiện tại
      }
    </script>
    <script is:inline>
      // Áp giao diện đã chọn (sáng hoặc tối) trước khi vẽ trang để không chớp sáng. Không có lựa chọn thì theo máy.
      try {
        const luu = localStorage.getItem("choico-theme");
        if (luu === "light" || luu === "dark") document.documentElement.setAttribute("data-theme", luu);
      } catch (err) {
        // localStorage bị chặn thì theo giao diện của máy
      }
    </script>
    <style is:global>
      :root {
        color-scheme: light dark;
        --nen: #f7f5f0;
        --mat: #ffffff;
        --chu: #1f2421;
        --phu: #5f6764;
        --vien: #e6e1d6;
        --nhan: #b5472b;
        --nhan-nhe: #f8e9e3;
        --xanh: #2f7d57;
        --do: #b03a2e;
        --bong: 0 1px 2px rgba(31, 36, 33, .06), 0 4px 16px rgba(31, 36, 33, .05);
      }
      :root[data-theme="light"] { color-scheme: light; }
      :root[data-theme="dark"] { color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --nen: #14161a;
          --mat: #1d2026;
          --chu: #ecebe6;
          --phu: #a3aaa6;
          --vien: #2d3138;
          --nhan: #e58a6b;
          --nhan-nhe: #2e2420;
          --xanh: #5fbf8a;
          --do: #e0796b;
          --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
        }
      }
      :root[data-theme="dark"] {
        --nen: #14161a;
        --mat: #1d2026;
        --chu: #ecebe6;
        --phu: #a3aaa6;
        --vien: #2d3138;
        --nhan: #e58a6b;
        --nhan-nhe: #2e2420;
        --xanh: #5fbf8a;
        --do: #e0796b;
        --bong: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: var(--nen);
        color: var(--chu);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .thanh-tren { position: sticky; top: 0; z-index: 10; background: var(--nen); border-bottom: 1px solid var(--vien); }
      .thanh-tren-noi { max-width: 46rem; margin: 0 auto; padding: .6rem 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem 1rem; }
      .ten-web { display: inline-flex; align-items: center; gap: .55rem; font-size: 1.2rem; font-weight: 800; letter-spacing: -.02em; color: var(--chu); text-decoration: none; }
      .ten-web:hover { text-decoration: none; }
      .ten-web .logo { flex: none; }
      .ten-web span span { color: var(--nhan); }
      .thanh-tren-phai { display: flex; align-items: center; gap: .9rem; }
      .thanh-tren #menu-chinh { display: flex; gap: 1rem; font-size: .93rem; font-weight: 600; }
      .thanh-tren #menu-chinh a { color: var(--phu); }
      .thanh-tren #menu-chinh a:hover, .thanh-tren #menu-chinh a[aria-current="page"] { color: var(--nhan); }
      /* Máy tính: loại cờ là các tab nằm sát đáy thanh đầu; tab đang chọn có viền như tab trình duyệt, nền trùng màu
         hàng menu con bên dưới và che đường kẻ ngăn cách nên hai phần liền một khối */
      @media (min-width: 641px) {
        .thanh-tren-noi { padding-top: 0; padding-bottom: 0; align-items: stretch; }
        .ten-web, .thanh-tren-phai > :not(#menu-chinh) { align-self: center; }
        .ten-web { padding: .6rem 0; }
        .thanh-tren-phai { align-items: stretch; }
        .thanh-tren #menu-chinh { gap: .2rem; align-items: flex-end; }
        .thanh-tren #menu-chinh a { position: relative; padding: .45rem 1rem; border: 1px solid transparent; border-bottom: 0; border-radius: 10px 10px 0 0; }
        .thanh-tren #menu-chinh a:hover { text-decoration: none; }
        .thanh-tren #menu-chinh a[aria-current="page"] { background: var(--mat); border-color: var(--vien); margin-bottom: -1px; padding-bottom: calc(.45rem + 1px); z-index: 1; }
      }
      .nut-menu { display: none; width: 2.1rem; height: 2.1rem; padding: 0; align-items: center; justify-content: center; border: 1px solid var(--vien); border-radius: 50%; background: var(--mat); color: var(--phu); cursor: pointer; transition: border-color .15s, color .15s; }
      .nut-menu:hover, .thanh-tren[data-mo] .nut-menu { border-color: var(--nhan); color: var(--nhan); }
      /* Điện thoại: menu gọn lại sau nút ☰, bấm vào thì thả xuống dưới thanh đầu (giữ cú pháp media query cũ cho iOS cũ) */
      @media (max-width: 640px) {
        .nut-menu { display: inline-flex; }
        .thanh-tren #menu-chinh { display: none; }
        .thanh-tren[data-mo] #menu-chinh { display: flex; flex-direction: column; gap: 0; position: absolute; left: 0; right: 0; top: 100%; padding: .3rem 1rem .6rem; background: var(--nen); border-bottom: 1px solid var(--vien); font-size: 1rem; }
        .thanh-tren #menu-chinh a { padding: .7rem 0; border-top: 1px solid var(--vien); }
        .thanh-tren #menu-chinh a:first-child { border-top: 0; }
      }
      /* Màn hình rất hẹp: ẩn chữ ChoiCo, chỉ giữ logo để các nút vừa cùng một hàng với logo */
      @media (max-width: 420px) {
        .thanh-tren-noi { flex-wrap: nowrap; }
        .ten-web span { display: none; }
      }
      /* Menu con của loại cờ đang chọn: nền như mặt thẻ, mục đang mở gạch chân màu nhấn */
      .menu-con { position: relative; background: var(--mat); border-top: 1px solid var(--vien); }
      .menu-con-noi { max-width: 46rem; margin: 0 auto; padding: 0 1rem; display: flex; gap: 1.6rem; overflow-x: auto; scrollbar-width: none; font-size: .92rem; font-weight: 600; }
      .menu-con-noi a { flex: none; padding: .55rem 0 calc(.55rem - 2px); border-bottom: 2px solid transparent; color: var(--phu); white-space: nowrap; }
      .menu-con-noi a:hover { text-decoration: none; color: var(--chu); }
      .menu-con-noi a[aria-current="page"] { color: var(--nhan); border-bottom-color: var(--nhan); }
      .ten-co-con { display: none; flex: none; align-items: center; gap: .25rem; margin: .35rem 0; padding: 0 1rem 0 0; border: 0; border-right: 1px solid var(--vien); background: none; color: var(--chu); font: inherit; font-weight: 700; cursor: pointer; white-space: nowrap; }
      .thanh-tren[data-mo] .ten-co-con { color: var(--nhan); }
      @media (max-width: 640px) {
        .ten-co-con { display: inline-flex; }
      }
      @media (max-width: 420px) {
        .menu-con-noi { gap: 1rem; font-size: .86rem; }
        .ten-co-con { padding-right: .8rem; }
      }
      .chan-trang { max-width: 46rem; margin: 0 auto; padding: 1rem 1rem 2rem; border-top: 1px solid var(--vien); color: var(--phu); font-size: .85rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      main { max-width: 46rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
      a { color: var(--nhan); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; letter-spacing: -.02em; margin: .6rem 0 .8rem; }
      h2 { font-size: 1.1rem; letter-spacing: -.01em; margin: 1.8rem 0 .6rem; }
      p { margin: .5rem 0; }
      .phu { color: var(--phu); font-size: .93rem; }
      .the {
        background: var(--mat);
        border: 1px solid var(--vien);
        border-radius: 14px;
        padding: .9rem 1.1rem;
        margin: .75rem 0;
        box-shadow: var(--bong);
      }
      .canh-bao {
        background: var(--nhan-nhe);
        color: var(--chu);
        border-radius: 10px;
        padding: .6rem .9rem;
        border-left: 3px solid var(--do);
      }
      ul { padding-left: 1.2rem; }
      ul li { margin: .2rem 0; }
      body.nhung main { max-width: none; padding: .5rem; }
      :focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; border-radius: 4px; }
    </style>
  </head>
  <body class={nhung ? "nhung" : undefined}>
    {!nhung && (
      <header class="thanh-tren">
        <div class="thanh-tren-noi">
          <a class="ten-web" href={duongDan(lang, "/")} aria-label={t(lang, "logoAria")}><Logo size={30} /><span>Choi<span>Co</span></span></a>
          <div class="thanh-tren-phai">
            <nav id="menu-chinh" aria-label={t(lang, "menuAria")}>
              {MENU.map((m) => <a href={duongDan(lang, m.href)} data-tro-choi={m.ma} aria-current={menuSang === m.ma ? "page" : undefined}>{t(lang, m.khoa)}</a>)}
            </nav>
            <ChuyenTheme lang={lang} />
            {!khongDich && <TaiKhoan lang={lang} />}
            {!khongDich && <ChonNgonNgu lang={lang} duongGoc={duongGoc} />}
            <button type="button" class="nut-menu" aria-expanded="false" aria-controls="menu-chinh" aria-label={t(lang, "menuNut")}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>
        {troChoiMenu && (
          <div class="menu-con">
            <nav class="menu-con-noi" id="menu-con" aria-label={t(lang, "menuAria")}>
              {/* Điện thoại: tab loại cờ nằm sau nút ☰ nên hiện tên loại cờ ở đầu hàng, bấm vào để mở menu đổi cờ */}
              <button type="button" class="ten-co-con" data-mo-menu aria-controls="menu-chinh">
                <span>{t(lang, MENU.find((m) => m.ma === menuSang)?.khoa ?? "")}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              {MUC_CON.map((m) => <a href={duongDan(lang, troChoiMenu.duong[m.ma])} data-muc={m.ma} aria-current={mucConSang === m.ma ? "page" : undefined}>{t(lang, m.khoa)}</a>)}
            </nav>
          </div>
        )}
      </header>
    )}
    <main>
      <slot />
    </main>
    {!nhung && (
      <footer class="chan-trang">
        <a href={duongDan(lang, "/")}>{t(lang, "chanTrangVe")}</a>
        <span>{t(lang, "chanTrangMoTa")}</span>
      </footer>
    )}
    <script is:inline>
      // Menu trên điện thoại: bấm ☰ (hoặc tên loại cờ ở hàng menu con) để mở/đóng; đóng khi chọn một mục, bấm ra ngoài hoặc nhấn Esc
      (function () {
        var thanh = document.querySelector(".thanh-tren");
        var nut = document.querySelector(".nut-menu");
        if (!thanh || !nut) return;
        var cacNut = thanh.querySelectorAll(".nut-menu, [data-mo-menu]");
        function dat(mo) {
          if (mo) thanh.setAttribute("data-mo", ""); else thanh.removeAttribute("data-mo");
          cacNut.forEach(function (n) { n.setAttribute("aria-expanded", mo ? "true" : "false"); });
        }
        cacNut.forEach(function (n) { n.addEventListener("click", function () { dat(!thanh.hasAttribute("data-mo")); }); });
        document.addEventListener("click", function (e) { if (!thanh.contains(e.target)) dat(false); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") dat(false); });
        thanh.querySelectorAll("nav a").forEach(function (a) { a.addEventListener("click", function () { dat(false); }); });
      })();
    </script>
    <script is:inline>
      // Báo chiều cao cho trang cha để khung iframe vừa nội dung
      if (window.parent !== window) {
        const baoCao = () => window.parent.postMessage({ choicoCao: document.documentElement.scrollHeight }, "*");
        new ResizeObserver(baoCao).observe(document.body);
        baoCao();
      }
    </script>
  </body>
</html>

---
import Trang from "../../../views/TrangNhungBan.astro";
import { NGON_NGU_PHU } from "../../../i18n/strings.js";

export function getStaticPaths() {
  return NGON_NGU_PHU.map((n) => ({ params: { lang: n.ma }, props: { ma: n.ma } }));
}
const { ma } = Astro.props;
---
<Trang lang={ma} troChoi="co_tuong" />

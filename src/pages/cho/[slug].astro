---
import Layout from "../../layouts/Layout.astro";
import { taiDuLieu } from "../../lib/du-lieu.js";
import LichPhien from "../../components/LichPhien.astro";

export async function getStaticPaths() {
  const { cho } = await taiDuLieu();
  return cho.map((c) => ({ params: { slug: c.slug }, props: { cho: c } }));
}

const { cho } = Astro.props;
const daXacMinh = cho.trang_thai_xac_minh === "da_xac_minh";
const nguon = Array.isArray(cho.nguon) ? cho.nguon : [];
---
<Layout tieuDe={`Chợ ${cho.ten} – lịch phiên`} moTa={`${cho.ten}${cho.khu ? ", " + cho.khu.ten : ""}: địa chỉ và lịch phiên.`}>
  <p><a href={cho.khu ? `/khu-vuc/${cho.khu.slug}/` : "/"}>← {cho.khu ? cho.khu.ten : "Trang chủ"}</a></p>
  <h1>Chợ {cho.ten}</h1>
  {cho.dia_chi && <p>{cho.dia_chi}</p>}
  {cho.loai_hang && <p class="phu">Hàng nổi bật: {cho.loai_hang}</p>}
  {cho.mo_ta && <p>{cho.mo_ta}</p>}

  <h2>Lịch phiên</h2>
  {daXacMinh ? (
    <p class="phu">Đã xác minh{cho.xac_minh_ngay ? ` ngày ${cho.xac_minh_ngay.slice(0, 10)}` : ""}.</p>
    <LichPhien lich={cho.lich} />
  ) : (
    <p class="canh-bao">Lịch phiên của chợ này chưa được xác minh. Vui lòng kiểm tra lại với nguồn bên dưới.</p>
  )}

  {nguon.length > 0 && (
    <>
      <h2>Nguồn</h2>
      <ul>
        {nguon.map((n) => <li>{n.url ? <a href={n.url} rel="nofollow noopener">{n.ten ?? n.url}</a> : n.ten}</li>)}
      </ul>
    </>
  )}
</Layout>

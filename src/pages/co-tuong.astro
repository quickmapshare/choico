---
import Layout from "../layouts/Layout.astro";
---
<Layout lang="vi" tieuDe="Cờ tướng với máy" moTa="Chơi cờ tướng với máy. Bạn cầm quân đỏ, máy đi quân đen.">
  <h1>Cờ tướng với máy</h1>
  <p class="phu">Bạn cầm quân đỏ và đi trước. Mức "Khó" dùng Haiku 5.5 để chọn nước trong các nước máy đã phân tích, nhưng chỉ khi bạn thắng 2 ván liên tiếp trở lên. Thua một ván thì máy trở lại minimax thuần.</p>

  <div class="co-dieu-khien">
    <label>Mức chơi
      <select id="co-muc">
        <option value="de">Dễ</option>
        <option value="vua" selected>Vừa</option>
        <option value="kho">Khó (Haiku khi bạn thắng 2 ván liên tiếp)</option>
      </select>
    </label>
    <button type="button" id="co-moi">Ván mới</button>
  </div>

  <p id="co-trang-thai" class="co-trang-thai" role="status" aria-live="polite"></p>
  <div id="co-ban" class="co-ban" aria-label="Bàn cờ tướng"></div>
</Layout>

<!-- is:global vì ô và quân cờ được JavaScript tạo ra, CSS có phạm vi sẽ không áp dụng cho chúng -->
<style is:global>
  .co-dieu-khien { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin: 1rem 0; }
  .co-dieu-khien select, .co-dieu-khien button {
    font: inherit; padding: .4rem .6rem; border-radius: .3rem; border: 1px solid var(--vien);
    background: var(--nen); color: var(--chu);
  }
  .co-dieu-khien button { background: var(--nhan); color: var(--nen); border-color: var(--nhan); font-weight: 600; cursor: pointer; }
  .co-trang-thai { min-height: 1.5em; font-weight: 600; }
  .co-ban { width: 100%; max-width: 460px; margin: .5rem 0 1.5rem; }
  .co-svg { width: 100%; height: auto; display: block; user-select: none; }
  /* Quân đặt trên giao điểm đường kẻ, bấm vào giao điểm để chọn hoặc đi */
  .co-o { cursor: pointer; }
  .co-ban.khoa .co-o { cursor: default; }
</style>

<script>
  import { khoiTao, nuocHopLe, apDung, kyHieu, xepHangNuoc, nuocTot, banVanBan } from "../lib/co-tuong.js";

  // Tên quân theo cách gọi thường thấy ở Việt Nam: quân đỏ có Tốt, quân đen có Chốt
  const TEN = { K: "Tướng", A: "Sĩ", E: "Tượng", H: "Mã", R: "Xe", C: "Pháo", P: "Tốt" };
  const TEN_DEN = { K: "Tướng", A: "Sĩ", E: "Tượng", H: "Mã", R: "Xe", C: "Pháo", P: "Chốt" };
  // Kích thước bàn SVG: 9 đường dọc, 10 đường ngang, khoảng cách 50, lề 30
  const KC = 50;
  const LE = 30;
  const RONG = LE * 2 + 8 * KC;
  const CAO = LE * 2 + 9 * KC;
  const SVG_NS = "http://www.w3.org/2000/svg";
  const toaDoX = (c) => LE + c * KC;
  const toaDoY = (r) => LE + r * KC;
  const PB_CHO_PHEP = 2500; // ms: thời gian tối đa chờ Haiku trước khi dùng nước của máy

  const banEl = document.getElementById("co-ban") as HTMLElement;
  const trangThai = document.getElementById("co-trang-thai") as HTMLElement;
  const mucEl = document.getElementById("co-muc") as HTMLSelectElement;
  const moiEl = document.getElementById("co-moi") as HTMLButtonElement;

  let b: (string | null)[][];
  let chon: [number, number] | null = null;
  let gioDi: ReturnType<typeof nuocHopLe> = [];
  let nuocCuoi: [number, number][] | null = null;
  let dangChoMay = false;
  let ketThuc = false;
  // Số ván thắng liên tiếp của người chơi. Mức Khó chỉ gọi Haiku khi chuỗi này từ 2 trở lên.
  let thangLienTiep = 0;
  const NGUONG_HAIKU = 2;
  // Lưu ván trong localStorage của trình duyệt (chỉ người chơi này thấy, không gửi lên máy chủ)
  const KHOA_LUU = "co-tuong-van";
  const MUC_HOP_LE = ["de", "vua", "kho"];

  function luuTrangThai(luot) {
    try {
      localStorage.setItem(KHOA_LUU, JSON.stringify({
        b, luot, thangLienTiep, muc: mucEl.value, ketThuc, nuocCuoi, thongBao: trangThai.textContent,
      }));
    } catch {
      // Trình duyệt chặn localStorage: vẫn chơi bình thường, chỉ không nhớ được ván
    }
  }

  function docTrangThai() {
    try {
      const d = JSON.parse(localStorage.getItem(KHOA_LUU) || "null");
      const hopLe = d && Array.isArray(d.b) && d.b.length === 10 && d.b.every((h) => Array.isArray(h) && h.length === 9);
      return hopLe ? d : null;
    } catch {
      return null;
    }
  }

  // Tạo phần tử SVG kèm thuộc tính
  function svgEl(tag, attrs, cha) {
    const e = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (cha) cha.appendChild(e);
    return e;
  }

  // Vẽ bàn theo kiểu Việt Nam: hàng 0 ở trên (phía đen), hàng 9 ở dưới (phía đỏ), có khoảng sông ở giữa
  function ve() {
    banEl.replaceChildren();
    banEl.classList.toggle("khoa", ketThuc || dangChoMay);
    const s = svgEl("svg", { viewBox: `0 0 ${RONG} ${CAO}`, class: "co-svg", role: "img", "aria-label": "Bàn cờ tướng" }, banEl);
    const net = { stroke: "#7a4b1e", "stroke-width": 1.5, fill: "none" };

    svgEl("rect", { x: 0, y: 0, width: RONG, height: CAO, rx: 10, fill: "#f1dca8" }, s);
    // Đường ngang: cả 10 hàng chạy suốt bàn
    for (let r = 0; r < 10; r++) svgEl("line", { ...net, x1: toaDoX(0), y1: toaDoY(r), x2: toaDoX(8), y2: toaDoY(r) }, s);
    // Đường dọc: cột ngoài cùng chạy suốt, các cột giữa bị ngắt ở sông
    for (let c = 0; c < 9; c++) {
      if (c === 0 || c === 8) {
        svgEl("line", { ...net, x1: toaDoX(c), y1: toaDoY(0), x2: toaDoX(c), y2: toaDoY(9) }, s);
      } else {
        svgEl("line", { ...net, x1: toaDoX(c), y1: toaDoY(0), x2: toaDoX(c), y2: toaDoY(4) }, s);
        svgEl("line", { ...net, x1: toaDoX(c), y1: toaDoY(5), x2: toaDoX(c), y2: toaDoY(9) }, s);
      }
    }
    // Hai đường chéo trong mỗi cung tướng
    for (const r0 of [0, 7]) {
      svgEl("line", { ...net, x1: toaDoX(3), y1: toaDoY(r0), x2: toaDoX(5), y2: toaDoY(r0 + 2) }, s);
      svgEl("line", { ...net, x1: toaDoX(5), y1: toaDoY(r0), x2: toaDoX(3), y2: toaDoY(r0 + 2) }, s);
    }
    svgEl("text", {
      x: RONG / 2, y: toaDoY(4.5) + 8, "text-anchor": "middle", "font-size": 22, "font-weight": "bold",
      "letter-spacing": 8, fill: "#7a4b1e",
    }, s).textContent = "SÔNG";

    const dich = new Set(gioDi.filter((m) => chon && m.tu[0] === chon[0] && m.tu[1] === chon[1]).map((m) => m.den.join(",")));
    const coNuocCuoi = (r, c) => nuocCuoi && nuocCuoi.some(([a, z]) => a === r && z === c);
    for (let r = 0; r < 10; r++) {
      for (let c = 0; c < 9; c++) {
        const x = toaDoX(c);
        const y = toaDoY(r);
        const p = b[r][c];
        const g = svgEl("g", { class: "co-o", "data-r": r, "data-c": c }, s);
        if (coNuocCuoi(r, c)) svgEl("circle", { cx: x, cy: y, r: 22, fill: "none", stroke: "#e0a100", "stroke-width": 2, "stroke-dasharray": "4 3" }, g);
        if (chon && chon[0] === r && chon[1] === c) svgEl("circle", { cx: x, cy: y, r: 22, fill: "none", stroke: "#1e88e5", "stroke-width": 3 }, g);
        if (dich.has(`${r},${c}`)) svgEl("circle", { cx: x, cy: y, r: 7, fill: "rgba(30,136,229,.65)" }, g);
        if (p) {
          const laDo = p[0] === "r";
          const mau = laDo ? "#b3261e" : "#1f1f1f";
          svgEl("circle", { cx: x, cy: y, r: 20, fill: "#fbf6e6", stroke: mau, "stroke-width": 2 }, g);
          svgEl("text", {
            x, y: y + 4, "text-anchor": "middle", "font-size": 11, "font-weight": "bold", fill: mau,
          }, g).textContent = laDo ? TEN[p[1]] : TEN_DEN[p[1]];
        }
        // Vùng bấm trong suốt phủ lên trên để nhận nhấp chuột
        svgEl("circle", { cx: x, cy: y, r: KC / 2 - 2, fill: "transparent" }, g);
      }
    }
  }

  function hienTrangThai(text) {
    trangThai.textContent = text;
  }

  function kiemKetThuc(s) {
    if (nuocHopLe(b, s).length === 0) {
      ketThuc = true;
      hienTrangThai(s === "r" ? "Bạn thua. Máy thắng." : "Bạn thắng!");
      return true;
    }
    return false;
  }

  // Máy chọn nước. Mức Khó khi người chơi đang thắng liên tiếp: Haiku chọn một trong năm nước minimax xếp đầu,
  // nếu lỗi thì dùng nước đầu. Các trường hợp khác chỉ dùng minimax.
  async function mayDi() {
    dangChoMay = true;
    hienTrangThai("Máy đang nghĩ…");
    ve();
    const doSau = mucEl.value === "de" ? 1 : mucEl.value === "vua" ? 2 : 3;
    let chonNuoc;
    if (mucEl.value === "kho" && thangLienTiep >= NGUONG_HAIKU) {
      const xep = xepHangNuoc(b, "b", doSau).slice(0, 5);
      chonNuoc = xep[0];
      try {
        const ctrl = new AbortController();
        const hen = setTimeout(() => ctrl.abort(), PB_CHO_PHEP);
        const r = await fetch("/api/co-tuong", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ban: banVanBan(b), nuoc: xep.map((x) => x.nuoc) }),
          signal: ctrl.signal,
        });
        clearTimeout(hen);
        if (r.ok) {
          const { nuoc } = await r.json();
          chonNuoc = xep.find((x) => x.nuoc === nuoc) || chonNuoc;
        }
      } catch {
        // Lỗi mạng hoặc hết giờ: giữ nước tốt nhất của minimax
      }
    } else {
      chonNuoc = nuocTot(b, "b", doSau);
    }
    if (chonNuoc) {
      apDung(b, chonNuoc.m);
      nuocCuoi = [chonNuoc.m.tu, chonNuoc.m.den];
    }
    dangChoMay = false;
    if (kiemKetThuc("r")) {
      thangLienTiep = 0; // thua thì dừng dùng Haiku cho đến khi thắng liên tiếp lại
      luuTrangThai("r");
      return ve();
    }
    hienTrangThai(`Máy đi ${chonNuoc ? chonNuoc.nuoc : ""}. Đến lượt bạn.`);
    luuTrangThai("r");
    ve();
  }

  banEl.addEventListener("click", (e) => {
    const o = (e.target as Element).closest("g.co-o");
    if (!o || ketThuc || dangChoMay) return;
    const r = Number(o.getAttribute("data-r"));
    const c = Number(o.getAttribute("data-c"));
    const p = b[r][c];

    if (chon) {
      const m = gioDi.find((x) => x.tu[0] === chon![0] && x.tu[1] === chon![1] && x.den[0] === r && x.den[1] === c);
      if (m) {
        apDung(b, m);
        nuocCuoi = [m.tu, m.den];
        chon = null;
        gioDi = [];
        if (kiemKetThuc("b")) {
          thangLienTiep++;
          luuTrangThai("r");
          return ve();
        }
        luuTrangThai("b"); // đã đến lượt máy: nếu tải lại trang thì máy sẽ đi tiếp
        ve();
        return void mayDi();
      }
    }
    if (p && p[0] === "r") {
      chon = [r, c];
      gioDi = nuocHopLe(b, "r");
    } else {
      chon = null;
      gioDi = [];
    }
    ve();
  });

  function vanMoi() {
    b = khoiTao();
    chon = null;
    gioDi = nuocHopLe(b, "r");
    nuocCuoi = null;
    ketThuc = false;
    dangChoMay = false;
    hienTrangThai("Bạn đi trước (quân đỏ).");
    luuTrangThai("r");
    ve();
  }

  moiEl.addEventListener("click", vanMoi);
  mucEl.addEventListener("change", vanMoi);

  // Khôi phục ván đang dở (nếu có), không thì bắt đầu ván mới
  const d = docTrangThai();
  if (d) {
    b = d.b;
    thangLienTiep = Number(d.thangLienTiep) || 0;
    if (MUC_HOP_LE.includes(d.muc)) mucEl.value = d.muc;
    ketThuc = !!d.ketThuc;
    nuocCuoi = Array.isArray(d.nuocCuoi) ? d.nuocCuoi : null;
    chon = null;
    gioDi = [];
    hienTrangThai(d.thongBao || "");
    ve();
    if (d.luot === "b" && !ketThuc) void mayDi();
  } else {
    vanMoi();
  }
</script>

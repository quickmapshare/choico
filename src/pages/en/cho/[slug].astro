---
import TrangCho from "../../../views/TrangCho.astro";
import { taiDuLieu } from "../../../lib/du-lieu.js";
import { linkGoogleMaps } from "../../../lib/ban-do.js";

export async function getStaticPaths() {
  const { cho } = await taiDuLieu();
  return cho.map((c) => ({ params: { slug: c.slug }, props: { cho: c } }));
}

const { cho } = Astro.props;
const linkMap = linkGoogleMaps(cho);
---
<TrangCho lang="en" cho={cho} linkMap={linkMap} />

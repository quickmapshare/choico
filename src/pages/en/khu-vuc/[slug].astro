---
import TrangKhu from "../../../views/TrangKhu.astro";
import { taiDuLieu } from "../../../lib/du-lieu.js";

export async function getStaticPaths() {
  const { khuVuc } = await taiDuLieu();
  return khuVuc.filter((k) => k.cap === "xa_phuong").map((k) => ({ params: { slug: k.slug }, props: { khu: k } }));
}

const { khu } = Astro.props;
const { cho } = await taiDuLieu();
const dsCho = cho.filter((c) => c.khu_vuc === khu.id);
---
<TrangKhu lang="en" khu={khu} dsCho={dsCho} />

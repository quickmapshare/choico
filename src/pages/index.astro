---
import Layout from "../layouts/Layout.astro";

// Các trang chính, hiện thành thẻ để bấm vào
const trang = [
  { href: "/co-tuong/", ten: "Chơi cờ tướng với máy", mo: "Bạn cầm quân đỏ, máy đi quân đen. Có 5 mức chơi, từ dễ đến khó." },
  { href: "/co-tuong/#co-bang-diem-tieu-de", ten: "Bảng xếp hạng", mo: "Đăng nhập bằng Google để ghi điểm và có tên trên bảng." },
  { href: "/nhung/", ten: "Nhúng bàn cờ vào web của bạn", mo: "Lấy đoạn mã ngắn để dán vào trang web bất kỳ." },
  { href: "/nhung/co-tuong/", ten: "Xem bản nhúng gọn", mo: "Bàn cờ và các nút cần thiết, đúng như hiện trên web được nhúng." },
];
---
<Layout lang="vi" tieuDe="ChoiCo: cờ tướng với máy" moTa="Chơi cờ tướng với máy miễn phí, có bảng xếp hạng. Có thể nhúng bàn cờ vào trang web của bạn.">
  <h1>ChoiCo</h1>
  <p>Chơi cờ tướng với máy ngay trên trình duyệt, không cần cài đặt. Chơi thoải mái không cần tài khoản; đăng nhập Google nếu bạn muốn ghi điểm lên bảng xếp hạng.</p>

  <ul class="danh-sach">
    {trang.map((t) => (
      <li>
        <a class="the-lien-ket" href={t.href}>
          <strong>{t.ten}</strong>
          <span class="phu">{t.mo}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .danh-sach { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: .75rem; }
  .danh-sach li { margin: 0; }
  .the-lien-ket {
    display: block; padding: .9rem 1.1rem; background: var(--mat); border: 1px solid var(--vien);
    border-radius: 14px; box-shadow: var(--bong); color: var(--chu); text-decoration: none;
  }
  .the-lien-ket:hover { border-color: var(--nhan); text-decoration: none; }
  .the-lien-ket strong { display: block; color: var(--nhan); }
</style>

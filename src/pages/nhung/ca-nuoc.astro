---
// Widget cả nước để nhúng: chỉ chợ đã xác minh.
import Layout from "../../layouts/Layout.astro";
import WidgetHomNay from "../../components/WidgetHomNay.astro";
import { taiDuLieu } from "../../lib/du-lieu.js";

const { cho } = await taiDuLieu();
const chos = cho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh");
---
<Layout lang="vi" tieuDe="Chợ phiên hôm nay - cả nước" moTa="Chợ nào có phiên hôm nay trên cả nước." nhung={true}>
  <WidgetHomNay chos={chos} lang="vi" />
</Layout>

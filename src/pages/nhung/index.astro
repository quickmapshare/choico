---
// Trang nhúng widget "hôm nay có phiên không": một trang cho mọi phạm vi.
// ?tinh=<slug>, ?khu=<slug> hoặc ?cho=<slug> để lọc; không có thì hiện cả nước. Chỉ chợ đã xác minh.
import Layout from "../../layouts/Layout.astro";
import WidgetHomNay from "../../components/WidgetHomNay.astro";
import { taiDuLieu } from "../../lib/du-lieu.js";

const { cho } = await taiDuLieu();
const chos = cho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh");
---
<Layout lang="vi" tieuDe="Hôm nay có phiên không?" moTa="Widget chợ phiên hôm nay để nhúng vào trang web khác." nhung={true}>
  <WidgetHomNay chos={chos} lang="vi" nhung={true} />
</Layout>

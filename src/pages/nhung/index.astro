---
// Trang lấy mã nhúng bàn cờ tướng vào web bất kỳ.
import Layout from "../../layouts/Layout.astro";

const src = new URL("/nhung/co-tuong/", Astro.site);
// Mã nhúng: một iframe và một đoạn script nhỏ để khung tự cao theo nội dung
const ma = [
  `<iframe src="${src.href}" title="Cờ tướng với máy" allow="fullscreen" style="width:100%;max-width:480px;border:0;height:640px" loading="lazy"></iframe>`,
  `<script>`,
  `addEventListener("message", (e) => {`,
  `  if (e.origin !== "${src.origin}" || !e.data?.choicoCao) return;`,
  `  for (const f of document.querySelectorAll("iframe")) if (f.contentWindow === e.source) f.style.height = e.data.choicoCao + "px";`,
  `});`,
  `</script>`,
].join("\n");
---
<Layout lang="vi" tieuDe="Mã nhúng cờ tướng" moTa="Lấy mã nhúng bàn cờ tướng chơi với máy để dán vào trang web của bạn.">
  <h1>Nhúng cờ tướng vào web của bạn</h1>
  <p class="phu">Dán đoạn mã dưới đây vào nơi bạn muốn hiện bàn cờ (trang HTML, hoặc khối "HTML tùy chỉnh" của WordPress, Blogger, Wix...). Khung tự cao theo nội dung. Người chơi muốn lưu tên và xem bảng xếp hạng sẽ bấm link ở cuối bàn để sang ChoiCo.</p>

  <div class="the">
    <textarea id="ma-nhung" readonly rows="9">{ma}</textarea>
    <div class="hang-nut">
      <button type="button" id="chep" data-nhan="Sao chép mã" data-da="Đã sao chép" data-tay="Hãy chọn và sao chép tay">Sao chép mã</button>
      <a href={src.href} target="_blank" rel="noopener">Xem bản nhúng ↗</a>
    </div>
  </div>

  <h2>Xem trước</h2>
  <iframe id="xem-truoc" src={src.href} title="Cờ tướng với máy" allow="fullscreen" style="width:100%;max-width:480px;border:0;height:640px"></iframe>
</Layout>

<style>
  textarea {
    display: block; width: 100%; min-width: 0; margin: 0; font: .8rem/1.5 ui-monospace, Consolas, monospace;
    background: var(--nen); color: var(--chu); border: 1px solid var(--vien); border-radius: 8px; padding: .6rem .7rem; resize: vertical;
  }
  .hang-nut { display: flex; align-items: center; gap: 1rem; margin-top: .6rem; }
  button {
    font: inherit; font-weight: 600; padding: .4rem .8rem; border-radius: .3rem; border: 1px solid var(--nhan);
    background: var(--nhan); color: var(--nen); cursor: pointer;
  }
</style>

<script>
  const o = document.getElementById("ma-nhung") as HTMLTextAreaElement;
  const nut = document.getElementById("chep") as HTMLButtonElement;
  nut.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(o.value);
      nut.textContent = nut.dataset.da!;
    } catch {
      o.select();
      nut.textContent = nut.dataset.tay!;
    }
    setTimeout(() => (nut.textContent = nut.dataset.nhan!), 2000);
  });

  // Xem trước cũng tự cao theo nội dung
  addEventListener("message", (e) => {
    if (e.origin !== location.origin || !e.data?.choicoCao) return;
    const khung = document.getElementById("xem-truoc") as HTMLIFrameElement;
    if (khung.contentWindow === e.source) khung.style.height = e.data.choicoCao + "px";
  });
</script>

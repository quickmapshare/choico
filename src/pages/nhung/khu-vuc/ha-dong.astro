---
// Widget Hà Đông để nhúng: chỉ chợ đã xác minh thuộc xã/phường Hà Đông.
import Layout from "../../../layouts/Layout.astro";
import WidgetHomNay from "../../../components/WidgetHomNay.astro";
import { taiDuLieu } from "../../../lib/du-lieu.js";

const { khuVuc, cho } = await taiDuLieu();
const khu = khuVuc.find((k) => k.cap === "xa_phuong" && k.slug === "ha-dong");
const chos = cho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh" && khu && c.khu_vuc === khu.id);
---
<Layout lang="vi" tieuDe="Chợ phiên hôm nay - Hà Đông" moTa="Chợ nào có phiên hôm nay ở Hà Đông." nhung={true}>
  <WidgetHomNay chos={chos} lang="vi" />
</Layout>

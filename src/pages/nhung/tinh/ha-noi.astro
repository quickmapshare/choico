---
// Widget Hà Nội để nhúng: chỉ chợ đã xác minh thuộc Hà Nội.
import Layout from "../../../layouts/Layout.astro";
import WidgetHomNay from "../../../components/WidgetHomNay.astro";
import { taiDuLieu } from "../../../lib/du-lieu.js";

const { khuVuc, cho } = await taiDuLieu();
const tinh = khuVuc.find((k) => k.cap === "tinh_thanh" && k.slug === "ha-noi");
const chos = cho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh" && tinh && c.khu?.tinh?.id === tinh.id);
---
<Layout lang="vi" tieuDe="Chợ phiên hôm nay - Hà Nội" moTa="Chợ nào có phiên hôm nay ở Hà Nội." nhung={true}>
  <WidgetHomNay chos={chos} lang="vi" />
</Layout>

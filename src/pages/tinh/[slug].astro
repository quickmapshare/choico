---
import TrangTinh from "../../views/TrangTinh.astro";
import { taiDuLieu } from "../../lib/du-lieu.js";

export async function getStaticPaths() {
  const { khuVuc } = await taiDuLieu();
  return khuVuc.filter((k) => k.cap === "tinh_thanh").map((k) => ({ params: { slug: k.slug }, props: { tinh: k } }));
}

const { tinh } = Astro.props;
const { khuVuc } = await taiDuLieu();
const phuong = khuVuc.filter((k) => k.cap === "xa_phuong" && k.cha === tinh.id);
---
<TrangTinh lang="vi" tinh={tinh} phuong={phuong} />

---
// Trang lịch âm: xem từng tháng dương, mỗi ngày kèm ngày âm, lễ âm và tiết khí. Mọi thứ tính bằng JS phía trình duyệt
// theo múi giờ Việt Nam (như widget hôm nay), nên trang không cần dữ liệu từ PocketBase.
import Layout from "../layouts/Layout.astro";
import { t, duongDan } from "../i18n/strings.js";
const { lang, cho = [] } = Astro.props;
---
<Layout lang={lang} tieuDe={t(lang, "tieuDeAmLich")} moTa={t(lang, "moTaAmLich")}>
  <p><a href={duongDan(lang, "/")}>← {t(lang, "trangChu")}</a></p>
  <h1>{t(lang, "tieuDeAmLich")}</h1>
  <p class="phu">{t(lang, "moTaAmLich")}</p>

  <noscript><p class="canh-bao">{t(lang, "amLichCanJs")}</p></noscript>
  <section class="am-lich" id="am-lich" data-lang={lang} hidden>
    <div class="am-lich-dau">
      <button type="button" id="am-lich-truoc" aria-label={t(lang, "thangTruoc")}>‹</button>
      <div class="am-lich-tieu-de">
        <h2 id="am-lich-thang-duong"></h2>
        <p class="phu" id="am-lich-thang-am"></p>
      </div>
      <button type="button" id="am-lich-sau" aria-label={t(lang, "thangSau")}>›</button>
    </div>
    <div class="am-lich-luoi" id="am-lich-luoi"></div>
    <p class="am-lich-cuoi">
      <button type="button" id="am-lich-hom-nay" class="nut-chu">{t(lang, "homNayNut")}</button>
    </p>
    <div class="am-lich-ds" id="am-lich-cho-ds"></div>
    <div class="am-lich-ds" id="am-lich-le"></div>
    <div class="am-lich-ds" id="am-lich-tiet-khi"></div>
    <p class="vet">{t(lang, "amLichGhiChu")}</p>
    <p class="vet">{t(lang, "leGhiChu")}</p>
    <p class="vet">{t(lang, "choChuThich")}</p>
    <script type="application/json" id="am-lich-cho" set:html={JSON.stringify(cho).replace(/</g, "\\u003c")}></script>

    <h2 class="am-lich-doi-tieu-de">{t(lang, "doiNgayTieuDe")}</h2>
    <div class="the am-lich-the">
      <h3>{t(lang, "doiDuongSangAm")}</h3>
      <div class="am-lich-hang">
        <label>{t(lang, "doiNgayDuong")} <input type="date" id="doi-duong" /></label>
        <button type="button" class="nut-chu" id="doi-duong-xem">{t(lang, "doiXem")}</button>
      </div>
      <p class="am-lich-kq" id="doi-duong-kq" aria-live="polite"></p>
    </div>
    <div class="the am-lich-the">
      <h3>{t(lang, "doiAmSangDuong")}</h3>
      <div class="am-lich-hang">
        <label>{t(lang, "doiNgayAmNgay")} <input type="number" id="doi-am-ngay" min="1" max="30" inputmode="numeric" /></label>
        <label>{t(lang, "doiNgayAmThang")} <input type="number" id="doi-am-thang" min="1" max="12" inputmode="numeric" /></label>
        <label>{t(lang, "doiNgayAmNam")} <input type="number" id="doi-am-nam" inputmode="numeric" /></label>
      </div>
      <div class="am-lich-hang">
        <label class="am-lich-nhuan"><input type="checkbox" id="doi-am-nhuan" /> {t(lang, "doiNhuan")}</label>
        <button type="button" class="nut-chu" id="doi-am-xem">{t(lang, "doiXem")}</button>
      </div>
      <p class="am-lich-kq" id="doi-am-kq" aria-live="polite"></p>
    </div>
  </section>
</Layout>

<script>
  import { coPhienHomNay, dinhDangAm, dinhDangDuong, leAmCua, luoiThang, ngayAm, ngayDuongTuAm, ngayHienTai, nhanThangAm, tenThangCanChi, tietKhiTrongNam } from "../lib/lich-phien.js";
  import { t } from "../i18n/strings.js";

  const khung = document.getElementById("am-lich");
  const lang = khung.dataset.lang ?? "vi";
  const hom = ngayHienTai();
  let nam = hom.y;
  let thang = hom.m;

  // Mở đúng tháng nếu đường dẫn có dạng #2026-10
  const khopHash = location.hash.match(/^#(\d{4})-(\d{1,2})$/);
  if (khopHash && Number(khopHash[2]) >= 1 && Number(khopHash[2]) <= 12) {
    nam = Number(khopHash[1]);
    thang = Number(khopHash[2]);
  }

  const pad = (so) => String(so).padStart(2, "0");
  const danhSachCho = JSON.parse(document.getElementById("am-lich-cho").textContent);
  const choCoPhien = (ngayDuong) => danhSachCho.filter((c) => coPhienHomNay(c, ngayDuong));
  const hienThi = (id) => document.getElementById(id);
  const tietKhiCache = new Map();
  const tietKhiCuaNam = (y) => {
    if (!tietKhiCache.has(y)) tietKhiCache.set(y, tietKhiTrongNam(y));
    return tietKhiCache.get(y);
  };

  function capNhatDuongDan() {
    history.replaceState(null, "", `#${nam}-${pad(thang)}`);
  }

  function ve() {
    const { thuDau, ngay } = luoiThang(nam, thang);
    const o = t(lang, "thuNgan").map((th) => `<div class="am-lich-thu">${th}</div>`);
    for (let i = 0; i < thuDau; i++) o.push(`<div class="am-lich-o trong"></div>`);
    const lePhatSinh = [];
    const choPhatSinh = [];
    for (const { duong, am } of ngay) {
      const classes = ["am-lich-o"];
      if (duong.y === hom.y && duong.m === hom.m && duong.d === hom.d) classes.push("hom-nay");
      if (am.ngay === 1) classes.push("dau-thang");
      const coCho = choCoPhien(duong);
      if (coCho.length) {
        classes.push("co-cho");
        choPhatSinh.push(`<li>${duong.d}/${duong.m}: ${coCho.map((c) => `<a href="${c.href}">${c.ten}</a>`).join(", ")}</li>`);
      }
      const le = leAmCua(am);
      if (le.length) {
        classes.push("co-le");
        lePhatSinh.push(`<li>${duong.d}/${duong.m}: ${le.map((khoa) => t(lang, "le")[khoa]).join(", ")}</li>`);
      }
      const nhanAm = am.ngay === 1 ? `1/${am.thang}${am.nhuan ? "N" : ""}` : String(am.ngay);
      o.push(
        `<div class="${classes.join(" ")}" title="${dinhDangAm(duong, lang)}">` +
        `<span class="am-lich-duong">${duong.d}</span>` +
        `<span class="am-lich-am">${nhanAm}</span></div>`,
      );
    }
    hienThi("am-lich-luoi").innerHTML = o.join("");

    // Tháng âm có trong lưới, kèm can chi (tháng nhuận không có can chi riêng)
    const thangAmCoMat = [];
    for (const { am } of ngay) {
      if (!thangAmCoMat.some((x) => x.thang === am.thang && x.nhuan === am.nhuan)) thangAmCoMat.push(am);
    }
    const nhanThang = (am) => (am.nhuan ? nhanThangAm(am, lang) : `${nhanThangAm(am, lang)} (${tenThangCanChi(am.nam, am.thang)})`);
    const khoangAm = thangAmCoMat.length === 1
      ? nhanThang(thangAmCoMat[0])
      : t(lang, "thangAmKhoang", nhanThang(thangAmCoMat[0]), nhanThang(thangAmCoMat[thangAmCoMat.length - 1]));
    hienThi("am-lich-thang-duong").textContent = t(lang, "thangDuongNhan", thang, nam);
    hienThi("am-lich-thang-am").textContent = khoangAm;

    const choBlock = hienThi("am-lich-cho-ds");
    if (!danhSachCho.length) {
      choBlock.innerHTML = `<p class="phu">${t(lang, "choKhongCoDuLieu")}</p>`;
    } else if (!choPhatSinh.length) {
      choBlock.innerHTML = `<p class="phu">${t(lang, "choKhongCoTrongThang")}</p>`;
    } else {
      choBlock.innerHTML = `<p class="phu">${t(lang, "choCoPhienTrongThang")}</p><ul>${choPhatSinh.join("")}</ul>`;
    }

    const leBlock = hienThi("am-lich-le");
    leBlock.innerHTML = lePhatSinh.length
      ? `<p class="phu">${t(lang, "leTrongThang")}</p><ul>${lePhatSinh.join("")}</ul>`
      : "";

    const tietKhiTrongThang = tietKhiCuaNam(nam).filter((tk) => tk.ngay.m === thang);
    hienThi("am-lich-tiet-khi").innerHTML =
      `<p class="phu">${t(lang, "tietKhiTrongThang")}</p><ul>` +
      tietKhiTrongThang.map((tk) => `<li>${tk.ngay.d}/${tk.ngay.m}: ${t(lang, "tietKhi")[tk.so]}</li>`).join("") +
      "</ul>";

    capNhatDuongDan();
  }

  function chuyenThang(buoc) {
    thang += buoc;
    if (thang === 0) { thang = 12; nam -= 1; }
    if (thang === 13) { thang = 1; nam += 1; }
    ve();
  }

  function doiDuongSangAm() {
    const gia = hienThi("doi-duong").value;
    if (!gia) return;
    const [y, m, d] = gia.split("-").map(Number);
    hienThi("doi-duong-kq").textContent = t(lang, "doiKetQuaAm", dinhDangAm({ y, m, d }, lang));
  }

  function doiAmSangDuong() {
    const ngay = Number(hienThi("doi-am-ngay").value);
    const thangAm = Number(hienThi("doi-am-thang").value);
    const namAm = Number(hienThi("doi-am-nam").value);
    const nhuan = hienThi("doi-am-nhuan").checked;
    const kq = hienThi("doi-am-kq");
    if (!ngay || !thangAm || !namAm) {
      kq.textContent = t(lang, "doiNhapDay");
      return;
    }
    const duong = ngayDuongTuAm({ ngay, thang: thangAm, nam: namAm, nhuan });
    kq.textContent = duong ? t(lang, "doiKetQuaDuong", dinhDangDuong(duong, lang)) : t(lang, "doiKhongCo");
  }

  try {
    ve();
    khung.hidden = false;

    // Điền sẵn ô đổi ngày theo hôm nay
    const amHom = ngayAm(hom);
    hienThi("doi-duong").value = `${hom.y}-${pad(hom.m)}-${pad(hom.d)}`;
    hienThi("doi-am-ngay").value = amHom.ngay;
    hienThi("doi-am-thang").value = amHom.thang;
    hienThi("doi-am-nam").value = amHom.nam;
    hienThi("doi-am-nhuan").checked = amHom.nhuan;

    hienThi("am-lich-truoc").addEventListener("click", () => chuyenThang(-1));
    hienThi("am-lich-sau").addEventListener("click", () => chuyenThang(1));
    hienThi("am-lich-hom-nay").addEventListener("click", () => {
      nam = hom.y;
      thang = hom.m;
      ve();
    });
    hienThi("doi-duong-xem").addEventListener("click", doiDuongSangAm);
    hienThi("doi-am-xem").addEventListener("click", doiAmSangDuong);
  } catch (err) {
    console.error(err);
  }
</script>

<style is:global>
  .am-lich { margin-top: 1rem; }
  .am-lich[hidden] { display: none; }
  .am-lich-dau { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
  .am-lich-tieu-de { text-align: center; }
  .am-lich-tieu-de h2 { margin: 0; font-size: 1.15rem; }
  .am-lich-tieu-de p { margin: 0; font-size: .9rem; }
  .am-lich button {
    font: inherit;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--vien);
    background: var(--mat);
    color: var(--chu);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--bong);
  }
  .am-lich .nut-chu { width: auto; height: auto; padding: .4rem 1rem; font-size: .92rem; }
  .am-lich-luoi { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .am-lich-thu { text-align: center; font-size: .8rem; color: var(--phu); padding: .2rem 0; }
  .am-lich-o {
    background: var(--mat);
    border: 1px solid var(--vien);
    border-radius: 10px;
    min-height: 3.4rem;
    padding: .3rem .35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .am-lich-o.trong { background: transparent; border-color: transparent; }
  .am-lich-duong { font-weight: 600; font-size: 1rem; line-height: 1.2; }
  .am-lich-o.co-le .am-lich-duong::after { content: " •"; color: var(--nhan); }
  .am-lich-o.co-cho .am-lich-duong::before { content: "• "; color: var(--xanh); }
  .am-lich-am { font-size: .75rem; color: var(--phu); line-height: 1.2; }
  .am-lich-o.dau-thang .am-lich-am { color: var(--nhan); font-weight: 700; }
  .am-lich-o.hom-nay { border: 2px solid var(--nhan); }
  .am-lich-cuoi { text-align: center; margin: .9rem 0 0; }
  .am-lich-ds { margin-top: 1rem; }
  .am-lich-ds p { margin: 0 0 .2rem; font-weight: 600; font-size: .95rem; }
  .am-lich-ds ul { margin: 0; font-size: .92rem; }
  .am-lich .vet { margin-top: 1rem; }
  .am-lich-doi-tieu-de { margin-top: 2.2rem; }
  .am-lich-the h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .am-lich-hang { display: flex; flex-wrap: wrap; align-items: end; gap: .5rem .9rem; margin-bottom: .5rem; }
  .am-lich-hang label { display: flex; flex-direction: column; gap: .2rem; font-size: .9rem; color: var(--phu); }
  .am-lich-nhuan { flex-direction: row !important; align-items: center; gap: .4rem !important; }
  .am-lich input:not([type="checkbox"]) {
    font: inherit;
    color: var(--chu);
    background: var(--mat);
    border: 1px solid var(--vien);
    border-radius: 8px;
    padding: .4rem .5rem;
    width: 6rem;
    max-width: 100%;
  }
  .am-lich input[type="date"] { width: 11rem; }
  .am-lich-kq { min-height: 1.6em; font-weight: 600; margin: .2rem 0 0; }
</style>

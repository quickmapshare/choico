---
import Layout from "../layouts/Layout.astro";
import WidgetHomNay from "../components/WidgetHomNay.astro";
import MaNhung from "../components/MaNhung.astro";
import GopY from "../components/GopY.astro";
import { t, duongDan } from "../i18n/strings.js";
const { lang, khuVuc, cho } = Astro.props;
const choDaXacMinh = cho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh");
const tinhs = khuVuc.filter((k) => k.cap === "tinh_thanh");
---
<Layout lang={lang} tieuDe={t(lang, "tieuDeChu")} moTa={t(lang, "moTaChu")}>
  <h1>{t(lang, "tenTrang")}</h1>
  <p class="phu">{t(lang, "ghiChuChu")}</p>
  <GopY loai="them_cho" lang={lang} />

  <WidgetHomNay chos={choDaXacMinh} lang={lang} />
  <MaNhung lang={lang} />

  <h2>{t(lang, "tinhThanh")}</h2>
  {tinhs.length === 0 && <p class="phu">{t(lang, "chuaCoTinh")}</p>}
  <ul class="luoi-tinh">
    {tinhs.map((k) => <li><a href={duongDan(lang, `/tinh/${k.slug}/`)}>{k.ten}</a></li>)}
  </ul>

<style>
  .luoi-tinh {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .4rem 1rem;
  }
  .luoi-tinh li { border-bottom: 1px dotted var(--vien); padding: .25rem 0; }
</style>

</Layout>

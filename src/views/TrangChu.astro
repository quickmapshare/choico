---
// Trang chủ, dùng chung cho mọi ngôn ngữ: mỗi loại cờ một thẻ lớn. Thêm loại cờ mới thì thêm một phần tử vào danh sách.
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { t, duongDan } from "../i18n/strings.js";
import { TRO_CHOI } from "../lib/tro-choi.js";

const { lang = "vi" } = Astro.props;
// Biểu tượng svg riêng từng loại cờ (viewBox 24x24, nét currentColor): cờ tướng là quân cờ tròn dẹt (hai vòng tròn
// đồng tâm), cờ vua là quân tốt (hình chạm khắc, phổ biến để tượng trưng cho cờ vua), caro là lưới nhỏ với 3 quân
// chéo (tượng trưng cho dãy 5 quân liên tiếp).
const svg = (noiDung: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${noiDung}</svg>`;
const BT_CO_TUONG = svg('<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="5.3" fill="none" stroke="currentColor" stroke-width="1.4"/>');
const BT_CO_VUA = svg('<circle cx="12" cy="7.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9.3 11c-.3 1.6.8 3 2.2 3.4l-2 4.6h5l-2-4.6c1.4-.4 2.5-1.8 2.2-3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 20.3h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>');
const BT_CARO = svg('<path d="M4 9h16M4 15h16M9 4v16M15 4v16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="9" cy="9" r="1.9" fill="currentColor"/><circle cx="12" cy="12" r="1.9" fill="currentColor"/><circle cx="15" cy="15" r="1.9" fill="currentColor"/>');
const loaiCo = [
  { href: duongDan(lang, TRO_CHOI.co_tuong.duong.cong), ten: t(lang, "homeCo1"), mo: t(lang, "homeCo1Mo"), icon: BT_CO_TUONG },
  { href: duongDan(lang, TRO_CHOI.co_vua.duong.cong), ten: t(lang, "homeCo2"), mo: t(lang, "homeCo2Mo"), icon: BT_CO_VUA },
  { href: duongDan(lang, TRO_CHOI.caro.duong.cong), ten: t(lang, "homeCo3"), mo: t(lang, "homeCo3Mo"), icon: BT_CARO },
];
---
<Layout lang={lang} tieuDe={t(lang, "homeTieuDe")} moTa={t(lang, "homeMoTa")}>
  <div class="dau-trang">
    <Logo size={72} />
    <div>
      <h1>Choi<span class="nhan">Co</span></h1>
      <p class="phu khau-hieu">{t(lang, "homeKhauHieu")}</p>
    </div>
  </div>
  <p>{t(lang, "homeGioiThieu")}</p>

  <ul class="danh-sach">
    {loaiCo.map((x) => (
      <li>
        <a class="the-lien-ket" href={x.href}>
          <span class="bt-icon" aria-hidden="true" set:html={x.icon} />
          <span class="noi-dung">
            <strong>{x.ten}</strong>
            <span class="phu">{x.mo}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .dau-trang { display: flex; align-items: center; gap: 1.1rem; margin: .5rem 0 1rem; }
  .dau-trang h1 { margin: 0; font-size: clamp(2rem, 7vw, 2.8rem); letter-spacing: -.03em; }
  .nhan { color: var(--nhan); }
  .khau-hieu { margin: .1rem 0 0; font-size: 1rem; }
  .danh-sach { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: .9rem; }
  .danh-sach li { margin: 0; }
  .the-lien-ket {
    display: flex; align-items: center; gap: 1.1rem; padding: 1.4rem 1.4rem; background: var(--mat); border: 1px solid var(--vien);
    border-radius: 18px; box-shadow: var(--bong); color: var(--chu); text-decoration: none;
  }
  .the-lien-ket:hover { border-color: var(--nhan); text-decoration: none; }
  .the-lien-ket strong { display: block; color: var(--nhan); font-size: 1.5rem; letter-spacing: -.02em; margin-bottom: .2rem; }
  .noi-dung { flex: 1; min-width: 0; }
  .bt-icon {
    flex: none; width: 3.2rem; height: 3.2rem; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; background: var(--nhan-nhe); color: var(--nhan);
  }
  .bt-icon :global(svg) { width: 1.8rem; height: 1.8rem; display: block; }
</style>

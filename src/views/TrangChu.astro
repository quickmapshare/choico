---
// Trang chủ, dùng chung cho mọi ngôn ngữ.
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { t, duongDan } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
const trang = [
  { href: duongDan(lang, "/co-tuong/"), ten: t(lang, "homeThe1"), mo: t(lang, "homeThe1Mo") },
  { href: duongDan(lang, "/co-tuong/") + "#co-bang-diem-tieu-de", ten: t(lang, "homeThe2"), mo: t(lang, "homeThe2Mo") },
  { href: duongDan(lang, "/nhung/"), ten: t(lang, "homeThe3"), mo: t(lang, "homeThe3Mo") },
];
---
<Layout lang={lang} tieuDe={t(lang, "homeTieuDe")} moTa={t(lang, "homeMoTa")}>
  <div class="dau-trang">
    <Logo size={72} />
    <div>
      <h1>Choi<span class="nhan">Co</span></h1>
      <p class="phu khau-hieu">{t(lang, "homeKhauHieu")}</p>
    </div>
  </div>
  <p>{t(lang, "homeGioiThieu")}</p>

  <ul class="danh-sach">
    {trang.map((x) => (
      <li>
        <a class="the-lien-ket" href={x.href}>
          <strong>{x.ten}</strong>
          <span class="phu">{x.mo}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .dau-trang { display: flex; align-items: center; gap: 1.1rem; margin: .5rem 0 1rem; }
  .dau-trang h1 { margin: 0; font-size: clamp(2rem, 7vw, 2.8rem); letter-spacing: -.03em; }
  .nhan { color: var(--nhan); }
  .khau-hieu { margin: .1rem 0 0; font-size: 1rem; }
  .danh-sach { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: .75rem; }
  .danh-sach li { margin: 0; }
  .the-lien-ket {
    display: block; padding: .9rem 1.1rem; background: var(--mat); border: 1px solid var(--vien);
    border-radius: 14px; box-shadow: var(--bong); color: var(--chu); text-decoration: none;
  }
  .the-lien-ket:hover { border-color: var(--nhan); text-decoration: none; }
  .the-lien-ket strong { display: block; color: var(--nhan); }
</style>

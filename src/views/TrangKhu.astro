---
import Layout from "../layouts/Layout.astro";
import GopY from "../components/GopY.astro";
import WidgetHomNay from "../components/WidgetHomNay.astro";
import MaNhung from "../components/MaNhung.astro";
import { t, duongDan } from "../i18n/strings.js";
const { lang, khu, dsCho } = Astro.props;
const choDaXacMinh = dsCho.filter((c) => c.trang_thai_xac_minh === "da_xac_minh");
---
<Layout lang={lang} tieuDe={t(lang, "tieuDeKhu", khu.ten)} moTa={t(lang, "moTaKhu", khu.ten, khu.tinh?.ten)}>
  <p>
    <a href={duongDan(lang, "/")}>{t(lang, "trangChu")}</a>{" › "}
    {khu.tinh && <><a href={duongDan(lang, `/tinh/${khu.tinh.slug}/`)}>{khu.tinh.ten}</a></>}
  </p>
  <div class="tieu-de-hang">
    <h1>{t(lang, "tieuDeKhu", khu.ten)}</h1>
    <GopY loai="them_cho" khuId={khu.id} lang={lang} />
  </div>
  {khu.ghi_chu && <p class="phu">{khu.ghi_chu}</p>}
  <WidgetHomNay chos={choDaXacMinh} lang={lang} tieuDe={t(lang, "widgetTieuDeKhu", khu.ten, khu.tinh?.ten)} />
  <MaNhung loc={{ khu: khu.slug }} lang={lang} />
  {dsCho.length === 0 && <p class="phu">{t(lang, "chuaCoCho")}</p>}
  {dsCho.map((c) => (
    <div class="the">
      <a href={duongDan(lang, `/cho/${c.slug}/`)}><strong>{t(lang, "tenChoHeading", c.ten)}</strong></a>
      {c.dia_chi && <div class="phu">{c.dia_chi}</div>}
      <div class="phu">{c.trang_thai_xac_minh === "da_xac_minh" ? t(lang, "lichDaXacMinh") : t(lang, "lichChuaXacMinh")}</div>
    </div>
  ))}
</Layout>

---
// Trang lấy mã nhúng bàn cờ tướng vào web bất kỳ, dùng chung cho mọi ngôn ngữ.
// Mã nhúng trỏ tới bản nhúng cùng ngôn ngữ với trang này.
import Layout from "../layouts/Layout.astro";
import { t, duongDan } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
const src = new URL(duongDan(lang, "/nhung/co-tuong/"), Astro.site);
// Mã nhúng: một iframe và một đoạn script nhỏ để khung tự cao theo nội dung
const ma = [
  `<iframe src="${src.href}" title="${t(lang, "nhungKhungTieuDe")}" allow="fullscreen" style="width:100%;max-width:480px;border:0;height:640px" loading="lazy"></iframe>`,
  `<script>`,
  `addEventListener("message", (e) => {`,
  `  if (e.origin !== "${src.origin}" || !e.data?.choicoCao) return;`,
  `  for (const f of document.querySelectorAll("iframe")) if (f.contentWindow === e.source) f.style.height = e.data.choicoCao + "px";`,
  `});`,
  `</script>`,
].join("\n");
const nhanChep = t(lang, "nhungSaoChep");
---
<Layout lang={lang} tieuDe={t(lang, "nhungTieuDe")} moTa={t(lang, "nhungMoTa")}>
  <h1>{t(lang, "nhungH1")}</h1>
  <p class="phu">{t(lang, "nhungGioiThieu")}</p>

  <div class="khung-ma">
    <pre id="ma-nhung"><code>{ma}</code></pre>
    <button type="button" id="chep" class="nut-chep" aria-label={nhanChep} title={nhanChep} data-nhan={nhanChep} data-da={t(lang, "nhungDaChep")} data-tay={t(lang, "nhungChonTay")}>
      <svg class="bt-chep" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="bt-xong" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <p class="hang-lien-ket"><a href={src.href} target="_blank" rel="noopener">{t(lang, "nhungXem")} ↗</a></p>

  <h2>{t(lang, "nhungXemTruoc")}</h2>
  <iframe id="xem-truoc" src={src.href} title={t(lang, "nhungKhungTieuDe")} allow="fullscreen" style="width:100%;max-width:480px;border:0;height:640px"></iframe>
</Layout>

<style>
  /* Khung mã: hiện đủ mã, xuống dòng khi dài, không có thanh cuộn; nút sao chép nằm trong khung ở góc trên bên phải */
  .khung-ma {
    position: relative; background: var(--mat); border: 1px solid var(--vien); border-radius: 14px; box-shadow: var(--bong);
  }
  pre {
    margin: 0; padding: 1rem 3.4rem 1rem 1.1rem; font: .8rem/1.6 ui-monospace, Consolas, monospace; color: var(--chu);
    white-space: pre-wrap; overflow-wrap: anywhere; overflow: visible;
  }
  .nut-chep {
    position: absolute; top: .6rem; right: .6rem; width: 2.2rem; height: 2.2rem; padding: 0;
    display: inline-flex; align-items: center; justify-content: center; border-radius: 50%;
    border: 1px solid var(--vien); background: var(--nen); color: var(--phu); cursor: pointer;
    transition: border-color .15s, color .15s, background-color .15s, transform .1s;
  }
  .nut-chep:hover { border-color: var(--nhan); color: var(--nhan); }
  .nut-chep:active { transform: scale(.94); }
  .nut-chep .bt-xong { display: none; }
  .nut-chep.da-chep { border-color: var(--xanh); color: var(--xanh); background: var(--nhan-nhe); }
  .nut-chep.da-chep .bt-chep { display: none; }
  .nut-chep.da-chep .bt-xong { display: block; }
  .hang-lien-ket { margin: .7rem 0 0; }
</style>

<script>
  const ma = document.getElementById("ma-nhung") as HTMLElement;
  const nut = document.getElementById("chep") as HTMLButtonElement;
  function datNhan(chu: string) {
    nut.title = chu;
    nut.setAttribute("aria-label", chu);
  }
  nut.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(ma.textContent || "");
      nut.classList.add("da-chep");
      datNhan(nut.dataset.da!);
    } catch {
      // Không ghi được vào bộ nhớ tạm: chọn sẵn mã để người dùng tự sao chép
      const vung = document.createRange();
      vung.selectNodeContents(ma);
      const chon = getSelection();
      chon?.removeAllRanges();
      chon?.addRange(vung);
      datNhan(nut.dataset.tay!);
    }
    setTimeout(() => {
      nut.classList.remove("da-chep");
      datNhan(nut.dataset.nhan!);
    }, 2000);
  });

  // Xem trước cũng tự cao theo nội dung
  addEventListener("message", (e) => {
    if (e.origin !== location.origin || !e.data?.choicoCao) return;
    const khung = document.getElementById("xem-truoc") as HTMLIFrameElement;
    if (khung.contentWindow === e.source) khung.style.height = e.data.choicoCao + "px";
  });
</script>

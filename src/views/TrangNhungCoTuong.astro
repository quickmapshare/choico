---
// Bản nhúng gọn của bàn cờ (bàn cờ và các nút), dùng chung cho mọi ngôn ngữ.
import Layout from "../layouts/Layout.astro";
import CoTuong from "../components/CoTuong.astro";
import { t } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
---
<Layout lang={lang} tieuDe={t(lang, "nhungBanTieuDe")} moTa={t(lang, "nhungBanMoTa")} nhung>
  <CoTuong lang={lang} nhung />
</Layout>

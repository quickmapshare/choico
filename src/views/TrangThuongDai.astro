---
// Sảnh thượng đài: lên đài (cùng mức hoặc mở rộng) và thách đấu người đang trên đài. Cần đăng nhập. Ván tính điểm như đấu máy.
import Layout from "../layouts/Layout.astro";
import { t, chuCaTrang } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
const T = chuCaTrang(lang);
---
<Layout lang={lang} tieuDe={t(lang, "tdTieuDe")} moTa={t(lang, "tdMoTa")}>
  <script is:inline type="application/json" id="td-chu" set:html={JSON.stringify(T)}></script>
  <h1>{T.tdTieuDe}</h1>
  <p class="phu">{T.tdMoTa}</p>

  <p id="td-dang-nhap" class="phu" hidden>
    <a href="#" id="td-nut-dang-nhap">{T.tdCanDangNhap}</a>
  </p>

  <section id="td-chinh" hidden>
    <p id="td-muc" class="td-muc"></p>

    <div id="td-co-tran" class="td-khoi" hidden>
      <p>{T.tdBanDangCoTran}</p>
      <div class="td-hang">
        <a id="td-vao-tran" class="td-nut td-nut-chinh" href="#">{T.tdVaoTran}</a>
        <button type="button" id="td-roi-dai" class="td-nut td-nut-phu" hidden>{T.tdRoiDai}</button>
      </div>
    </div>

    <div id="td-len-dai" class="td-khoi">
      <div class="td-lua-chon">
        <button type="button" id="td-cung-muc" class="td-nut td-nut-chinh">{T.tdCungMuc}</button>
        <p class="phu">{T.tdMoTaCungMuc}</p>
      </div>
      <div class="td-lua-chon">
        <button type="button" id="td-mo-rong" class="td-nut">{T.tdMoRong}</button>
        <p class="phu">{T.tdMoTaMoRong}</p>
      </div>
    </div>

    <section class="td-bang" aria-labelledby="td-bang-tieu">
      <h2 id="td-bang-tieu" class="td-bang-tieu">{T.tdDanhSach}</h2>
      <p id="td-trong" class="phu" hidden>{T.tdTrong}</p>
      <ul id="td-ds" class="td-ds"></ul>
    </section>
  </section>
  <p id="td-thong-bao" class="td-thong-bao" role="status" aria-live="polite"></p>

<style>
  .td-muc { font-weight: 600; margin: 1rem 0 .5rem; }
  .td-khoi { margin: 1rem 0; display: flex; flex-direction: column; gap: .8rem; align-items: flex-start; }
  .td-khoi[hidden], #td-chinh[hidden], #td-trong[hidden], #td-dang-nhap[hidden] { display: none; }
  .td-lua-chon { display: flex; flex-direction: column; gap: .3rem; align-items: flex-start; }
  .td-lua-chon p { margin: 0; }
  .td-hang { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .td-nut {
    font: inherit; font-weight: 600; min-height: 2.4rem; padding: .4rem 1.1rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--nhan); background: transparent; color: var(--nhan); text-decoration: none; display: inline-flex; align-items: center;
  }
  .td-nut { transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s, transform .1s, opacity .15s; touch-action: manipulation; }
  .td-nut:hover:not(:disabled) { background: var(--nhan-nhe); box-shadow: 0 2px 8px rgba(0, 0, 0, .18); }
  .td-nut:active:not(:disabled) { transform: scale(.96); }
  .td-nut:focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; }
  .td-nut[aria-busy="true"] { opacity: .6; cursor: progress; }
  .td-nut-chinh { background: var(--nhan); color: #fff; }
  .td-nut-chinh:hover:not(:disabled) { background: var(--nhan); filter: brightness(1.1); }
  .td-nut-phu { color: var(--phu); border-color: var(--vien); }
  .td-nut-phu:hover:not(:disabled) { border-color: var(--nhan); color: var(--nhan); }
  .td-nut:disabled { opacity: .45; cursor: default; }
  /* Khung danh sách đài: nổi lên, vạch nhấn trên cùng và chấm đỏ "trực tiếp" trước tiêu đề */
  .td-bang { margin: 1.5rem 0 1rem; padding: 1rem 1.1rem 1.1rem; border: 1px solid var(--vien); border-top: 3px solid var(--nhan); border-radius: .8rem; background: var(--mat); box-shadow: var(--bong); }
  .td-bang-tieu { margin: 0 0 .8rem; font-size: 1.1rem; display: flex; align-items: center; gap: .6rem; }
  .td-bang-tieu::before { content: ""; flex: none; width: .55rem; height: .55rem; border-radius: 50%; background: var(--nhan); box-shadow: 0 0 0 4px var(--nhan-nhe); }
  .td-bang .phu { margin: 0; }
  .td-ds { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
  .td-ds li { display: flex; align-items: center; gap: .8rem; padding: .6rem .8rem; border: 1px solid var(--vien); border-radius: .6rem; background: var(--nen); transition: border-color .15s, box-shadow .15s; }
  .td-ds li:hover { border-color: var(--nhan); box-shadow: 0 2px 8px rgba(0, 0, 0, .12); }
  /* Ảnh đại diện là chữ cái đầu của tên, nằm tròn bên trái */
  .td-avatar { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--nhan-nhe); color: var(--nhan); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
  .td-thong-tin { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: .25rem; }
  .td-ten { font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Mức và kiểu đài hiện thành viên nhỏ, viền mảnh */
  .td-nhan { font-size: .78rem; color: var(--phu); padding: .05rem .6rem; border: 1px solid var(--vien); border-radius: 999px; white-space: nowrap; }
  /* Nút thách đấu căn phải, rộng đủ và cách xa phần tên */
  .td-thach { flex: none; margin-left: auto; min-width: 7.5rem; max-width: 100%; justify-content: center; text-align: center; line-height: 1.25; }
  .td-thong-bao { min-height: 1.5em; font-weight: 600; border-radius: .4rem; }
  /* Thông báo mới nháy nền một lần để người chơi nhận ra kết quả của nút vừa bấm */
  @media (prefers-reduced-motion: no-preference) {
    .td-thong-bao.moi { animation: td-nhay 1.2s ease-out; }
  }
  @keyframes td-nhay { from { background: var(--nhan-nhe); box-shadow: 0 0 0 6px var(--nhan-nhe); } to { background: transparent; box-shadow: 0 0 0 6px transparent; } }
</style>

<script>
  import { docToken, headerXacThuc, batDauDangNhap } from "../lib/co-tuong-tai-khoan.js";
  import { ngheTinHieu } from "../lib/co-tuong-realtime.js";

  const T = JSON.parse(document.getElementById("td-chu")?.textContent || "{}");
  const f = (mau: string, v: Record<string, string | number> = {}) => mau.replace(/\{(\w+)\}/g, (_, k) => (k in v ? String(v[k]) : `{${k}}`));
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const tienTo = document.documentElement.dataset.tienTo || "";
  const linkTran = (ma: string) => `${tienTo}/tran/?ma=${ma}`;
  const yeuCau = (): Record<string, string> => ({ "content-type": "application/json", ...headerXacThuc() });

  let pollId: number | undefined;
  let dangLam = false; // đang gửi một yêu cầu, tạm dừng đọc lại để không đè trạng thái

  async function goi(url: string, init?: RequestInit) {
    const r = await fetch(url, init);
    const data = await r.json().catch(() => ({}));
    return { ok: r.ok, status: r.status, data };
  }

  function baoLoi(loi: string | undefined) {
    const mau: Record<string, string> = {
      khac_muc: T.tdKhacMuc, da_co_nguoi_vao: T.tdDaCoNguoi, dang_co_tran: T.tdBanDangCoTran,
    };
    const el = $("td-thong-bao");
    el.textContent = (loi && mau[loi]) || T.tdLoi;
    el.classList.remove("moi");
    void el.offsetWidth; // khởi động lại hiệu ứng nháy
    el.classList.add("moi");
  }

  // Chạy một việc khi bấm nút: nút mờ đi, đổi chữ và khóa trong lúc chờ. viec trả về true nếu trang sắp chuyển đi (giữ nguyên trạng thái chờ).
  async function chay(nut: HTMLButtonElement, nhanDang: string, viec: () => Promise<boolean | void>) {
    if (nut.getAttribute("aria-busy") === "true") return;
    const nhanCu = nut.textContent;
    nut.setAttribute("aria-busy", "true");
    nut.disabled = true;
    nut.textContent = nhanDang;
    dangLam = true; // tạm dừng đọc lại danh sách để không vẽ đè lên nút đang chờ
    let giu = false;
    try {
      giu = Boolean(await viec());
    } finally {
      dangLam = false;
      if (!giu) {
        nut.removeAttribute("aria-busy");
        nut.disabled = false;
        nut.textContent = nhanCu;
      }
    }
  }

  function veDanhSach(ds: any[]) {
    const ul = $("td-ds");
    ul.replaceChildren();
    $("td-trong").hidden = ds.length > 0;
    for (const it of ds) {
      const li = document.createElement("li");
      const avatar = document.createElement("span");
      avatar.className = "td-avatar";
      avatar.setAttribute("aria-hidden", "true");
      avatar.textContent = (it.ten || "?").trim().charAt(0).toUpperCase();
      const thongTin = document.createElement("span");
      thongTin.className = "td-thong-tin";
      const ten = document.createElement("span");
      ten.className = "td-ten";
      ten.textContent = it.ten || "";
      const nhan = document.createElement("span");
      nhan.className = "td-nhan";
      nhan.textContent = f(T.tdMucNhan, { m: it.cap_do }) + (it.che_do === "moi" ? ` · ${T.tdMoRongNhan}` : "");
      thongTin.append(ten, nhan);
      const nut = document.createElement("button");
      nut.type = "button";
      nut.className = "td-nut td-nut-chinh td-thach";
      nut.textContent = T.tdThachDau;
      nut.addEventListener("click", () => void chay(nut, T.trDangXuLy, () => thachDau(it.ma)));
      li.append(avatar, thongTin, nut);
      ul.appendChild(li);
    }
  }

  async function tai() {
    if (!docToken()) {
      $("td-dang-nhap").hidden = false;
      $("td-chinh").hidden = true;
      return;
    }
    const { ok, status, data } = await goi("/api/co-tuong-dai", { headers: yeuCau() });
    if (status === 401) {
      $("td-dang-nhap").hidden = false;
      $("td-chinh").hidden = true;
      return;
    }
    if (!ok) return baoLoi(data.loi);
    $("td-dang-nhap").hidden = true;
    $("td-chinh").hidden = false;
    $("td-muc").textContent = f(T.tdMucCuaBan, { m: data.muc });
    const coTran = !!data.cua_toi;
    $("td-co-tran").hidden = !coTran;
    $("td-len-dai").hidden = coTran;
    if (coTran) {
      ($("td-vao-tran") as HTMLAnchorElement).href = linkTran(data.cua_toi.ma);
      $("td-roi-dai").hidden = data.cua_toi.trang_thai !== "cho"; // chỉ rời đài được khi chưa có đối thủ
      $("td-roi-dai").dataset.ma = data.cua_toi.ma;
    }
    veDanhSach(coTran ? [] : data.danh_sach || []);
  }

  // Các hàm trả về true khi trang sắp chuyển sang trận (giữ nút ở trạng thái chờ cho đến khi đổi trang)
  async function lenDai(cheDo: string): Promise<boolean> {
    const { ok, data } = await goi("/api/co-tuong-dai", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "len_dai", che_do: cheDo }),
    });
    if (ok || (data.loi === "dang_co_tran" && data.ma)) {
      location.href = linkTran(data.ma);
      return true;
    }
    baoLoi(data.loi);
    return false;
  }

  async function thachDau(ma: string): Promise<boolean> {
    const { ok, data } = await goi("/api/co-tuong-dai", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "vao_dai", ma }),
    });
    if (ok) {
      location.href = linkTran(data.ma);
      return true;
    }
    baoLoi(data.loi);
    void tai(); // danh sách đã đổi (người đó vừa có đối thủ khác hoặc rời đài)
    return false;
  }

  const nutCung = $("td-cung-muc") as HTMLButtonElement;
  const nutMoRong = $("td-mo-rong") as HTMLButtonElement;
  const nutRoi = $("td-roi-dai") as HTMLButtonElement;
  nutCung.addEventListener("click", () => void chay(nutCung, T.trDangXuLy, () => lenDai("cung")));
  nutMoRong.addEventListener("click", () => void chay(nutMoRong, T.trDangXuLy, () => lenDai("moi")));
  nutRoi.addEventListener("click", () => void chay(nutRoi, T.trDangXuLy, async () => {
    const ma = nutRoi.dataset.ma || "";
    await goi("/api/co-tuong-dai", { method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "roi_dai", ma }) });
    await tai();
  }));
  $("td-nut-dang-nhap").addEventListener("click", (e) => {
    e.preventDefault();
    void batDauDangNhap();
  });

  // Chuông chung của sảnh: có người lên đài, rời đài hoặc vào trận thì chuông rung và danh sách tải lại ngay.
  // Đang nghe được chuông thì chỉ đọc dự phòng thưa; không nghe được thì đọc lại đều như trước.
  let dangNghe = false;
  if (docToken()) {
    ngheTinHieu(
      "sanhthuongdai01",
      () => {
        if (!dangLam) void tai();
      },
      (ok: boolean) => {
        const doi = ok !== dangNghe;
        dangNghe = ok;
        if (doi) vong();
      },
    );
  }

  function vong() {
    clearTimeout(pollId);
    pollId = window.setTimeout(async () => {
      if (!dangLam) await tai();
      vong();
    }, dangNghe ? 30000 : document.hidden ? 8000 : 3000);
  }
  void tai();
  vong();
</script>
</Layout>

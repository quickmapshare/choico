---
import Layout from "../layouts/Layout.astro";
import { t, duongDan } from "../i18n/strings.js";
import GopY from "../components/GopY.astro";
import WidgetHomNay from "../components/WidgetHomNay.astro";
import MaNhung from "../components/MaNhung.astro";
const { lang, tinh, phuong, choTrongTinh = [] } = Astro.props;
const choDaXacMinh = choTrongTinh.filter((c) => c.trang_thai_xac_minh === "da_xac_minh");
---
<Layout lang={lang} tieuDe={t(lang, "tieuDeTinh", tinh.ten)} moTa={t(lang, "moTaTinh", tinh.ten)}>
  <p><a href={duongDan(lang, "/")}>← {t(lang, "trangChu")}</a></p>
  <h1>{t(lang, "tieuDeTinh", tinh.ten)}</h1>
  {tinh.ghi_chu && <p class="phu">{tinh.ghi_chu}</p>}
  <WidgetHomNay chos={choDaXacMinh} lang={lang} />
  <MaNhung loc={{ tinh: tinh.slug }} lang={lang} />
  {phuong.length === 0 && <p class="phu">{t(lang, "chuaCoPhuong")}</p>}
  <ul>
    {phuong.map((k) => <li><a href={duongDan(lang, `/khu-vuc/${k.slug}/`)}>{k.ten}</a></li>)}
  </ul>
  <GopY loai="them_cho" lang={lang} tinhMacDinh={tinh.ten} />
</Layout>

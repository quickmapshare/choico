---
// Trang trận khép kín: tạo link mời hoặc vào chơi qua link, đều không cần đăng nhập. Không tính điểm.
import Layout from "../layouts/Layout.astro";
import { t, chuCaTrang } from "../i18n/strings.js";
import "../styles/co-tuong-ban.css";

const { lang = "vi" } = Astro.props;
const T = chuCaTrang(lang);
---
<Layout lang={lang} tieuDe={t(lang, "trTieuDe")} moTa={t(lang, "trMoTaChung")} khongLapChiMuc>
  <script is:inline type="application/json" id="tran-chu" set:html={JSON.stringify(T)}></script>
  <h1 id="tr-h1">{T.trTieuDe}</h1>
  <p id="tr-mo-ta" class="phu">{T.trMoTa}</p>

  <section id="tr-tao" class="tr-khoi" hidden>
    <!-- Khách (chưa đăng nhập) tự nhập tên; người đã đăng nhập dùng tên tài khoản nên ô này ẩn -->
    <label id="tr-ten-tao-hang" class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-tao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <button type="button" id="tr-nut-tao" class="tr-nut tr-nut-chinh">{T.trTaoLink}</button>
  </section>

  <section id="tr-link" class="tr-khoi" hidden>
    <p class="phu">{T.trLinkCuaBan}</p>
    <div class="tr-hang">
      <input id="tr-link-o" type="text" readonly />
      <button type="button" id="tr-nut-chep" class="tr-nut">{T.trChepLink}</button>
    </div>
    <button type="button" id="tr-nut-vo-hieu" class="tr-nut tr-nut-phu">{T.trVoHieu}</button>
  </section>

  <section id="tr-roi-dai" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-roi-dai" class="tr-nut tr-nut-phu">{T.tdRoiDai}</button>
  </section>

  <section id="tr-vao" class="tr-khoi" hidden>
    <p id="tr-moi-vao"></p>
    <label class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-vao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <button type="button" id="tr-nut-vao" class="tr-nut tr-nut-chinh">{T.trVao}</button>
  </section>

  <p id="tr-trang-thai" class="tr-trang-thai" role="status" aria-live="polite"></p>
  <!-- Ba nút khi đối thủ hết giờ, ngay dưới dòng thông báo để dễ thấy. Chỉ hiện khi đến lượt đối thủ mà họ đã hết giờ -->
  <div id="tr-het-gio" class="tr-het-gio" hidden>
    <button type="button" id="tr-nut-them" class="tr-nut tr-nut-chinh">{T.trThem1Phut}</button>
    <button type="button" id="tr-nut-thoai" class="tr-nut">{T.trThoaiMai}</button>
    <button type="button" id="tr-nut-xu" class="tr-nut tr-nut-phu">{T.trXuThua}</button>
  </div>
  <p id="tr-doi" class="phu"></p>
  <!-- Hàng nút loa và phóng to nằm ngoài khung bàn, căn phải, giống chơi với máy -->
  <div id="tr-thanh-nut" class="tr-thanh-nut" hidden>
    <button type="button" id="tr-tieng" class="tr-nut-icon" aria-label={T.amThanh} aria-pressed="false" title={T.batAm}>
      <svg id="tr-loa-bat" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" hidden><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg id="tr-loa-tat" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <button type="button" id="tr-phong-to" class="tr-nut-icon" aria-label={T.phongTo} title={T.phongTo}>
      <svg id="tr-phong-mo" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg id="tr-phong-dong" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" hidden><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <!-- Khay quân bị ăn đặt trên và dưới bàn, giống chơi với máy. Bên nào có quân ở phía trên bàn thì khay đó nằm trên -->
  <div id="tr-khung" class="tr-khung" hidden>
    <div class="co-an-nua" id="tr-khay-tren">
      <div id="tr-an-tren"></div>
    </div>
    <div id="co-ban" class="co-ban"></div>
    <div class="co-an-nua" id="tr-khay-duoi">
      <div id="tr-an-duoi"></div>
    </div>
  </div>
  <button type="button" id="tr-thu-nho" class="tr-nut-icon tr-thu-nho" aria-label={T.thuNhoBan} title={T.thuNhoBan} hidden>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <p id="tr-tiep" class="tr-khoi" hidden><a id="tr-tiep-a" href="#"></a></p>
  <div id="tr-dieu-khien" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-dau-hang" class="tr-nut tr-nut-phu">{T.trDauHang}</button>
  </div>

<style is:global>
  /* Global vì quân trong khay và bàn được tạo bằng JS, không có mã scope của Astro */
  .tr-khoi { margin: 1rem 0; display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .tr-khoi[hidden] { display: none; }
  .tr-hang { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; width: 100%; max-width: 460px; }
  .tr-hang input { flex: 1; min-width: 0; font: inherit; padding: .45rem .7rem; border-radius: .5rem; border: 1px solid var(--vien); background: var(--mat); color: var(--chu); }
  .tr-nut {
    font: inherit; font-weight: 600; min-height: 2.4rem; padding: .4rem 1.1rem; border-radius: 999px; cursor: pointer;
    max-width: 100%; line-height: 1.25; text-align: center;
    border: 1px solid var(--nhan); background: transparent; color: var(--nhan);
  }
  .tr-nut { transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s, transform .1s, opacity .15s; touch-action: manipulation; }
  .tr-nut:hover:not(:disabled) { background: var(--nhan-nhe); box-shadow: 0 2px 8px rgba(0, 0, 0, .18); }
  .tr-nut:active:not(:disabled) { transform: scale(.96); }
  .tr-nut:focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; }
  /* Đang gửi yêu cầu: nút mờ đi, con trỏ chờ, không bấm thêm được */
  .tr-nut[aria-busy="true"] { opacity: .6; cursor: progress; }
  .tr-nut-chinh { background: var(--nhan); color: #fff; }
  .tr-nut-chinh:hover:not(:disabled) { background: var(--nhan); filter: brightness(1.1); }
  .tr-nut-phu { background: transparent; color: var(--phu); border-color: var(--vien); }
  .tr-nut-phu:hover:not(:disabled) { border-color: var(--nhan); color: var(--nhan); }
  .tr-nut:disabled { opacity: .45; cursor: default; }
  .tr-trang-thai { min-height: 1.5em; font-weight: 600; border-radius: .4rem; }
  /* Thông báo mới nháy nền một lần để người chơi nhận ra kết quả của nút vừa bấm */
  @media (prefers-reduced-motion: no-preference) {
    .tr-trang-thai.moi { animation: tr-nhay 1.2s ease-out; }
  }
  @keyframes tr-nhay { from { background: var(--nhan-nhe); box-shadow: 0 0 0 6px var(--nhan-nhe); } to { background: transparent; box-shadow: 0 0 0 6px transparent; } }
  .co-ban { width: 100%; max-width: 460px; margin: .5rem 0 1rem; }
  /* Khung gồm khay trên, bàn, khay dưới; cùng kích thước và kiểu với khung ở chơi với máy */
  .tr-khung { display: flex; flex-direction: column; width: 100%; max-width: 460px; margin: 0 auto; }
  .tr-khung .co-ban { max-width: none; margin: .4rem 0; }
  /* Nút âm thanh và phóng to: kiểu giống trang chơi với máy */
  .tr-thanh-nut { display: flex; justify-content: flex-end; gap: .5rem; margin: 0 0 1rem; }
  .tr-thanh-nut[hidden], .tr-khung[hidden] { display: none; }
  /* Khối nút khi đối thủ hết giờ: một thẻ nhạt màu nhấn, ba nút chia đều, xuống dòng khi màn hình hẹp */
  .tr-het-gio { width: 100%; max-width: 460px; margin: 0 0 .8rem; padding: .5rem; display: flex; flex-wrap: wrap; gap: .5rem; border: 1px solid var(--nhan); border-radius: .6rem; background: var(--nhan-nhe); }
  .tr-het-gio[hidden] { display: none; }
  /* Nút trong thẻ: chia đều hàng, chữ dài tự xuống dòng trong nút thay vì tràn ra ngoài */
  .tr-het-gio .tr-nut { flex: 1 1 8rem; font-size: .9rem; padding: .4rem .8rem; background: var(--mat); }
  .tr-het-gio .tr-nut-chinh { background: var(--nhan); }
  .tr-hang[hidden] { display: none; }
  .tr-nut-icon {
    flex: none; width: 2.4rem; height: 2.4rem; min-width: 2.4rem; padding: 0; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 1px solid var(--vien); background: var(--mat); color: var(--chu); box-shadow: var(--bong); cursor: pointer;
    transition: border-color .15s, color .15s, background-color .15s;
  }
  .tr-nut-icon:hover { border-color: var(--nhan); color: var(--nhan); }
  .tr-nut-icon:focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; }
  /* Thuộc tính hidden không luôn ẩn phần tử SVG trên mọi trình duyệt: mỗi nút chỉ hiện một biểu tượng */
  .tr-nut-icon > svg[hidden] { display: none; }
  .tr-thu-nho { position: fixed; top: .6rem; right: .6rem; z-index: 1001; }
  .tr-thu-nho[hidden] { display: none; }
  /* Khi phóng to bàn cờ thì ẩn nút chat (widget bên thứ ba) để không che bàn */
  body.tr-dang-phong-to #formmailhub-widget-container,
  body.tr-dang-phong-to iframe[title="AI Chat Assistant"] { display: none !important; }
  /* Chế độ toàn màn hình: chỉ bàn cờ, căn giữa, cao bằng màn hình */
  .co-ban:fullscreen { max-width: none; margin: 0; padding: 1rem; box-sizing: border-box; background: var(--nen); display: flex; align-items: center; justify-content: center; }
  .co-ban:fullscreen svg { width: auto; height: 100%; max-width: 100%; max-height: 100vh; }
  /* iPhone Safari không có Fullscreen API cho phần tử: phủ kín màn hình bằng CSS */
  .co-ban.tr-phong-to-css {
    position: fixed; inset: 0; z-index: 1000; width: 100%; max-width: none; height: 100vh; height: 100dvh;
    margin: 0; padding: .5rem; box-sizing: border-box; background: var(--nen); border-radius: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .co-ban.tr-phong-to-css svg { width: auto; height: 100%; max-width: 100%; }
</style>

<script>
  import { khoiTao, nuocHopLe, kyHieu, timNuoc, apDung, biChieu, diemCongVan, quanBiAn } from "../lib/co-tuong.js";
  import { duyetNuoc, benDenLuot, ketQuaChoBen, GIAY_MOI_NUOC } from "../lib/co-tuong-tran.js";
  import { taoAmThanh } from "../lib/co-tuong-am.js";
  import { taoToa, veBanCo, veKhayQuanAn, chayHieuUng, phatTiengNuoc, gaiNutTieng, THOI_GIAN } from "../lib/co-tuong-ban.js";
  import { ngheTinHieu } from "../lib/co-tuong-realtime.js";
  import { docToken, headerXacThuc, damBaoCoTen } from "../lib/co-tuong-tai-khoan.js";

  const T = JSON.parse(document.getElementById("tran-chu")?.textContent || "{}");
  const f = (mau: string, v: Record<string, string | number> = {}) => mau.replace(/\{(\w+)\}/g, (_, k) => (k in v ? String(v[k]) : `{${k}}`));
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const ma = new URLSearchParams(location.search).get("ma") || "";

  // Mã khách: tạo một lần, lưu trong trình duyệt. Dùng để nhận diện người không có tài khoản.
  function layKhachId(): string {
    try {
      let id = localStorage.getItem("choico-khach") || "";
      if (!/^[A-Za-z0-9-]{16,64}$/.test(id)) {
        id = crypto.randomUUID();
        localStorage.setItem("choico-khach", id);
      }
      return id;
    } catch {
      return crypto.randomUUID(); // trình duyệt chặn localStorage: mã chỉ dùng trong lần mở này
    }
  }
  const KHACH = layKhachId();
  const yeuCau = (): Record<string, string> => ({ "content-type": "application/json", "x-khach-id": KHACH, ...headerXacThuc() });


  let tran: any = null; // trạng thái trận từ server
  let ban: (string | null)[][] | null = null; // bàn đang hiển thị, dựng từ nước đi rồi cập nhật tức thì khi đi
  let anCuoi: string | null = null; // quân vừa bị ăn gần nhất (mã bên + loại, ví dụ "bR"), đánh dấu trong khay
  let chon: [number, number] | null = null; // ô đang chọn
  let gioDi: any[] = []; // nước hợp lệ từ ô đang chọn
  let dangGui = false; // đang gửi một nước lên server
  let pollId: number | undefined; // hẹn giờ đọc lại trạng thái
  let gioTimer: number | undefined; // hẹn giờ cập nhật đếm ngược
  let lechGio = 0; // giờ server trừ giờ máy, để đếm ngược đúng dù đồng hồ máy lệch
  let giuTrangThaiDen = 0; // trước thời điểm này (ms) thì không ghi đè dòng thông báo (ví dụ báo lỗi nước đi)
  let daBaoKetThuc = false; // đã phát tiếng kết thúc cho trận này chưa (không phát khi vừa mở một trận đã xong)

  // Hiệu ứng nước vừa đi (xem chayHieuUng trong co-tuong-ban.js). batDau: thời điểm đi; tu, den: ô rời và ô đến.
  let hieuUng: { batDau: number; quanBiAn: string | null; chieu: boolean; tu: [number, number]; den: [number, number] } | null = null;

  // Âm thanh theo lựa chọn đã lưu ở trang chơi với máy (mặc định tắt)
  const am = taoAmThanh();
  gaiNutTieng(am, { nut: $("tr-tieng"), loaBat: $("tr-loa-bat") as unknown as SVGElement, loaTat: $("tr-loa-tat") as unknown as SVGElement, nhan: T });

  const trangThai = $("tr-trang-thai");
  const banEl = $("co-ban");
  const doiEl = $("tr-doi");
  const batTrangThai = (text: string) => {
    if (trangThai.textContent === text) return;
    trangThai.textContent = text;
    trangThai.classList.remove("moi");
    void trangThai.offsetWidth; // khởi động lại hiệu ứng nháy
    trangThai.classList.add("moi");
  };
  // Chạy một việc khi bấm nút: nút mờ đi, đổi chữ và khóa trong lúc chờ. viec trả về true nếu trang sắp chuyển đi (giữ nguyên trạng thái chờ).
  async function chay(nut: HTMLButtonElement, nhanDang: string, viec: () => Promise<boolean | void>) {
    if (nut.getAttribute("aria-busy") === "true") return;
    const nhanCu = nut.textContent;
    nut.setAttribute("aria-busy", "true");
    nut.disabled = true;
    nut.textContent = nhanDang;
    let giu = false;
    try {
      giu = Boolean(await viec());
    } finally {
      if (!giu) {
        nut.removeAttribute("aria-busy");
        nut.disabled = false;
        nut.textContent = nhanCu;
      }
    }
  }
  const baoLoi = (text: string) => {
    batTrangThai(text);
    giuTrangThaiDen = Date.now() + 3000;
  };
  const doiBen = (s: string) => (s === "r" ? "b" : "r");

  async function goi(url: string, init?: RequestInit) {
    const r = await fetch(url, init);
    const data = await r.json().catch(() => ({}));
    return { ok: r.ok, status: r.status, data };
  }

  // Nhận trạng thái mới từ server: ghi nhớ độ lệch giờ để đếm ngược đúng
  function nhanTran(data: any) {
    tran = data;
    if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
  }

  // Dựng bàn từ danh sách nước đi của server
  function dungBan() {
    if (!tran?.nuoc) return;
    const d = duyetNuoc(tran.nuoc);
    ban = d.hop_le ? d.b : khoiTao();
    anCuoi = anCuoiCung(tran.nuoc);
  }

  // Quân bị ăn gần nhất trong cả ván (để đánh dấu trong khay), đi lại từ đầu ván
  function anCuoiCung(nuoc: string[]): string | null {
    const b = khoiTao();
    let s = "r";
    let cuoi: string | null = null;
    for (const ky of nuoc) {
      const m = timNuoc(b, s, ky);
      if (!m) break;
      if (m.an) cuoi = m.an;
      apDung(b, m);
      s = doiBen(s);
    }
    return cuoi;
  }

  // Khi mình cầm quân đen thì xoay bàn 180 độ để quân đen nằm phía dưới
  const xoay = () => tran?.ban_cua === "b";

  // Vẽ khay quân bị ăn: bên nào ở phía trên bàn thì khay của bên đó nằm trên (khi xoay bàn thì đảo lại)
  function veQuanAn() {
    const ket = quanBiAn(ban);
    const benTren = xoay() ? "r" : "b";
    const benDuoi = doiBen(benTren);
    // Khay không có chữ tiêu đề, chỉ đặt nhãn cho trình đọc màn hình
    $("tr-khay-tren").setAttribute("aria-label", benTren === "r" ? T.quanDoBiAn : T.quanDenBiAn);
    $("tr-khay-duoi").setAttribute("aria-label", benDuoi === "r" ? T.quanDoBiAn : T.quanDenBiAn);
    veKhayQuanAn($("tr-an-tren"), ket[benTren], benTren, anCuoi);
    veKhayQuanAn($("tr-an-duoi"), ket[benDuoi], benDuoi, anCuoi);
  }


  // Ô "a0" dạng chữ và số (cột, hàng) của server thành [hàng, cột]
  const toaO = (ten: string): [number, number] => [Number(ten[1]), ten.charCodeAt(0) - 97];

  function veBan() {
    banEl.replaceChildren();
    // Chưa có bàn (chưa có trận, đang chờ đối thủ, chưa đăng nhập...) thì ẩn khay và hàng nút loa, phóng to
    $("tr-khung").hidden = !ban;
    $("tr-thanh-nut").hidden = !ban;
    if (!ban) return;
    veQuanAn();
    const toa = taoToa(xoay());
    // Nước gần nhất trên server (ô rời và ô đến) được đánh dấu vàng
    const cuoi: string | null = tran.nuoc?.length ? tran.nuoc[tran.nuoc.length - 1] : null;
    const nuocCuoi = cuoi ? [toaO(cuoi.slice(0, 2)), toaO(cuoi.slice(2, 4))] : null;
    const s = veBanCo(banEl, {
      ban,
      toa,
      khoa: !(tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua),
      nuocCuoi,
      chon,
      dich: gioDi.map((m) => m.den),
      nhanBan: T.banCo,
    });
    // Hiệu ứng nước vừa đi (quân trượt, ăn quân, chiếu) chạy tiếp trên bàn vừa vẽ
    const nuocDi = hieuUng ? [hieuUng.tu, hieuUng.den] : null;
    if (chayHieuUng(s, hieuUng, { banEl, ban, toa, nuocCuoi: nuocDi, nhanChieu: T.chieu })) hieuUng = null;
  }


  function apMove(m: any, s: string) {
    if (!ban) return;
    apDung(ban, m);
    if (m.an) anCuoi = m.an;
    hieuUng = { batDau: Date.now(), quanBiAn: m.an || null, chieu: biChieu(ban, doiBen(s)), tu: m.tu, den: m.den };
    phatTiengNuoc(am, Boolean(m.an), hieuUng.chieu);
  }

  // Đi nước: hiện ngay trên màn hình rồi gửi server ngầm, không phải chờ mạng mới thấy quân di chuyển
  async function diNuoc(m: any) {
    const ky = kyHieu(m);
    const s = tran.ban_cua;
    apMove(m, s);
    tran.nuoc = [...tran.nuoc, ky];
    tran.den_luot = doiBen(s);
    tran.han_nuoc = new Date(Date.now() + lechGio + GIAY_MOI_NUOC * 1000).toISOString();
    const kt = duyetNuoc(tran.nuoc);
    if (kt.hop_le && kt.ket_thuc) {
      tran.trang_thai = "ket_thuc";
      tran.ket_qua = kt.ket_qua;
      tran.ly_do = kt.ly_do;
    }
    chon = null;
    gioDi = [];
    hienKhoi();
    dangGui = true;
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "nuoc", ma, ky, gui: Date.now() + lechGio }),
    });
    dangGui = false;
    if (ok) {
      // Khớp với màn hình thì chỉ cập nhật giờ; lệch thì dựng lại theo server
      if (data.nuoc?.length === tran.nuoc.length && data.trang_thai === tran.trang_thai) {
        tran.han_nuoc = data.han_nuoc;
        if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      } else {
        nhanTran(data);
        dungBan();
        hienKhoi();
      }
      return;
    }
    // Server từ chối (sai luật, hết giờ, đối thủ đã đầu hàng...): bỏ hiệu ứng, tải trạng thái thật và báo
    hieuUng = null;
    await taiTran();
    if (tran.trang_thai === "dang_dau") baoLoi(T.trNuocSai); // trận đã đóng thì thông báo đóng trận đã hiện rồi
  }

  // Nhấp vào bàn: chọn quân của mình, rồi nhấp vào ô đích để đi
  banEl.addEventListener("click", (e) => {
    am.mo(); // mở ngữ cảnh âm thanh ngay trong lúc người dùng bấm (iPhone chỉ cho phép như vậy)
    const o = (e.target as Element).closest(".co-o");
    if (!o || !ban || dangGui || tran?.trang_thai !== "dang_dau" || tran.den_luot !== tran.ban_cua) return;
    const r = Number(o.getAttribute("data-r"));
    const c = Number(o.getAttribute("data-c"));
    const benMinh = tran.ban_cua;
    const quan = ban[r][c];

    if (chon) {
      const m = gioDi.find((x) => x.den[0] === r && x.den[1] === c);
      if (m) return void diNuoc(m);
    }
    if (quan && quan[0] === benMinh) {
      chon = [r, c];
      gioDi = nuocHopLe(ban, benMinh).filter((m) => m.tu[0] === r && m.tu[1] === c);
    } else {
      chon = null;
      gioDi = [];
    }
    veBan();
  });

  // Phóng to: chỉ bàn cờ chiếm toàn màn hình. Trình duyệt có Fullscreen API thì dùng nó, iPhone Safari thì phủ bằng CSS.
  const phongEl = $("tr-phong-to");
  const thuNhoEl = $("tr-thu-nho");
  const coFullscreen = !!banEl.requestFullscreen;
  const phongMoEl = $("tr-phong-mo") as unknown as SVGElement;
  const phongDongEl = $("tr-phong-dong") as unknown as SVGElement;
  const dangPhong = () => document.fullscreenElement === banEl || banEl.classList.contains("tr-phong-to-css");
  const nhanPhong = () => (dangPhong() ? T.thuNhoBan : T.phongTo);
  const capNhatPhongTo = () => {
    const dang = dangPhong();
    document.body.classList.toggle("tr-dang-phong-to", dang);
    phongEl.setAttribute("aria-label", nhanPhong());
    phongEl.title = nhanPhong();
    phongMoEl.toggleAttribute("hidden", dang);
    phongDongEl.toggleAttribute("hidden", !dang);
  };
  // Đổi phóng to bằng CSS (iPhone): cập nhật nút và nút thu nhỏ cố định
  const datPhongCss = (bat: boolean) => {
    banEl.classList.toggle("tr-phong-to-css", bat);
    thuNhoEl.hidden = !bat;
    capNhatPhongTo();
  };
  phongEl.addEventListener("click", () => {
    if (coFullscreen) {
      if (document.fullscreenElement === banEl) void document.exitFullscreen();
      else void banEl.requestFullscreen().catch(() => {});
    } else {
      datPhongCss(!banEl.classList.contains("tr-phong-to-css"));
    }
  });
  thuNhoEl.addEventListener("click", () => datPhongCss(false));
  if (coFullscreen) document.addEventListener("fullscreenchange", capNhatPhongTo);
  capNhatPhongTo();

  // Đọc trạng thái trận, dựng lại bàn và hiện đúng khối việc
  async function taiTran() {
    if (!ma) return hienKhoiTao();
    const { ok, status, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok) {
      batTrangThai(status === 404 ? T.trTranKhongTim : (T.loiMang || ""));
      return;
    }
    nhanTran(data);
    daBaoKetThuc = data.trang_thai === "ket_thuc"; // mở một trận đã xong thì không phát tiếng kết thúc
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  function hienKhoiTao() {
    $("tr-tao").hidden = false;
    $("tr-ten-tao-hang").hidden = !!docToken(); // đã đăng nhập thì dùng tên tài khoản
    batTrangThai("");
  }

  // Dòng "Đối thủ: X · Còn N giây" và dòng trạng thái, cập nhật mỗi giây khi trận đang đi.
  // Hết giờ thì không xử thua: bên đang chờ thấy ba lựa chọn, bên chậm thấy đang chờ đối thủ quyết định.
  function capNhatGio() {
    if (tran?.trang_thai !== "dang_dau") return;
    const toi = tran.den_luot === tran.ban_cua;
    const ten = tran.ban_cua === "r" ? tran.ten_den : tran.ten_do;
    let hetGio = false;
    let gio: string;
    if (!tran.han_nuoc) {
      gio = T.trKhongGioiHan;
    } else {
      const giay = Math.ceil((Date.parse(tran.han_nuoc) - (Date.now() + lechGio)) / 1000);
      hetGio = giay <= 0;
      gio = hetGio ? T.trHetGioNgan : f(T.trGioCon, { s: giay });
    }
    doiEl.textContent = [ten ? f(T.trDoi, { ten }) : "", gio].filter(Boolean).join(" · ");
    $("tr-het-gio").hidden = !(hetGio && !toi);
    if (Date.now() >= giuTrangThaiDen) {
      const minhDo = tran.ban_cua === "r";
      batTrangThai(hetGio ? (toi ? T.trHetGioChoQuyet : T.trHetGioBanQuyet) : `${toi ? T.trToiLuot : T.trDoiLuot} · ${minhDo ? T.trBanDo : T.trBanDen}`);
    }
  }

  // Sau khi trận xong: đường đi tiếp (về sảnh thượng đài, hoặc tạo trận khép kín mới)
  function hienBuocTiep() {
    const tienTo = document.documentElement.dataset.tienTo || "";
    const a = $("tr-tiep-a") as HTMLAnchorElement;
    a.href = tran.loai === "dai" ? `${tienTo}/thuong-dai/` : `${tienTo}/tran/`;
    a.textContent = tran.loai === "dai" ? T.trVeSanh : T.trTranMoi;
    $("tr-tiep").hidden = false;
  }

  function hienKhoi() {
    // Khay và hàng nút loa, phóng to chỉ hiện khi veBan() vẽ được bàn; mọi trạng thái chờ (kể cả đài thượng đài) thì ẩn
    $("tr-khung").hidden = true;
    $("tr-thanh-nut").hidden = true;
    $("tr-tao").hidden = true;
    $("tr-link").hidden = true;
    $("tr-roi-dai").hidden = true;
    $("tr-vao").hidden = true;
    $("tr-dieu-khien").hidden = true;
    $("tr-tiep").hidden = true;
    $("tr-het-gio").hidden = true;
    $("tr-mo-ta").hidden = tran?.loai === "dai"; // đoạn mô tả nói về trận khép kín, không đúng với trận thượng đài
    // Tiêu đề theo loại trận để người chơi biết mình đang ở trận nào; chưa rõ loại thì dùng tiêu đề chung
    const tieuDe = tran?.loai === "dai" ? T.tdTieuDe : tran?.loai === "khep_kin" ? T.trTieuDeKhepKin : T.trTieuDe;
    $("tr-h1").textContent = tieuDe;
    document.title = tieuDe;
    doiEl.textContent = "";
    clearInterval(gioTimer);

    // Người ngoài: link còn chờ thì hiện nút vào chơi
    if (!tran.ban_cua) {
      if (tran.loai === "dai") return batTrangThai(T.trVaoTuSanh); // trận thượng đài chỉ vào từ sảnh, không qua link
      if (tran.trang_thai === "cho") {
        $("tr-vao").hidden = false;
        $("tr-moi-vao").textContent = f(T.trMoiVao, { ten: tran.ten_do || "" });
        ($("tr-ten-vao").parentElement as HTMLElement).hidden = !!docToken();
        return batTrangThai("");
      }
      return batTrangThai(tran.trang_thai === "huy" ? T.trHetHan : T.trDaCoNguoi);
    }

    // Người tạo đang chờ người vào: hiện link để gửi (và tự cập nhật khi có người vào)
    if (tran.trang_thai === "cho" && tran.loai === "dai") {
      $("tr-roi-dai").hidden = false;
      batTrangThai(T.trChoDoiThu);
      return datPoll();
    }
    if (tran.trang_thai === "cho") {
      $("tr-link").hidden = false;
      ($("tr-link-o") as HTMLInputElement).value = `${location.origin}${location.pathname}?ma=${ma}`;
      batTrangThai(T.trChoBan);
      return datPoll();
    }

    // Trận đã đóng: link bị người tạo vô hiệu hóa, hoặc bị bỏ dở quá lâu
    if (tran.trang_thai === "huy") {
      if (tran.nuoc?.length) veBan();
      hienBuocTiep();
      return batTrangThai(tran.ly_do === "bo_do" ? T.trTranDong : T.trDaVoHieu);
    }

    // Trận đang đi hoặc đã xong
    veBan();
    const minhDo = tran.ban_cua === "r";
    if (tran.trang_thai === "dang_dau") {
      $("tr-dieu-khien").hidden = false;
      giuTrangThaiDen = 0;
      capNhatGio();
      gioTimer = window.setInterval(capNhatGio, 1000);
      return datPoll();
    }
    // Đã kết thúc
    const ten = minhDo ? tran.ten_den : tran.ten_do;
    doiEl.textContent = ten ? f(T.trDoi, { ten }) : "";
    const kq = tran.ket_qua === "do" ? T.trKetDo : tran.ket_qua === "den" ? T.trKetDen : T.trKetHoa;
    const ly = tran.ly_do === "het_gio" ? T.trLyHetGio : tran.ly_do === "dau_hang" ? T.trLyDauHang : tran.ly_do === "bo_do" ? T.trLyBoDo : T.trLyHetNuoc;
    let diem = T.trKhongTinh;
    if (tran.loai === "dai") {
      const d = diemCongVan(ketQuaChoBen(tran.ket_qua, tran.ban_cua), 0);
      diem = f(T.trDiemTran, { diem: `${d > 0 ? "+" : ""}${d}` });
    }
    batTrangThai(`${kq}${tran.ly_do ? ` (${ly})` : ""}. ${diem}`);
    hienBuocTiep();
    if (!daBaoKetThuc) {
      daBaoKetThuc = true;
      const thang = (tran.ket_qua === "do" && minhDo) || (tran.ket_qua === "den" && !minhDo);
      am.phat(tran.ket_qua === "hoa" ? "hoa" : thang ? "thang" : "thua", THOI_GIAN.DI + 500); // sau tiếng đi quân và hiệu ứng
    }
    datPoll();
  }

  // Đối thủ vừa đi thì bàn cập nhật và chạy hiệu ứng như nước đi của máy
  async function docMoi() {
    const cu: number = tran?.nuoc?.length ?? 0;
    const trangThaiCu = tran?.trang_thai;
    const { ok, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok || dangGui) return; // người chơi vừa đi trong lúc chờ: bỏ kết quả cũ này
    const moi: number = data.nuoc?.length ?? 0;
    if (moi === cu && data.trang_thai === trangThaiCu) {
      if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      if (data.han_nuoc !== tran.han_nuoc) {
        tran.han_nuoc = data.han_nuoc; // đối thủ vừa cho thêm giờ hoặc cho nghĩ thoải mái
        capNhatGio();
      }
      return;
    }
    // Đúng một nước mới của đối thủ: đi nước đó trên bàn đang có để quân trượt, có tiếng, có hiệu ứng
    if (trangThaiCu === "dang_dau" && moi === cu + 1 && ban) {
      const s = benDenLuot(cu);
      const m = timNuoc(ban, s, data.nuoc[moi - 1]);
      if (m) {
        apMove(m, s);
        nhanTran(data);
        chon = null;
        gioDi = [];
        return hienKhoi();
      }
    }
    nhanTran(data);
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  // Chuông mang kèm tóm tắt trận (số nước, nước cuối, hạn nước, trạng thái): đối thủ vừa đi một nước, hoặc vừa cho thêm giờ,
  // thì làm luôn trên bàn mà không gọi server. Trường hợp khác (trận đổi trạng thái, lệch số nước...) trả false để đọc lại cả trận.
  function apTomTat(t: any): boolean {
    if (!t || !ban || tran?.trang_thai !== "dang_dau" || t.trang_thai !== "dang_dau") return false;
    const cu: number = tran.nuoc.length;
    if (t.n === cu) {
      if (t.han !== tran.han_nuoc) {
        tran.han_nuoc = t.han;
        capNhatGio();
      }
      return true;
    }
    const s = benDenLuot(cu);
    if (t.n !== cu + 1 || s === tran.ban_cua) return false; // nước của chính mình từ tab khác: đọc lại cho chắc
    const m = timNuoc(ban, s, t.ky);
    if (!m) return false;
    apMove(m, s);
    tran.nuoc = [...tran.nuoc, t.ky];
    tran.den_luot = doiBen(s);
    tran.han_nuoc = t.han;
    chon = null;
    gioDi = [];
    hienKhoi();
    // Độ trễ từ lúc đối thủ bấm tới lúc quân hiện ở đây (theo giờ server ước lượng ở hai máy, sai số cỡ vài chục ms)
    if (t.gui) console.info(`[choico] nước đối thủ tới sau ${Math.round(Date.now() + lechGio - t.gui)} ms`);
    return true;
  }

  // Chuông báo realtime của trận: đang nghe được thì chỉ đọc lại khi chuông rung, cộng một lần dự phòng thưa.
  // Không nghe được (trận cũ chưa có chuông, mạng chặn SSE...) thì quay về đọc lại theo nhịp như trước.
  const DU_PHONG_MS = 20000;
  let dangNghe = false;
  let chuongDangNghe = "";
  let dungNghe: (() => void) | null = null;
  function capNhatNghe(can: boolean) {
    const id: string = can ? tran?.tin_hieu || "" : "";
    if (id === chuongDangNghe) return;
    dungNghe?.();
    dungNghe = null;
    dangNghe = false;
    chuongDangNghe = id;
    if (!id) return;
    dungNghe = ngheTinHieu(
      id,
      (banGhi: any) => {
        if (dangGui) return;
        // Chuông rung: có tóm tắt dùng được thì đi quân ngay, không thì đọc trạng thái mới; rồi hẹn lại lần dự phòng
        if (apTomTat(banGhi?.tom_tat)) return datPoll();
        void docMoi().then(() => datPoll());
      },
      (ok: boolean) => {
        const doi = ok !== dangNghe;
        dangNghe = ok;
        if (doi) datPoll(); // đổi nhịp đọc dự phòng theo việc có nghe được chuông hay không
      },
    );
  }

  // Hẹn lần đọc lại tiếp theo: có chuông thì thưa (dự phòng); không có thì nhanh khi chờ đối thủ đi, chậm hơn khi đến lượt mình hoặc tab ẩn
  function datPoll() {
    clearTimeout(pollId);
    pollId = undefined;
    const caoNhat = tran?.ban_cua && (tran.trang_thai === "dang_dau" || tran.trang_thai === "cho");
    capNhatNghe(Boolean(caoNhat)); // trận xong thì thôi nghe
    if (!caoNhat) return;
    const luotMinh = tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua;
    const doTre = dangNghe ? DU_PHONG_MS : document.hidden ? 5000 : tran.trang_thai === "cho" || luotMinh ? 2500 : 1000;
    pollId = window.setTimeout(async () => {
      pollId = undefined;
      await docMoi();
      datPoll();
    }, doTre);
  }

  const nut = (id: string) => $(id) as HTMLButtonElement;

  // Tạo link (tài khoản hoặc khách), xong thì chuyển sang trang có mã
  nut("tr-nut-tao").addEventListener("click", () => void chay(nut("tr-nut-tao"), T.trDangTao, async () => {
    const tenKhach = ($("tr-ten-tao") as HTMLInputElement).value.trim();
    const tao = () => goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "tao", ten_khach: tenKhach }),
    });
    let { ok, status, data } = await tao();
    // Người mới đăng nhập chưa có tên: tạo tên từ tên Google (như trang chơi với máy) rồi tạo link lại
    if (status === 409 && data.loi === "chua_co_ten" && (await damBaoCoTen())) ({ ok, status, data } = await tao());
    if (ok && data.ma) {
      location.href = `${location.pathname}?ma=${data.ma}`;
      return true;
    }
    batTrangThai(status === 429 ? T.trTaoQuaNhieu : T.tdLoi);
  }));

  nut("tr-nut-chep").addEventListener("click", async () => {
    const o = $("tr-link-o") as HTMLInputElement;
    try {
      await navigator.clipboard.writeText(o.value);
      $("tr-nut-chep").textContent = T.trDaChep;
      setTimeout(() => ($("tr-nut-chep").textContent = T.trChepLink), 2000);
    } catch {
      o.select();
    }
  });

  // Vô hiệu hóa link: xong thì khối link biến mất và thông báo nháy lên
  nut("tr-nut-vo-hieu").addEventListener("click", () => void chay(nut("tr-nut-vo-hieu"), T.trDangXuLy, async () => {
    const { ok } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "huy", ma }),
    });
    if (!ok) return void batTrangThai(T.tdLoi);
    await taiTran(); // trạng thái "huy": hiện thông báo link đã vô hiệu hóa
    batTrangThai(T.trDaVoHieu);
  }));

  nut("tr-nut-vao").addEventListener("click", () => void chay(nut("tr-nut-vao"), T.trDangXuLy, async () => {
    const tenKhach = ($("tr-ten-vao") as HTMLInputElement).value.trim();
    const { ok, data } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "vao", ma, ten_khach: tenKhach }),
    });
    if (ok) return void (await taiTran());
    batTrangThai(data.loi === "da_co_nguoi_vao" ? T.trDaCoNguoi : data.loi === "link_het_han" ? T.trHetHan : T.tdLoi);
  }));

  nut("tr-nut-dau-hang").addEventListener("click", () => void chay(nut("tr-nut-dau-hang"), T.trDangXuLy, async () => {
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "dau_hang", ma }),
    });
    if (!ok) return void (await taiTran());
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }));

  // Đối thủ hết giờ: chọn cho nghĩ thêm 1 phút, nghĩ thoải mái hoặc xử thua
  async function xuHetGio(luaChon: string) {
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "xu_het_gio", ma, lua_chon: luaChon }),
    });
    if (!ok) return void (await taiTran()); // trạng thái đã đổi (đối thủ vừa đi): tải lại cho đúng
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }
  nut("tr-nut-them").addEventListener("click", () => void chay(nut("tr-nut-them"), T.trDangXuLy, () => xuHetGio("them_1_phut")));
  nut("tr-nut-thoai").addEventListener("click", () => void chay(nut("tr-nut-thoai"), T.trDangXuLy, () => xuHetGio("thoai_mai")));

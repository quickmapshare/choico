---
// Trang trận khép kín: tạo link mời (cần đăng nhập) hoặc vào chơi qua link (không cần đăng nhập). Không tính điểm.
import Layout from "../layouts/Layout.astro";
import { t, chuCaTrang } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
const T = chuCaTrang(lang);
---
<Layout lang={lang} tieuDe={t(lang, "trTieuDe")} moTa={t(lang, "trMoTa")}>
  <script is:inline type="application/json" id="tran-chu" set:html={JSON.stringify(T)}></script>
  <h1>{T.trTieuDe}</h1>
  <p class="phu">{T.trMoTa}</p>

  <section id="tr-tao" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-tao" class="tr-nut tr-nut-chinh">{T.trTaoLink}</button>
    <p id="tr-can-dang-nhap" class="phu" hidden>{T.trCanDangNhap}</p>
  </section>

  <section id="tr-link" class="tr-khoi" hidden>
    <p class="phu">{T.trLinkCuaBan}</p>
    <div class="tr-hang">
      <input id="tr-link-o" type="text" readonly />
      <button type="button" id="tr-nut-chep" class="tr-nut">{T.trChepLink}</button>
    </div>
    <button type="button" id="tr-nut-vo-hieu" class="tr-nut tr-nut-phu">{T.trVoHieu}</button>
  </section>

  <section id="tr-vao" class="tr-khoi" hidden>
    <p id="tr-moi-vao"></p>
    <label class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-vao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <button type="button" id="tr-nut-vao" class="tr-nut tr-nut-chinh">{T.trVao}</button>
  </section>

  <p id="tr-trang-thai" class="tr-trang-thai" role="status" aria-live="polite"></p>
  <p id="tr-doi" class="phu"></p>
  <div id="tr-ban" class="tr-ban"></div>
  <div id="tr-dieu-khien" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-dau-hang" class="tr-nut tr-nut-phu">{T.trDauHang}</button>
  </div>

<style>
  .tr-khoi { margin: 1rem 0; display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .tr-khoi[hidden] { display: none; }
  .tr-hang { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; width: 100%; max-width: 460px; }
  .tr-hang input { flex: 1; min-width: 0; font: inherit; padding: .45rem .7rem; border-radius: .5rem; border: 1px solid var(--vien); background: var(--mat); color: var(--chu); }
  .tr-nut {
    font: inherit; font-weight: 600; min-height: 2.4rem; padding: .4rem 1.1rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--nhan); background: transparent; color: var(--nhan);
  }
  .tr-nut-chinh { background: var(--nhan); color: #fff; }
  .tr-nut-phu { background: transparent; color: var(--phu); border-color: var(--vien); }
  .tr-nut:disabled { opacity: .45; cursor: default; }
  .tr-trang-thai { min-height: 1.5em; font-weight: 600; }
  .tr-ban { width: 100%; max-width: 460px; margin: .5rem 0 1rem; }
  .tr-ban svg { width: 100%; height: auto; display: block; user-select: none; overflow: visible; }
  .tr-ban .o { cursor: pointer; }
  .tr-ban .khoa .o { cursor: default; }
</style>

<script>
  import { khoiTao, nuocHopLe, kyHieu } from "../lib/co-tuong.js";
  import { duyetNuoc, benDenLuot } from "../lib/co-tuong-tran.js";
  import { docToken, headerXacThuc, batDauDangNhap } from "../lib/co-tuong-tai-khoan.js";

  const T = JSON.parse(document.getElementById("tran-chu")?.textContent || "{}");
  const f = (mau: string, v: Record<string, string | number> = {}) => mau.replace(/\{(\w+)\}/g, (_, k) => (k in v ? String(v[k]) : `{${k}}`));
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const ma = new URLSearchParams(location.search).get("ma") || "";

  // Mã khách: tạo một lần, lưu trong trình duyệt. Dùng để nhận diện người không có tài khoản.
  function layKhachId(): string {
    try {
      let id = localStorage.getItem("choico-khach") || "";
      if (!/^[A-Za-z0-9-]{16,64}$/.test(id)) {
        id = crypto.randomUUID();
        localStorage.setItem("choico-khach", id);
      }
      return id;
    } catch {
      return crypto.randomUUID(); // trình duyệt chặn localStorage: mã chỉ dùng trong lần mở này
    }
  }
  const KHACH = layKhachId();
  const yeuCau = (): Record<string, string> => ({ "content-type": "application/json", "x-khach-id": KHACH, ...headerXacThuc() });

  const KC = 50;
  const LE = 30;
  const RONG = LE * 2 + 8 * KC;
  const CAO = LE * 2 + 9 * KC;
  const TEN = { K: "帥", A: "仕", E: "相", H: "傌", R: "俥", C: "炮", P: "兵" };
  const TEN_DEN = { K: "將", A: "士", E: "象", H: "馬", R: "車", C: "砲", P: "卒" };

  let tran: any = null; // trạng thái trận từ server
  let ban: (string | null)[][] | null = null; // bàn dựng lại từ nước đi
  let chon: [number, number] | null = null; // ô đang chọn
  let gioDi: any[] = []; // nước hợp lệ từ ô đang chọn
  let dangGui = false;
  let timer: number | undefined;

  const trangThai = $("tr-trang-thai");
  const banEl = $("tr-ban");
  const doiEl = $("tr-doi");

  function batTrangThai(text: string) {
    trangThai.textContent = text;
  }

  async function goi(url: string, init?: RequestInit) {
    const r = await fetch(url, init);
    const data = await r.json().catch(() => ({}));
    return { ok: r.ok, status: r.status, data };
  }

  // Dựng bàn từ danh sách nước đi của server
  function dungBan() {
    if (!tran?.nuoc) return;
    const d = duyetNuoc(tran.nuoc);
    ban = d.hop_le ? d.b : khoiTao();
  }

  // Khi mình cầm quân đen thì xoay bàn 180 độ để quân đen nằm phía dưới
  const xoay = () => tran?.ban_cua === "b";
  const toaX = (c: number) => LE + (xoay() ? 8 - c : c) * KC;
  const toaY = (r: number) => LE + (xoay() ? 9 - r : r) * KC;

  function veBan() {
    banEl.replaceChildren();
    if (!ban) return;
    const khoa = !(tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua);
    banEl.classList.toggle("khoa", khoa);
    const NS = "http://www.w3.org/2000/svg";
    const s = document.createElementNS(NS, "svg");
    s.setAttribute("viewBox", `0 0 ${RONG} ${CAO}`);
    s.setAttribute("role", "img");
    const them = (tag: string, attrs: Record<string, string | number>, cha: Element = s) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      cha.appendChild(e);
      return e;
    };
    them("rect", { x: 0, y: 0, width: RONG, height: CAO, rx: 10, fill: "#f1dca8" });
    const net = { stroke: "#7a4b1e", "stroke-width": 1.5, fill: "none" };
    for (let r = 0; r < 10; r++) them("line", { ...net, x1: toaX(0), y1: toaY(r), x2: toaX(8), y2: toaY(r) });
    for (let c = 0; c < 9; c++) {
      if (c === 0 || c === 8) them("line", { ...net, x1: toaX(c), y1: toaY(0), x2: toaX(c), y2: toaY(9) });
      else {
        them("line", { ...net, x1: toaX(c), y1: toaY(0), x2: toaX(c), y2: toaY(4) });
        them("line", { ...net, x1: toaX(c), y1: toaY(5), x2: toaX(c), y2: toaY(9) });
      }
    }
    const nuocCuoi = tran.nuoc?.length ? tran.nuoc[tran.nuoc.length - 1] : null;
    for (let r = 0; r < 10; r++) {
      for (let c = 0; c < 9; c++) {
        const g = them("g", { class: "o", "data-r": r, "data-c": c });
        const x = toaX(c);
        const y = toaY(r);
        if (chon && chon[0] === r && chon[1] === c) them("circle", { cx: x, cy: y, r: 22, fill: "none", stroke: "#1e88e5", "stroke-width": 3 }, g);
        if (gioDi.some((m) => m.den[0] === r && m.den[1] === c)) them("circle", { cx: x, cy: y, r: 7, fill: "rgba(30,136,229,.65)" }, g);
        const p = ban[r][c];
        if (p) {
          const mau = p[0] === "r" ? "#b3261e" : "#1f1f1f";
          them("circle", { cx: x, cy: y, r: 20, fill: "#fbf6e6", stroke: mau, "stroke-width": 2 }, g);
          const txt = them("text", { x, y: y + 8, "text-anchor": "middle", "font-size": 24, "font-weight": "bold", fill: mau }, g);
          txt.textContent = p[0] === "r" ? TEN[p[1]] : TEN_DEN[p[1]];
        }
        // Đánh dấu nước vừa đi (nước cuối trong danh sách)
        if (nuocCuoi && (nuocCuoi.slice(2, 4) === `${String.fromCharCode(97 + c)}${r}`)) {
          them("circle", { cx: x, cy: y, r: 24, fill: "none", stroke: "#e0a100", "stroke-width": 3 }, g);
        }
        them("circle", { cx: x, cy: y, r: KC / 2 - 2, fill: "transparent" }, g);
      }
    }
    banEl.appendChild(s);
  }

  // Nhấp vào bàn: chọn quân của mình, rồi nhấp vào ô đích để đi
  banEl.addEventListener("click", async (e) => {
    const o = (e.target as Element).closest(".o");
    if (!o || !ban || dangGui || tran?.trang_thai !== "dang_dau" || tran.den_luot !== tran.ban_cua) return;
    const r = Number(o.getAttribute("data-r"));
    const c = Number(o.getAttribute("data-c"));
    const benMinh = tran.ban_cua;
    const quan = ban[r][c];

    if (chon) {
      const m = gioDi.find((x) => x.den[0] === r && x.den[1] === c);
      if (m) {
        dangGui = true;
        const { ok } = await goi("/api/co-tuong-tran", {
          method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "nuoc", ma, ky: kyHieu(m) }),
        });
        dangGui = false;
        chon = null;
        gioDi = [];
        await taiTran();
        if (!ok) batTrangThai(T.trNuocSai);
        return;
      }
    }
    if (quan && quan[0] === benMinh) {
      chon = [r, c];
      gioDi = nuocHopLe(ban, benMinh).filter((m) => m.tu[0] === r && m.tu[1] === c);
    } else {
      chon = null;
      gioDi = [];
    }
    veBan();
  });

  // Đọc trạng thái trận, dựng lại bàn và hiện đúng khối việc
  async function taiTran() {
    if (!ma) return hienKhoiTao();
    const { ok, status, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok) {
      batTrangThai(status === 404 ? T.trTranKhongTim : (T.loiMang || ""));
      return;
    }
    tran = data;
    dungBan();
    hienKhoi();
  }

  function hienKhoiTao() {
    $("tr-tao").hidden = false;
    const coToken = !!docToken();
    ($("tr-nut-tao") as HTMLButtonElement).hidden = !coToken;
    $("tr-can-dang-nhap").hidden = coToken;
    batTrangThai("");
  }

  function hienKhoi() {
    $("tr-tao").hidden = true;
    $("tr-link").hidden = true;
    $("tr-vao").hidden = true;
    $("tr-dieu-khien").hidden = true;
    doiEl.textContent = "";
    clearInterval(timer);

    // Người ngoài: link còn chờ thì hiện nút vào chơi
    if (!tran.ban_cua) {
      if (tran.trang_thai === "cho") {
        $("tr-vao").hidden = false;
        $("tr-moi-vao").textContent = f(T.trMoiVao, { ten: tran.ten_do || "" });
        ($("tr-ten-vao").parentElement as HTMLElement).hidden = !!docToken();
        return batTrangThai("");
      }
      return batTrangThai(tran.trang_thai === "huy" ? T.trHetHan : T.trDaCoNguoi);
    }

    // Người tạo đang chờ người vào: hiện link để gửi
    if (tran.trang_thai === "cho") {
      $("tr-link").hidden = false;
      ($("tr-link-o") as HTMLInputElement).value = `${location.origin}${location.pathname}?ma=${ma}`;
      return batTrangThai(T.trChoBan);
    }

    // Trận đang đi hoặc đã xong
    veBan();
    doiEl.textContent = tran.ten_den ? f(T.trDoi, { ten: tran.ten_den }) : "";
    const minhDo = tran.ban_cua === "r";
    if (tran.trang_thai === "dang_dau") {
      $("tr-dieu-khien").hidden = false;
      const toi = tran.den_luot === tran.ban_cua;
      batTrangThai(`${toi ? T.trToiLuot : T.trDoiLuot} · ${minhDo ? T.trBanDo : T.trBanDen}`);
      timer = window.setInterval(() => void taiTranLanSau(), 2000);
      return;
    }
    // Đã kết thúc
    const kq = tran.ket_qua === "do" ? T.trKetDo : tran.ket_qua === "den" ? T.trKetDen : T.trKetHoa;
    const ly = tran.ly_do === "het_gio" ? T.trLyHetGio : tran.ly_do === "dau_hang" ? T.trLyDauHang : T.trLyHetNuoc;
    batTrangThai(`${kq}${tran.ly_do ? ` (${ly})` : ""}. ${T.trKhongTinh}`);
  }

  // Cập nhật lặp (đối thủ vừa đi thì bàn tự cập nhật)
  async function taiTranLanSau() {
    if (dangGui) return;
    const cu = tran?.nuoc?.length;
    const { ok, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok) return;
    if (data.nuoc?.length === cu && data.trang_thai === tran.trang_thai) return;
    tran = data;
    dungBan();
    hienKhoi();
  }

  // Tạo link: cần đăng nhập, xong thì chuyển sang trang có mã
  $("tr-nut-tao").addEventListener("click", async () => {
    const { ok, data } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "tao" }),
    });
    if (ok && data.ma) location.href = `${location.pathname}?ma=${data.ma}`;
    else batTrangThai(T.loiMang || "");
  });

  $("tr-nut-chep").addEventListener("click", async () => {
    const o = $("tr-link-o") as HTMLInputElement;
    try {
      await navigator.clipboard.writeText(o.value);
      $("tr-nut-chep").textContent = T.trDaChep;
    } catch {
      o.select();
    }
  });

  $("tr-nut-vo-hieu").addEventListener("click", async () => {
    const { ok } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "huy", ma }),
    });
    batTrangThai(ok ? T.trDaVoHieu : (T.loiMang || ""));
    await taiTran();
  });

  $("tr-nut-vao").addEventListener("click", async () => {
    const tenKhach = ($("tr-ten-vao") as HTMLInputElement).value.trim();
    const { ok, data } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "vao", ma, ten_khach: tenKhach }),
    });
    if (ok) return taiTran();
    batTrangThai(data.loi === "da_co_nguoi_vao" ? T.trDaCoNguoi : data.loi === "link_het_han" ? T.trHetHan : (T.loiMang || ""));
  });

  $("tr-nut-dau-hang").addEventListener("click", async () => {
    await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "dau_hang", ma }),
    });
    await taiTran();
  });

  // Nút đăng nhập ngay trong thông báo cần đăng nhập
  $("tr-can-dang-nhap").addEventListener("click", () => void batDauDangNhap());

  void taiTran();
</script>
</Layout>

---
// Trang trận khép kín: tạo link mời (cần đăng nhập) hoặc vào chơi qua link (không cần đăng nhập). Không tính điểm.
import Layout from "../layouts/Layout.astro";
import { t, chuCaTrang } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
const T = chuCaTrang(lang);
---
<Layout lang={lang} tieuDe={t(lang, "trTieuDe")} moTa={t(lang, "trMoTa")} khongLapChiMuc>
  <script is:inline type="application/json" id="tran-chu" set:html={JSON.stringify(T)}></script>
  <h1>{T.trTieuDe}</h1>
  <p class="phu">{T.trMoTa}</p>

  <section id="tr-tao" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-tao" class="tr-nut tr-nut-chinh">{T.trTaoLink}</button>
    <p id="tr-can-dang-nhap" class="phu" hidden>{T.trCanDangNhap}</p>
  </section>

  <section id="tr-link" class="tr-khoi" hidden>
    <p class="phu">{T.trLinkCuaBan}</p>
    <div class="tr-hang">
      <input id="tr-link-o" type="text" readonly />
      <button type="button" id="tr-nut-chep" class="tr-nut">{T.trChepLink}</button>
    </div>
    <button type="button" id="tr-nut-vo-hieu" class="tr-nut tr-nut-phu">{T.trVoHieu}</button>
  </section>

  <section id="tr-roi-dai" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-roi-dai" class="tr-nut tr-nut-phu">{T.tdRoiDai}</button>
  </section>

  <section id="tr-vao" class="tr-khoi" hidden>
    <p id="tr-moi-vao"></p>
    <label class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-vao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <button type="button" id="tr-nut-vao" class="tr-nut tr-nut-chinh">{T.trVao}</button>
  </section>

  <p id="tr-trang-thai" class="tr-trang-thai" role="status" aria-live="polite"></p>
  <p id="tr-doi" class="phu"></p>
  <div id="tr-ban" class="tr-ban"></div>
  <div id="tr-het-gio" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-them" class="tr-nut tr-nut-chinh">{T.trThem1Phut}</button>
    <button type="button" id="tr-nut-thoai" class="tr-nut">{T.trThoaiMai}</button>
    <button type="button" id="tr-nut-xu" class="tr-nut tr-nut-phu">{T.trXuThua}</button>
  </div>
  <p id="tr-tiep" class="tr-khoi" hidden><a id="tr-tiep-a" href="#"></a></p>
  <div id="tr-dieu-khien" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-dau-hang" class="tr-nut tr-nut-phu">{T.trDauHang}</button>
  </div>

<style>
  .tr-khoi { margin: 1rem 0; display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .tr-khoi[hidden] { display: none; }
  .tr-hang { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; width: 100%; max-width: 460px; }
  .tr-hang input { flex: 1; min-width: 0; font: inherit; padding: .45rem .7rem; border-radius: .5rem; border: 1px solid var(--vien); background: var(--mat); color: var(--chu); }
  .tr-nut {
    font: inherit; font-weight: 600; min-height: 2.4rem; padding: .4rem 1.1rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--nhan); background: transparent; color: var(--nhan);
  }
  .tr-nut { transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s, transform .1s, opacity .15s; touch-action: manipulation; }
  .tr-nut:hover:not(:disabled) { background: var(--nhan-nhe); box-shadow: 0 2px 8px rgba(0, 0, 0, .18); }
  .tr-nut:active:not(:disabled) { transform: scale(.96); }
  .tr-nut:focus-visible { outline: 2px solid var(--nhan); outline-offset: 2px; }
  /* Đang gửi yêu cầu: nút mờ đi, con trỏ chờ, không bấm thêm được */
  .tr-nut[aria-busy="true"] { opacity: .6; cursor: progress; }
  .tr-nut-chinh { background: var(--nhan); color: #fff; }
  .tr-nut-chinh:hover:not(:disabled) { background: var(--nhan); filter: brightness(1.1); }
  .tr-nut-phu { background: transparent; color: var(--phu); border-color: var(--vien); }
  .tr-nut-phu:hover:not(:disabled) { border-color: var(--nhan); color: var(--nhan); }
  .tr-nut:disabled { opacity: .45; cursor: default; }
  .tr-trang-thai { min-height: 1.5em; font-weight: 600; border-radius: .4rem; }
  /* Thông báo mới nháy nền một lần để người chơi nhận ra kết quả của nút vừa bấm */
  @media (prefers-reduced-motion: no-preference) {
    .tr-trang-thai.moi { animation: tr-nhay 1.2s ease-out; }
  }
  @keyframes tr-nhay { from { background: var(--nhan-nhe); box-shadow: 0 0 0 6px var(--nhan-nhe); } to { background: transparent; box-shadow: 0 0 0 6px transparent; } }
  .tr-ban { width: 100%; max-width: 460px; margin: .5rem 0 1rem; }
  .tr-ban svg { width: 100%; height: auto; display: block; user-select: none; overflow: visible; }
  .tr-ban .o { cursor: pointer; }
  .tr-ban .khoa .o { cursor: default; }
</style>

<script>
  import { khoiTao, nuocHopLe, kyHieu, timNuoc, apDung, biChieu, diemCongVan } from "../lib/co-tuong.js";
  import { duyetNuoc, benDenLuot, ketQuaChoBen, GIAY_MOI_NUOC } from "../lib/co-tuong-tran.js";
  import { taoAmThanh } from "../lib/co-tuong-am.js";
  import { docToken, headerXacThuc, batDauDangNhap } from "../lib/co-tuong-tai-khoan.js";

  const T = JSON.parse(document.getElementById("tran-chu")?.textContent || "{}");
  const f = (mau: string, v: Record<string, string | number> = {}) => mau.replace(/\{(\w+)\}/g, (_, k) => (k in v ? String(v[k]) : `{${k}}`));
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const ma = new URLSearchParams(location.search).get("ma") || "";

  // Mã khách: tạo một lần, lưu trong trình duyệt. Dùng để nhận diện người không có tài khoản.
  function layKhachId(): string {
    try {
      let id = localStorage.getItem("choico-khach") || "";
      if (!/^[A-Za-z0-9-]{16,64}$/.test(id)) {
        id = crypto.randomUUID();
        localStorage.setItem("choico-khach", id);
      }
      return id;
    } catch {
      return crypto.randomUUID(); // trình duyệt chặn localStorage: mã chỉ dùng trong lần mở này
    }
  }
  const KHACH = layKhachId();
  const yeuCau = (): Record<string, string> => ({ "content-type": "application/json", "x-khach-id": KHACH, ...headerXacThuc() });

  const KC = 50;
  const LE = 30;
  const RONG = LE * 2 + 8 * KC;
  const CAO = LE * 2 + 9 * KC;
  const TEN = { K: "帥", A: "仕", E: "相", H: "傌", R: "俥", C: "炮", P: "兵" };
  const TEN_DEN = { K: "將", A: "士", E: "象", H: "馬", R: "車", C: "砲", P: "卒" };

  let tran: any = null; // trạng thái trận từ server
  let ban: (string | null)[][] | null = null; // bàn đang hiển thị, dựng từ nước đi rồi cập nhật tức thì khi đi
  let chon: [number, number] | null = null; // ô đang chọn
  let gioDi: any[] = []; // nước hợp lệ từ ô đang chọn
  let dangGui = false; // đang gửi một nước lên server
  let pollId: number | undefined; // hẹn giờ đọc lại trạng thái
  let gioTimer: number | undefined; // hẹn giờ cập nhật đếm ngược
  let lechGio = 0; // giờ server trừ giờ máy, để đếm ngược đúng dù đồng hồ máy lệch
  let giuTrangThaiDen = 0; // trước thời điểm này (ms) thì không ghi đè dòng thông báo (ví dụ báo lỗi nước đi)
  let daBaoKetThuc = false; // đã phát tiếng kết thúc cho trận này chưa (không phát khi vừa mở một trận đã xong)

  // Hiệu ứng nước vừa đi, giống chơi với máy: quân trượt, quân bị ăn mờ dần, vòng sáng, chiếu tướng.
  // batDau: thời điểm đi, để vẽ lại giữa chừng (veBan() được gọi nhiều lần) vẫn chạy tiếp đúng tiến độ.
  let hieuUng: { batDau: number; quanBiAn: string | null; chieu: boolean; tu: [number, number]; den: [number, number] } | null = null;
  const THOI_GIAN_DI = 200; // ms quân trượt từ ô cũ sang ô mới
  const THOI_GIAN_AN = 360; // ms quân bị ăn mờ dần và vòng sáng lan ra
  const THOI_GIAN_CHIEU = 800; // ms vòng sáng và nhãn "Chiếu tướng!"
  const tongHieuUng = () => THOI_GIAN_DI + Math.max(THOI_GIAN_AN, hieuUng?.chieu ? THOI_GIAN_CHIEU : 0);
  const giamChuyenDong = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Âm thanh theo lựa chọn đã lưu ở trang chơi với máy (mặc định tắt)
  const am = taoAmThanh();
  try {
    am.datBat(localStorage.getItem("co-tuong-tieng") === "1", false);
  } catch {
    // Trình duyệt chặn localStorage: giữ mặc định tắt
  }
  function phatTiengNuoc(anQuan: boolean, chieu: boolean) {
    am.phat(anQuan ? "an" : "di", THOI_GIAN_DI);
    if (chieu) am.phat("chieu", THOI_GIAN_DI);
  }

  const trangThai = $("tr-trang-thai");
  const banEl = $("tr-ban");
  const doiEl = $("tr-doi");
  const batTrangThai = (text: string) => {
    if (trangThai.textContent === text) return;
    trangThai.textContent = text;
    trangThai.classList.remove("moi");
    void trangThai.offsetWidth; // khởi động lại hiệu ứng nháy
    trangThai.classList.add("moi");
  };
  // Chạy một việc khi bấm nút: nút mờ đi, đổi chữ và khóa trong lúc chờ. viec trả về true nếu trang sắp chuyển đi (giữ nguyên trạng thái chờ).
  async function chay(nut: HTMLButtonElement, nhanDang: string, viec: () => Promise<boolean | void>) {
    if (nut.getAttribute("aria-busy") === "true") return;
    const nhanCu = nut.textContent;
    nut.setAttribute("aria-busy", "true");
    nut.disabled = true;
    nut.textContent = nhanDang;
    let giu = false;
    try {
      giu = Boolean(await viec());
    } finally {
      if (!giu) {
        nut.removeAttribute("aria-busy");
        nut.disabled = false;
        nut.textContent = nhanCu;
      }
    }
  }
  const baoLoi = (text: string) => {
    batTrangThai(text);
    giuTrangThaiDen = Date.now() + 3000;
  };
  const doiBen = (s: string) => (s === "r" ? "b" : "r");

  async function goi(url: string, init?: RequestInit) {
    const r = await fetch(url, init);
    const data = await r.json().catch(() => ({}));
    return { ok: r.ok, status: r.status, data };
  }

  // Nhận trạng thái mới từ server: ghi nhớ độ lệch giờ để đếm ngược đúng
  function nhanTran(data: any) {
    tran = data;
    if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
  }

  // Dựng bàn từ danh sách nước đi của server
  function dungBan() {
    if (!tran?.nuoc) return;
    const d = duyetNuoc(tran.nuoc);
    ban = d.hop_le ? d.b : khoiTao();
  }

  // Khi mình cầm quân đen thì xoay bàn 180 độ để quân đen nằm phía dưới
  const xoay = () => tran?.ban_cua === "b";
  const toaX = (c: number) => LE + (xoay() ? 8 - c : c) * KC;
  const toaY = (r: number) => LE + (xoay() ? 9 - r : r) * KC;

  const NS = "http://www.w3.org/2000/svg";
  function svgEl(tag: string, attrs: Record<string, string | number>, cha?: Element) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    cha?.appendChild(e);
    return e;
  }

  // Vẽ một quân trong nhóm .quan để có thể làm hoạt ảnh riêng
  function vePhanQuan(cha: Element, p: string, x: number, y: number) {
    const mau = p[0] === "r" ? "#b3261e" : "#1f1f1f";
    const q = svgEl("g", { class: "quan", "pointer-events": "none" }, cha);
    svgEl("circle", { cx: x, cy: y, r: 20, fill: "#fbf6e6", stroke: mau, "stroke-width": 2 }, q);
    svgEl("text", { x, y: y + 8, "text-anchor": "middle", "font-size": 24, "font-weight": "bold", fill: mau }, q).textContent =
      p[0] === "r" ? TEN[p[1]] : TEN_DEN[p[1]];
    return q;
  }

  function veBan() {
    banEl.replaceChildren();
    if (!ban) return;
    banEl.classList.toggle("khoa", !(tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua));
    const s = svgEl("svg", { viewBox: `0 0 ${RONG} ${CAO}`, role: "img" });
    svgEl("rect", { x: 0, y: 0, width: RONG, height: CAO, rx: 10, fill: "#f1dca8" }, s);
    const net = { stroke: "#7a4b1e", "stroke-width": 1.5, fill: "none" };
    for (let r = 0; r < 10; r++) svgEl("line", { ...net, x1: toaX(0), y1: toaY(r), x2: toaX(8), y2: toaY(r) }, s);
    for (let c = 0; c < 9; c++) {
      if (c === 0 || c === 8) svgEl("line", { ...net, x1: toaX(c), y1: toaY(0), x2: toaX(c), y2: toaY(9) }, s);
      else {
        svgEl("line", { ...net, x1: toaX(c), y1: toaY(0), x2: toaX(c), y2: toaY(4) }, s);
        svgEl("line", { ...net, x1: toaX(c), y1: toaY(5), x2: toaX(c), y2: toaY(9) }, s);
      }
    }
    // Hai đường chéo trong mỗi cung tướng
    for (const r0 of [0, 7]) {
      svgEl("line", { ...net, x1: toaX(3), y1: toaY(r0), x2: toaX(5), y2: toaY(r0 + 2) }, s);
      svgEl("line", { ...net, x1: toaX(5), y1: toaY(r0), x2: toaX(3), y2: toaY(r0 + 2) }, s);
    }
    const nuocCuoi: string | null = tran.nuoc?.length ? tran.nuoc[tran.nuoc.length - 1] : null;
    const oDi = nuocCuoi ? nuocCuoi.slice(0, 2) : "";
    const oDen = nuocCuoi ? nuocCuoi.slice(2, 4) : "";
    const dangBiChieu = { r: biChieu(ban, "r"), b: biChieu(ban, "b") };
    for (let r = 0; r < 10; r++) {
      for (let c = 0; c < 9; c++) {
        const g = svgEl("g", { class: "o", "data-r": r, "data-c": c }, s);
        const x = toaX(c);
        const y = toaY(r);
        const ten = `${String.fromCharCode(97 + c)}${r}`;
        // Ô quân vừa rời: vòng nét đứt. Ô quân vừa đến: vòng liền đậm hơn.
        if (ten === oDi) svgEl("circle", { cx: x, cy: y, r: 22, fill: "rgba(224,161,0,.22)", stroke: "#e0a100", "stroke-width": 2, "stroke-dasharray": "4 3" }, g);
        if (ten === oDen) svgEl("circle", { cx: x, cy: y, r: 24, fill: "rgba(224,161,0,.35)", stroke: "#e0a100", "stroke-width": 3.5 }, g);
        if (chon && chon[0] === r && chon[1] === c) svgEl("circle", { cx: x, cy: y, r: 22, fill: "none", stroke: "#1e88e5", "stroke-width": 3 }, g);
        if (gioDi.some((m) => m.den[0] === r && m.den[1] === c)) svgEl("circle", { cx: x, cy: y, r: 7, fill: "rgba(30,136,229,.65)" }, g);
        const p = ban[r][c];
        // Tướng đang bị chiếu: vòng đỏ đậm quanh quân
        if (p && p[1] === "K" && dangBiChieu[p[0]]) svgEl("circle", { cx: x, cy: y, r: 25, fill: "rgba(229,57,53,.28)", stroke: "#e53935", "stroke-width": 3.5 }, g);
        if (p) vePhanQuan(g, p, x, y);
        // Vùng bấm trong suốt phủ lên trên để nhận nhấp chuột
        svgEl("circle", { cx: x, cy: y, r: KC / 2 - 2, fill: "transparent" }, g);
      }
    }
    banEl.appendChild(s);
    chayHieuUng(s as unknown as SVGSVGElement);
  }

  // Hiệu ứng nước vừa đi (cùng kiểu với chơi với máy). veBan() dựng lại cả bàn nên hiệu ứng được bắt đầu lại ở đúng tiến độ.
  function chayHieuUng(s: SVGSVGElement) {
    if (!hieuUng || giamChuyenDong || !s.animate) return;
    const troi = Date.now() - hieuUng.batDau;
    if (troi >= tongHieuUng()) {
      hieuUng = null;
      return;
    }
    const { tu, den } = hieuUng;
    const x = toaX(den[1]);
    const y = toaY(den[0]);
    const GIUA = "transform-box: fill-box; transform-origin: center;";

    // Quân bị ăn nằm yên ở ô đến cho đến khi quân đi tới, rồi mờ dần
    if (hieuUng.quanBiAn) {
      const ma_ = svgEl("g", { style: GIUA, "pointer-events": "none" }, s);
      vePhanQuan(ma_, hieuUng.quanBiAn, x, y);
      ma_.animate(
        [
          { opacity: 1, transform: "scale(1)", offset: 0 },
          { opacity: 1, transform: "scale(1)", offset: THOI_GIAN_DI / (THOI_GIAN_DI + THOI_GIAN_AN) },
          { opacity: 0, transform: "scale(1.5)", offset: 1 },
        ],
        { duration: THOI_GIAN_DI + THOI_GIAN_AN, delay: -troi, fill: "forwards" },
      );
    }

    // Vòng sáng lan ra khi quân đến nơi: đỏ nếu ăn quân, vàng nếu chỉ đi
    const vong = svgEl("circle", {
      cx: x, cy: y, r: 22, fill: "none", stroke: hieuUng.quanBiAn ? "#e53935" : "#e0a100", "stroke-width": 4,
      opacity: 0, style: GIUA, "pointer-events": "none",
    }, s);
    vong.animate(
      [{ opacity: 0.95, transform: "scale(1)" }, { opacity: 0, transform: "scale(2)" }],
      { duration: THOI_GIAN_AN, delay: THOI_GIAN_DI - troi, easing: "ease-out", fill: "forwards" },
    );

    // Chiếu tướng: vòng đỏ lan ra quanh tướng bị chiếu và nhãn nổi lên
    if (hieuUng.chieu && ban) {
      const benBiChieu = doiBen(ban[den[0]][den[1]]![0]);
      let tuong: [number, number] | null = null;
      for (let r = 0; r < 10; r++) for (let c = 0; c < 9; c++) if (ban[r][c] === benBiChieu + "K") tuong = [r, c];
      if (tuong) {
        const kx = toaX(tuong[1]);
        const ky = toaY(tuong[0]);
        const vongChieu = svgEl("circle", {
          cx: kx, cy: ky, r: 24, fill: "none", stroke: "#e53935", "stroke-width": 4, opacity: 0, style: GIUA, "pointer-events": "none",
        }, s);
        vongChieu.animate(
          [{ opacity: 0.95, transform: "scale(1)" }, { opacity: 0, transform: "scale(2.4)" }],
          { duration: THOI_GIAN_CHIEU, delay: THOI_GIAN_DI - troi, easing: "ease-out", fill: "forwards" },
        );
        // Nhãn nằm phía trong bàn (xét theo hướng xoay hiện tại)
        const tuongOTren = ky < CAO / 2;
        const nhan = svgEl("text", {
          x: kx, y: tuongOTren ? ky + 46 : ky - 34, "text-anchor": "middle", "font-size": 20, "font-weight": 800,
          fill: "#e53935", stroke: "#fff", "stroke-width": 4, "paint-order": "stroke", opacity: 0, style: GIUA, "pointer-events": "none",
        }, s);
        nhan.textContent = T.chieu;
        nhan.animate(
          [
            { opacity: 0, transform: "translateY(8px) scale(.8)", offset: 0 },
            { opacity: 1, transform: "translateY(0) scale(1)", offset: 0.2 },
            { opacity: 1, transform: "translateY(0) scale(1)", offset: 0.75 },
            { opacity: 0, transform: "translateY(-6px) scale(1)", offset: 1 },
          ],
          { duration: THOI_GIAN_CHIEU, delay: THOI_GIAN_DI - troi, fill: "forwards" },
        );
      }
    }

    // Quân vừa đi trượt từ ô cũ, đưa lên lớp trên cùng để không bị quân khác che
    const quan = s.querySelector(`g.o[data-r="${den[0]}"][data-c="${den[1]}"] .quan`);
    if (quan && THOI_GIAN_DI > troi) {
      s.appendChild(quan);
      quan.animate(
        [
          { transform: `translate(${toaX(tu[1]) - x}px, ${toaY(tu[0]) - y}px)` },
          { transform: "translate(0px, 0px)" },
        ],
        { duration: THOI_GIAN_DI, delay: -troi, easing: "ease-out", fill: "backwards" },
      );
    }
  }

  // Áp một nước lên bàn đang hiển thị và bắt đầu hiệu ứng, tiếng
  function apMove(m: any, s: string) {
    if (!ban) return;
    apDung(ban, m);
    hieuUng = { batDau: Date.now(), quanBiAn: m.an || null, chieu: biChieu(ban, doiBen(s)), tu: m.tu, den: m.den };
    phatTiengNuoc(Boolean(m.an), hieuUng.chieu);
  }

  // Đi nước: hiện ngay trên màn hình rồi gửi server ngầm, không phải chờ mạng mới thấy quân di chuyển
  async function diNuoc(m: any) {
    const ky = kyHieu(m);
    const s = tran.ban_cua;
    apMove(m, s);
    tran.nuoc = [...tran.nuoc, ky];
    tran.den_luot = doiBen(s);
    tran.han_nuoc = new Date(Date.now() + lechGio + GIAY_MOI_NUOC * 1000).toISOString();
    const kt = duyetNuoc(tran.nuoc);
    if (kt.hop_le && kt.ket_thuc) {
      tran.trang_thai = "ket_thuc";
      tran.ket_qua = kt.ket_qua;
      tran.ly_do = kt.ly_do;
    }
    chon = null;
    gioDi = [];
    hienKhoi();
    dangGui = true;
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "nuoc", ma, ky }),
    });
    dangGui = false;
    if (ok) {
      // Khớp với màn hình thì chỉ cập nhật giờ; lệch thì dựng lại theo server
      if (data.nuoc?.length === tran.nuoc.length && data.trang_thai === tran.trang_thai) {
        tran.han_nuoc = data.han_nuoc;
        if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      } else {
        nhanTran(data);
        dungBan();
        hienKhoi();
      }
      return;
    }
    // Server từ chối (sai luật, hết giờ, đối thủ đã đầu hàng...): bỏ hiệu ứng, tải trạng thái thật và báo
    hieuUng = null;
    await taiTran();
    if (tran.trang_thai === "dang_dau") baoLoi(T.trNuocSai); // trận đã đóng thì thông báo đóng trận đã hiện rồi
  }

  // Nhấp vào bàn: chọn quân của mình, rồi nhấp vào ô đích để đi
  banEl.addEventListener("click", (e) => {
    am.mo(); // mở ngữ cảnh âm thanh ngay trong lúc người dùng bấm (iPhone chỉ cho phép như vậy)
    const o = (e.target as Element).closest(".o");
    if (!o || !ban || dangGui || tran?.trang_thai !== "dang_dau" || tran.den_luot !== tran.ban_cua) return;
    const r = Number(o.getAttribute("data-r"));
    const c = Number(o.getAttribute("data-c"));
    const benMinh = tran.ban_cua;
    const quan = ban[r][c];

    if (chon) {
      const m = gioDi.find((x) => x.den[0] === r && x.den[1] === c);
      if (m) return void diNuoc(m);
    }
    if (quan && quan[0] === benMinh) {
      chon = [r, c];
      gioDi = nuocHopLe(ban, benMinh).filter((m) => m.tu[0] === r && m.tu[1] === c);
    } else {
      chon = null;
      gioDi = [];
    }
    veBan();
  });

  // Đọc trạng thái trận, dựng lại bàn và hiện đúng khối việc
  async function taiTran() {
    if (!ma) return hienKhoiTao();
    const { ok, status, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok) {
      batTrangThai(status === 404 ? T.trTranKhongTim : (T.loiMang || ""));
      return;
    }
    nhanTran(data);
    daBaoKetThuc = data.trang_thai === "ket_thuc"; // mở một trận đã xong thì không phát tiếng kết thúc
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  function hienKhoiTao() {
    $("tr-tao").hidden = false;
    const coToken = !!docToken();
    ($("tr-nut-tao") as HTMLButtonElement).hidden = !coToken;
    $("tr-can-dang-nhap").hidden = coToken;
    batTrangThai("");
  }

  // Dòng "Đối thủ: X · Còn N giây" và dòng trạng thái, cập nhật mỗi giây khi trận đang đi.
  // Hết giờ thì không xử thua: bên đang chờ thấy ba lựa chọn, bên chậm thấy đang chờ đối thủ quyết định.
  function capNhatGio() {
    if (tran?.trang_thai !== "dang_dau") return;
    const toi = tran.den_luot === tran.ban_cua;
    const ten = tran.ban_cua === "r" ? tran.ten_den : tran.ten_do;
    let hetGio = false;
    let gio: string;
    if (!tran.han_nuoc) {
      gio = T.trKhongGioiHan;
    } else {
      const giay = Math.ceil((Date.parse(tran.han_nuoc) - (Date.now() + lechGio)) / 1000);
      hetGio = giay <= 0;
      gio = hetGio ? T.trHetGioNgan : f(T.trGioCon, { s: giay });
    }
    doiEl.textContent = [ten ? f(T.trDoi, { ten }) : "", gio].filter(Boolean).join(" · ");
    $("tr-het-gio").hidden = !(hetGio && !toi);
    if (Date.now() >= giuTrangThaiDen) {
      const minhDo = tran.ban_cua === "r";
      batTrangThai(hetGio ? (toi ? T.trHetGioChoQuyet : T.trHetGioBanQuyet) : `${toi ? T.trToiLuot : T.trDoiLuot} · ${minhDo ? T.trBanDo : T.trBanDen}`);
    }
  }

  // Trận thượng đài cũng chạy ở trang này nên menu phải sáng mục Thượng đài thay vì Khép kín
  function danhDauMenu() {
    document.querySelector('nav a[href$="/tran/"]')?.removeAttribute("aria-current");
    document.querySelector('nav a[href$="/thuong-dai/"]')?.setAttribute("aria-current", "page");
  }

  // Sau khi trận xong: đường đi tiếp (về sảnh thượng đài, hoặc tạo trận khép kín mới)
  function hienBuocTiep() {
    const tienTo = document.documentElement.dataset.tienTo || "";
    const a = $("tr-tiep-a") as HTMLAnchorElement;
    a.href = tran.loai === "dai" ? `${tienTo}/thuong-dai/` : `${tienTo}/tran/`;
    a.textContent = tran.loai === "dai" ? T.trVeSanh : T.trTranMoi;
    $("tr-tiep").hidden = false;
  }

  function hienKhoi() {
    $("tr-tao").hidden = true;
    $("tr-link").hidden = true;
    $("tr-roi-dai").hidden = true;
    $("tr-vao").hidden = true;
    $("tr-dieu-khien").hidden = true;
    $("tr-tiep").hidden = true;
    $("tr-het-gio").hidden = true;
    if (tran?.loai === "dai") danhDauMenu();
    doiEl.textContent = "";
    clearInterval(gioTimer);

    // Người ngoài: link còn chờ thì hiện nút vào chơi
    if (!tran.ban_cua) {
      if (tran.loai === "dai") return batTrangThai(T.trVaoTuSanh); // trận thượng đài chỉ vào từ sảnh, không qua link
      if (tran.trang_thai === "cho") {
        $("tr-vao").hidden = false;
        $("tr-moi-vao").textContent = f(T.trMoiVao, { ten: tran.ten_do || "" });
        ($("tr-ten-vao").parentElement as HTMLElement).hidden = !!docToken();
        return batTrangThai("");
      }
      return batTrangThai(tran.trang_thai === "huy" ? T.trHetHan : T.trDaCoNguoi);
    }

    // Người tạo đang chờ người vào: hiện link để gửi (và tự cập nhật khi có người vào)
    if (tran.trang_thai === "cho" && tran.loai === "dai") {
      $("tr-roi-dai").hidden = false;
      batTrangThai(T.trChoDoiThu);
      return datPoll();
    }
    if (tran.trang_thai === "cho") {
      $("tr-link").hidden = false;
      ($("tr-link-o") as HTMLInputElement).value = `${location.origin}${location.pathname}?ma=${ma}`;
      batTrangThai(T.trChoBan);
      return datPoll();
    }

    // Trận đã đóng: link bị người tạo vô hiệu hóa, hoặc bị bỏ dở quá lâu
    if (tran.trang_thai === "huy") {
      if (tran.nuoc?.length) veBan();
      hienBuocTiep();
      return batTrangThai(tran.ly_do === "bo_do" ? T.trTranDong : T.trDaVoHieu);
    }

    // Trận đang đi hoặc đã xong
    veBan();
    const minhDo = tran.ban_cua === "r";
    if (tran.trang_thai === "dang_dau") {
      $("tr-dieu-khien").hidden = false;
      giuTrangThaiDen = 0;
      capNhatGio();
      gioTimer = window.setInterval(capNhatGio, 1000);
      return datPoll();
    }
    // Đã kết thúc
    const ten = minhDo ? tran.ten_den : tran.ten_do;
    doiEl.textContent = ten ? f(T.trDoi, { ten }) : "";
    const kq = tran.ket_qua === "do" ? T.trKetDo : tran.ket_qua === "den" ? T.trKetDen : T.trKetHoa;
    const ly = tran.ly_do === "het_gio" ? T.trLyHetGio : tran.ly_do === "dau_hang" ? T.trLyDauHang : tran.ly_do === "bo_do" ? T.trLyBoDo : T.trLyHetNuoc;
    let diem = T.trKhongTinh;
    if (tran.loai === "dai") {
      const d = diemCongVan(ketQuaChoBen(tran.ket_qua, tran.ban_cua), 0);
      diem = f(T.trDiemTran, { diem: `${d > 0 ? "+" : ""}${d}` });
    }
    batTrangThai(`${kq}${tran.ly_do ? ` (${ly})` : ""}. ${diem}`);
    hienBuocTiep();
    if (!daBaoKetThuc) {
      daBaoKetThuc = true;
      const thang = (tran.ket_qua === "do" && minhDo) || (tran.ket_qua === "den" && !minhDo);
      am.phat(tran.ket_qua === "hoa" ? "hoa" : thang ? "thang" : "thua", THOI_GIAN_DI + 500); // sau tiếng đi quân và hiệu ứng
    }
    datPoll();
  }

  // Đối thủ vừa đi thì bàn cập nhật và chạy hiệu ứng như nước đi của máy
  async function docMoi() {
    const cu: number = tran?.nuoc?.length ?? 0;
    const trangThaiCu = tran?.trang_thai;
    const { ok, data } = await goi(`/api/co-tuong-tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok || dangGui) return; // người chơi vừa đi trong lúc chờ: bỏ kết quả cũ này
    const moi: number = data.nuoc?.length ?? 0;
    if (moi === cu && data.trang_thai === trangThaiCu) {
      if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      if (data.han_nuoc !== tran.han_nuoc) {
        tran.han_nuoc = data.han_nuoc; // đối thủ vừa cho thêm giờ hoặc cho nghĩ thoải mái
        capNhatGio();
      }
      return;
    }
    // Đúng một nước mới của đối thủ: đi nước đó trên bàn đang có để quân trượt, có tiếng, có hiệu ứng
    if (trangThaiCu === "dang_dau" && moi === cu + 1 && ban) {
      const s = benDenLuot(cu);
      const m = timNuoc(ban, s, data.nuoc[moi - 1]);
      if (m) {
        apMove(m, s);
        nhanTran(data);
        chon = null;
        gioDi = [];
        return hienKhoi();
      }
    }
    nhanTran(data);
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  // Hẹn lần đọc lại tiếp theo: nhanh khi đang chờ đối thủ đi, chậm hơn khi đến lượt mình hoặc tab ẩn
  function datPoll() {
    clearTimeout(pollId);
    pollId = undefined;
    const caoNhat = tran?.ban_cua && (tran.trang_thai === "dang_dau" || tran.trang_thai === "cho");
    if (!caoNhat) return;
    const luotMinh = tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua;
    const doTre = document.hidden ? 5000 : tran.trang_thai === "cho" || luotMinh ? 2500 : 1000;
    pollId = window.setTimeout(async () => {
      pollId = undefined;
      await docMoi();
      datPoll();
    }, doTre);
  }

  const nut = (id: string) => $(id) as HTMLButtonElement;

  // Tạo link: cần đăng nhập, xong thì chuyển sang trang có mã
  nut("tr-nut-tao").addEventListener("click", () => void chay(nut("tr-nut-tao"), T.trDangTao, async () => {
    const { ok, status, data } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "tao" }),
    });
    if (ok && data.ma) {
      location.href = `${location.pathname}?ma=${data.ma}`;
      return true;
    }
    batTrangThai(status === 401 ? T.trCanDangNhap : T.tdLoi);
  }));

  nut("tr-nut-chep").addEventListener("click", async () => {
    const o = $("tr-link-o") as HTMLInputElement;
    try {
      await navigator.clipboard.writeText(o.value);
      $("tr-nut-chep").textContent = T.trDaChep;
      setTimeout(() => ($("tr-nut-chep").textContent = T.trChepLink), 2000);
    } catch {
      o.select();
    }
  });

  // Vô hiệu hóa link: xong thì khối link biến mất và thông báo nháy lên
  nut("tr-nut-vo-hieu").addEventListener("click", () => void chay(nut("tr-nut-vo-hieu"), T.trDangXuLy, async () => {
    const { ok } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "huy", ma }),
    });
    if (!ok) return void batTrangThai(T.tdLoi);
    await taiTran(); // trạng thái "huy": hiện thông báo link đã vô hiệu hóa
    batTrangThai(T.trDaVoHieu);
  }));

  nut("tr-nut-vao").addEventListener("click", () => void chay(nut("tr-nut-vao"), T.trDangXuLy, async () => {
    const tenKhach = ($("tr-ten-vao") as HTMLInputElement).value.trim();
    const { ok, data } = await goi("/api/co-tuong-khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "vao", ma, ten_khach: tenKhach }),
    });
    if (ok) return void (await taiTran());
    batTrangThai(data.loi === "da_co_nguoi_vao" ? T.trDaCoNguoi : data.loi === "link_het_han" ? T.trHetHan : T.tdLoi);
  }));

  nut("tr-nut-dau-hang").addEventListener("click", () => void chay(nut("tr-nut-dau-hang"), T.trDangXuLy, async () => {
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "dau_hang", ma }),
    });
    if (!ok) return void (await taiTran());
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }));

  // Đối thủ hết giờ: chọn cho nghĩ thêm 1 phút, nghĩ thoải mái hoặc xử thua
  async function xuHetGio(luaChon: string) {
    const { ok, data } = await goi("/api/co-tuong-tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "xu_het_gio", ma, lua_chon: luaChon }),
    });
    if (!ok) return void (await taiTran()); // trạng thái đã đổi (đối thủ vừa đi): tải lại cho đúng
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }
  nut("tr-nut-them").addEventListener("click", () => void chay(nut("tr-nut-them"), T.trDangXuLy, () => xuHetGio("them_1_phut")));
  nut("tr-nut-thoai").addEventListener("click", () => void chay(nut("tr-nut-thoai"), T.trDangXuLy, () => xuHetGio("thoai_mai")));
  nut("tr-nut-xu").addEventListener("click", () => void chay(nut("tr-nut-xu"), T.trDangXuLy, () => xuHetGio("xu_thua")));

  // Rời đài khi chưa có ai thách đấu, rồi về sảnh
  nut("tr-nut-roi-dai").addEventListener("click", () => void chay(nut("tr-nut-roi-dai"), T.trDangXuLy, async () => {
    await goi("/api/co-tuong-dai", { method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "roi_dai", ma }) });
    location.href = `${document.documentElement.dataset.tienTo || ""}/thuong-dai/`;
    return true;
  }));

  // Nút đăng nhập ngay trong thông báo cần đăng nhập
  $("tr-can-dang-nhap").addEventListener("click", () => void batDauDangNhap());

  void taiTran();
</script>
</Layout>

---
// Trang trận giữa hai người, dùng chung cho mọi loại cờ: tạo link mời hoặc vào chơi qua link (khép kín, không cần đăng nhập,
// không tính điểm), và chơi trận thượng đài. troChoi: loại cờ khi tạo link mới; trận mở qua ?ma= theo loại cờ của trận đó.
import Layout from "../layouts/Layout.astro";
import NutBan from "../components/NutBan.astro";
import KhungBan from "../components/KhungBan.astro";
import ThanhXemLai from "../components/ThanhXemLai.astro";
import { t, chuCaTrang, chuRieng } from "../i18n/strings.js";
import { MA_TRO_CHOI } from "../lib/tro-choi.js";
import "../styles/ban-co.css";
import "../styles/nut.css";

const { lang = "vi", troChoi = "co_tuong" } = Astro.props;
const T = chuCaTrang(lang, troChoi);
const chuGui = { chung: chuCaTrang(lang), rieng: Object.fromEntries(MA_TRO_CHOI.map((m) => [m, chuRieng(lang, m)])) };
---
<Layout lang={lang} tieuDe={t(lang, "trTieuDe", {}, troChoi)} moTa={t(lang, "trMoTaChung", {}, troChoi)} khongLapChiMuc troChoi={troChoi}>
  <script is:inline type="application/json" id="tran-chu" data-tro-choi={troChoi} set:html={JSON.stringify(chuGui)}></script>
  <h1 id="tr-h1">{T.trTieuDe} · {T.tenCo}</h1>
  <p id="tr-mo-ta" class="phu">{T.trMoTa}</p>

  <section id="tr-tao" class="tr-khoi" hidden>
    <!-- Khách (chưa đăng nhập) tự nhập tên; người đã đăng nhập dùng tên tài khoản nên ô này ẩn -->
    <label id="tr-ten-tao-hang" class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-tao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <button type="button" id="tr-nut-tao" class="nut nut-chinh">{T.trTaoLink}</button>
  </section>

  <section id="tr-link" class="tr-khoi" hidden>
    <p class="phu">{T.trLinkCuaBan}</p>
    <div class="tr-hang">
      <input id="tr-link-o" type="text" readonly />
      <button type="button" id="tr-nut-chep" class="nut">{T.trChepLink}</button>
    </div>
    <button type="button" id="tr-nut-vo-hieu" class="nut nut-phu">{T.trVoHieu}</button>
  </section>

  <section id="tr-roi-dai" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-roi-dai" class="nut nut-phu">{T.tdRoiDai}</button>
  </section>

  <section id="tr-vao" class="tr-khoi tr-moi" hidden>
    <h2 id="tr-moi-vao" class="tr-moi-tieu-de"></h2>
    <p id="tr-moi-gioi-thieu">{T.trMoiGioiThieu}</p>
    <label class="tr-hang">
      <span>{T.trTenVao}</span>
      <input id="tr-ten-vao" type="text" maxlength="50" autocomplete="nickname" />
    </label>
    <p class="tr-luu-y">{T.trMoiLuuY}</p>
    <button type="button" id="tr-nut-vao" class="nut nut-chinh">{T.trVao}</button>
  </section>

  <p id="tr-trang-thai" class="tr-trang-thai" role="status" aria-live="polite"></p>
  <!-- Ba nút khi đối thủ hết giờ, ngay dưới dòng thông báo để dễ thấy. Chỉ hiện khi đến lượt đối thủ mà họ đã hết giờ -->
  <div id="tr-het-gio" class="tr-het-gio" hidden>
    <button type="button" id="tr-nut-them" class="nut nut-chinh">{T.trThem1Phut}</button>
    <button type="button" id="tr-nut-thoai" class="nut">{T.trThoaiMai}</button>
    <button type="button" id="tr-nut-xu" class="nut nut-phu">{T.trXuThua}</button>
  </div>
  <p id="tr-doi" class="phu"></p>
  <!-- Hàng nút loa và phóng to nằm ngoài khung bàn, căn phải, giống chơi với máy -->
  <div id="tr-thanh-nut" class="tr-thanh-nut" hidden>
    <NutBan T={T} />
  </div>
  <ThanhXemLai T={T} />
  <KhungBan T={T} hidden />
  <!-- Trận đã xong: xem lại cả trận ngay trên bàn, hoặc chép link để người khác xem (/xem-van/?tran=...) -->
  <div id="tr-xem" class="tr-xem" hidden>
    <button type="button" id="tr-nut-xem" class="nut">{T.xemLai}</button>
    <button type="button" id="tr-nut-chep-xem" class="nut nut-phu nut-nho">{T.chepLink}</button>
  </div>
  <p id="tr-tiep" class="tr-khoi" hidden><a id="tr-tiep-a" href="#"></a></p>
  <div id="tr-dieu-khien" class="tr-khoi" hidden>
    <button type="button" id="tr-nut-dau-hang" class="nut nut-phu">{T.trDauHang}</button>
  </div>

<style is:global>
  /* Global vì quân trong khay và bàn được tạo bằng JS, không có mã scope của Astro */
  .tr-khoi { margin: 1rem 0; display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .tr-khoi[hidden] { display: none; }
  .tr-hang { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; width: 100%; max-width: 460px; }
  .tr-hang input { flex: 1; min-width: 0; font: inherit; padding: .45rem .7rem; border-radius: .5rem; border: 1px solid var(--vien); background: var(--mat); color: var(--chu); }
  .tr-trang-thai { min-height: 1.5em; font-weight: 600; border-radius: .4rem; }
  /* Thông báo mới nháy nền một lần để người chơi nhận ra kết quả của nút vừa bấm */
  @media (prefers-reduced-motion: no-preference) {
    .tr-trang-thai.moi { animation: tr-nhay 1.2s ease-out; }
  }
  @keyframes tr-nhay { from { background: var(--nhan-nhe); box-shadow: 0 0 0 6px var(--nhan-nhe); } to { background: transparent; box-shadow: 0 0 0 6px transparent; } }
  /* Nút âm thanh và phóng to: kiểu giống trang chơi với máy */
  .tr-thanh-nut { display: flex; justify-content: flex-end; gap: .5rem; margin: 0 0 1rem; }
  .tr-thanh-nut[hidden] { display: none; }
  /* Khối nút khi đối thủ hết giờ: một thẻ nhạt màu nhấn, ba nút chia đều, xuống dòng khi màn hình hẹp */
  .tr-het-gio { width: 100%; max-width: 460px; margin: 0 0 .8rem; padding: .5rem; display: flex; flex-wrap: wrap; gap: .5rem; border: 1px solid var(--nhan); border-radius: .6rem; background: var(--nhan-nhe); }
  .tr-het-gio[hidden] { display: none; }
  /* Nút trong thẻ: chia đều hàng, chữ dài tự xuống dòng trong nút thay vì tràn ra ngoài */
  .tr-het-gio .nut { flex: 1 1 8rem; font-size: .9rem; padding: .4rem .8rem; background: var(--mat); }
  .tr-het-gio .nut-chinh { background: var(--nhan); }
  .tr-hang[hidden] { display: none; }
  .tr-xem { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; width: 100%; max-width: 460px; margin: .4rem auto 0; }
  .tr-xem[hidden] { display: none; }
  /* Thẻ lời mời cho người mở link: tiêu đề mời, giới thiệu, lưu ý link chỉ một người vào, rồi nút chấp nhận */
  .tr-moi { max-width: 32rem; }
  .tr-moi-tieu-de { font-size: 1.3rem; line-height: 1.3; margin: .2rem 0 .6rem; }
  .tr-luu-y { margin: .8rem 0 1rem; padding-left: .8rem; border-left: 3px solid var(--nhan); color: var(--phu); font-size: .93rem; }
</style>

<script>
  import { thoiGianNghi, diemCongVan } from "../lib/chung/diem.js";
  import { phatLai } from "../lib/chung/van.js";
  import { chonTrongDinh } from "../lib/chung/may.js";
  import { benDenLuot, ketQuaChoBen, GIAY_MOI_NUOC } from "../lib/chung/tran.js";
  import { layTroChoi } from "../lib/tro-choi.js";
  import { VE, MUC, taoMay, sangMenu, docChu, f } from "../lib/chung/trinh-duyet.js";
  import { taoAmThanh } from "../lib/chung/am.js";
  import { veBanCo, veHaiKhay, chayHieuUng, tongThoiGianHieuUng, phatTiengNuoc, gaiNutKhung, oBamDuoc, chonNuocPhong, THOI_GIAN } from "../lib/chung/ban.js";
  import { ngheTinHieu } from "../lib/chung/realtime.js";
  import { taoXemLai } from "../lib/chung/xem-lai.js";
  import { duocDung } from "../lib/chung/tinh-nang.js";
  import { docToken, headerXacThuc, damBaoCoTen } from "../lib/chung/tai-khoan.js";

  type O = [number, number];
  const elChu = document.getElementById("tran-chu") as HTMLElement;
  const chuGoc = docChu("tran-chu");
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const ma = new URLSearchParams(location.search).get("ma") || "";
  const tienTo = document.documentElement.dataset.tienTo || "";
  const TRO_CHOI_TRANG = elChu.dataset.troChoi; // loại cờ của trang: dùng khi tạo link mới

  // Loại cờ đang hiện: theo trang, đổi theo trận khi đã tải trận
  let tc: any;
  let luat: any;
  let ve: any;
  let T: Record<string, string> = {};
  let may: ReturnType<typeof taoMay> | null = null;
  function datTroChoi(maTc: string | undefined) {
    const moi = layTroChoi(maTc) ?? layTroChoi(undefined);
    if (tc && moi.ma === tc.ma) return;
    tc = moi;
    luat = tc.luat;
    ve = VE[tc.ma as keyof typeof VE];
    T = { ...chuGoc.chung, ...chuGoc.rieng[tc.ma] };
    may?.huy();
    may = taoMay(tc.ma);
    document.body.classList.toggle("co-vua", tc.ma === "co_vua");
    sangMenu(tc.ma);
    $("tr-moi-gioi-thieu").textContent = T.trMoiGioiThieu;
    $("co-ban").setAttribute("aria-label", T.banCo);
  }
  datTroChoi(TRO_CHOI_TRANG);

  // Mã khách: tạo một lần, lưu trong trình duyệt. Dùng để nhận diện người không có tài khoản.
  function layKhachId(): string {
    try {
      let id = localStorage.getItem("choico-khach") || "";
      if (!/^[A-Za-z0-9-]{16,64}$/.test(id)) {
        id = crypto.randomUUID();
        localStorage.setItem("choico-khach", id);
      }
      return id;
    } catch {
      return crypto.randomUUID(); // trình duyệt chặn localStorage: mã chỉ dùng trong lần mở này
    }
  }
  const KHACH = layKhachId();
  const yeuCau = (): Record<string, string> => ({ "content-type": "application/json", "x-khach-id": KHACH, ...headerXacThuc() });

  let tran: any = null; // trạng thái trận từ server
  let the: any = null; // thế cờ đang hiển thị, dựng từ nước đi rồi cập nhật tức thì khi đi
  let nuocCuoi: O[] | null = null; // ô rời và ô đến của nước gần nhất, đánh dấu vàng
  let anCuoi: string | null = null; // quân vừa bị ăn gần nhất (mã bên + loại, ví dụ "bR"), đánh dấu trong khay
  let chon: O | null = null; // ô đang chọn
  let gioDi: any[] = []; // nước hợp lệ từ ô đang chọn
  let dangGui = false; // đang gửi một nước lên server
  let dangChonPhong = false; // đang hiện ô chọn quân phong cấp
  let pollId: number | undefined; // hẹn giờ đọc lại trạng thái
  let gioTimer: number | undefined; // hẹn giờ cập nhật đếm ngược
  let lechGio = 0; // giờ server trừ giờ máy, để đếm ngược đúng dù đồng hồ máy lệch
  let giuTrangThaiDen = 0; // trước thời điểm này (ms) thì không ghi đè dòng thông báo (ví dụ báo lỗi nước đi)
  let daBaoKetThuc = false; // đã phát tiếng kết thúc cho trận này chưa (không phát khi vừa mở một trận đã xong)

  // Hiệu ứng nước vừa đi (xem chayHieuUng trong src/lib/chung/ban.js). batDau: thời điểm đi; tu, den: ô rời và ô đến.
  let hieuUng: { batDau: number; quanBiAn: string | null; oAn?: O; chieu: boolean; tu: O; den: O } | null = null;

  // Âm thanh theo lựa chọn đã lưu ở trang chơi với máy (mặc định tắt); nút phóng to bàn
  const am = taoAmThanh();
  const trangThai = $("tr-trang-thai");
  const banEl = $("co-ban");
  const doiEl = $("tr-doi");
  gaiNutKhung(am, banEl, T);

  const batTrangThai = (text: string) => {
    if (trangThai.textContent === text) return;
    trangThai.textContent = text;
    trangThai.classList.remove("moi");
    void trangThai.offsetWidth; // khởi động lại hiệu ứng nháy
    trangThai.classList.add("moi");
  };
  // Chạy một việc khi bấm nút: nút mờ đi, đổi chữ và khóa trong lúc chờ. viec trả về true nếu trang sắp chuyển đi (giữ nguyên trạng thái chờ).
  async function chay(nut: HTMLButtonElement, nhanDang: string, viec: () => Promise<boolean | void>) {
    if (nut.getAttribute("aria-busy") === "true") return;
    const nhanCu = nut.textContent;
    nut.setAttribute("aria-busy", "true");
    nut.disabled = true;
    nut.textContent = nhanDang;
    let giu = false;
    try {
      giu = Boolean(await viec());
    } finally {
      if (!giu) {
        nut.removeAttribute("aria-busy");
        nut.disabled = false;
        nut.textContent = nhanCu;
      }
    }
  }
  const baoLoi = (text: string) => {
    batTrangThai(text);
    giuTrangThaiDen = Date.now() + 3000;
  };
  const doiBen = (s: string) => (s === "r" ? "b" : "r");
  const nut = (id: string) => $(id) as HTMLButtonElement;

  async function goi(url: string, init?: RequestInit) {
    const r = await fetch(url, init);
    const data = await r.json().catch(() => ({}));
    return { ok: r.ok, status: r.status, data };
  }

  // Nhận trạng thái mới từ server: ghi nhớ độ lệch giờ để đếm ngược đúng, đổi bàn theo loại cờ của trận
  function nhanTran(data: any) {
    tran = data;
    if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
    datTroChoi(data.tro_choi);
  }

  // Dựng bàn từ danh sách nước đi của server (các nước đã được server kiểm luật nên chỉ đặt quân lên bàn)
  function dungBan() {
    if (!tran?.nuoc) return;
    const p = phatLai(luat, tran.nuoc, { kiemLuat: false });
    the = p.hop_le ? p.the : luat.khoiTao();
    nuocCuoi = p.hop_le ? p.nuocCuoi : null;
    anCuoi = p.hop_le ? p.anCuoi : null;
  }

  // Tên người cầm bên s (r hoặc b). Máy (luôn bên đi trước) thì tên theo ngôn ngữ đang chọn, vì tên lưu trên server là tiếng Việt.
  const tenBen = (s: string): string => (s === "r" && tran.may_muc ? f(T.tenMay, { c: tran.may_muc }) : (s === "r" ? tran.ten_do : tran.ten_den) || "");

  // Khi mình cầm bên đi sau thì xoay bàn 180 độ để quân của mình nằm phía dưới
  const xoay = () => tran?.ban_cua === "b";

  function veBan() {
    banEl.replaceChildren();
    // Chưa có bàn (chưa có trận, đang chờ đối thủ, chưa đăng nhập...) thì ẩn khay và hàng nút loa, phóng to
    $("co-khung").hidden = !the;
    $("tr-thanh-nut").hidden = !the;
    if (!the) return;
    veHaiKhay(luat.quanBiAn(the), xoay() ? "r" : "b", anCuoi, ve, T);
    const toa = ve.taoToa(xoay());
    const s = veBanCo(banEl, {
      ban: the.b,
      ve,
      toa,
      khoa: !(tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua),
      nuocCuoi,
      chon,
      dich: gioDi.map((m) => m.den),
      chieu: { r: luat.biChieu(the, "r"), b: luat.biChieu(the, "b") },
      nhanBan: T.banCo,
    });
    // Hiệu ứng nước vừa đi (quân trượt, ăn quân, chiếu) chạy tiếp trên bàn vừa vẽ
    const nuocDi = hieuUng ? [hieuUng.tu, hieuUng.den] : null;
    if (chayHieuUng(s, hieuUng, { banEl, ban: the.b, ve, toa, nuocCuoi: nuocDi, nhanChieu: T.chieu })) hieuUng = null;
  }

  // Xem lại trận đã xong (tính năng chung, src/lib/chung/xem-lai.js): thế đang xem thay thế cờ trên bàn; thoát thì dựng lại
  // thế cuối của trận từ server. Trận đã xong nên không còn đọc lại hay nghe chuông, bàn không bị vẽ đè trong lúc xem.
  const coXemLai = duocDung("xem_lai");
  const xemLai = taoXemLai({
    am,
    nhan: T,
    hienTrangThai: batTrangThai,
    khiVe: (p: any) => {
      the = p.the;
      nuocCuoi = p.nuocCuoi;
      anCuoi = p.anCuoi;
      hieuUng = p.hieuUng;
      chon = null;
      gioDi = [];
      veBan();
    },
    khiThoat: () => {
      hieuUng = null;
      dungBan();
      hienKhoi();
    },
    khiDoi: () => capNhatNutXem(),
  });
  // Trận đã xong và có nước đi thì xem lại được (trận bị đóng khi mới có vài nước cũng xem được)
  const xemDuoc = () => coXemLai && Boolean(tran?.nuoc?.length) && (tran.trang_thai === "ket_thuc" || tran.trang_thai === "huy");
  function capNhatNutXem() {
    $("tr-xem").hidden = !xemDuoc() || xemLai.dangXem();
  }
  nut("tr-nut-xem").addEventListener("click", () => {
    if (xemDuoc()) xemLai.batDau(luat, tran.nuoc);
  });
  nut("tr-nut-chep-xem").addEventListener("click", async () => {
    const url = `${location.origin}${tienTo}${tc.duong.xemVan}?tran=${ma}`;
    try {
      await navigator.clipboard.writeText(url);
      $("tr-nut-chep-xem").textContent = T.daChepLink;
      setTimeout(() => ($("tr-nut-chep-xem").textContent = T.chepLink), 2000);
    } catch {
      baoLoi(url); // trình duyệt chặn clipboard: hiện link để người dùng tự chép
    }
  });

  // Đi nước m (đã hợp lệ) trên bàn đang hiện: hiệu ứng và tiếng như nước đi của máy
  function apMove(m: any) {
    if (!the) return;
    luat.apDung(the, m);
    nuocCuoi = [m.tu, m.den];
    if (m.an) anCuoi = m.an;
    hieuUng = { batDau: Date.now(), quanBiAn: m.an || null, oAn: m.oAn, chieu: luat.biChieu(the, the.s), tu: m.tu, den: m.den };
    phatTiengNuoc(am, Boolean(m.an), hieuUng.chieu);
  }

  // Đi nước: hiện ngay trên màn hình rồi gửi server ngầm, không phải chờ mạng mới thấy quân di chuyển
  // s: bên đi nước này. Mặc định là bên mình; trận với máy thì trình duyệt này cũng đi nước của máy (s = "r").
  async function diNuoc(m: any, s: string = tran.ban_cua) {
    const ky = luat.kyHieu(m);
    apMove(m);
    tran.nuoc = [...tran.nuoc, ky];
    tran.den_luot = doiBen(s);
    // Máy không có hạn nước: tới lượt máy thì để trống, giống server
    tran.han_nuoc = tran.may_muc && tran.den_luot === "r" ? "" : new Date(Date.now() + lechGio + GIAY_MOI_NUOC * 1000).toISOString();
    const kt = luat.ketThuc(the, tran.nuoc.length);
    if (kt) {
      tran.trang_thai = "ket_thuc";
      tran.ket_qua = kt.ket_qua;
      tran.ly_do = kt.ly_do;
    }
    chon = null;
    gioDi = [];
    hienKhoi();
    dangGui = true;
    const { ok, data } = await goi("/api/tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "nuoc", ma, ky, gui: Date.now() + lechGio }),
    });
    dangGui = false;
    if (ok) {
      // Khớp với màn hình thì chỉ cập nhật giờ; lệch thì dựng lại theo server
      if (data.nuoc?.length === tran.nuoc.length && data.trang_thai === tran.trang_thai) {
        tran.han_nuoc = data.han_nuoc;
        if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      } else {
        nhanTran(data);
        dungBan();
        hienKhoi();
      }
      void kiemTraLuotMay(); // người chơi vừa đi xong, tới lượt máy
      return;
    }
    // Server từ chối (sai luật, hết giờ, đối thủ đã đầu hàng...): bỏ hiệu ứng, tải trạng thái thật và báo
    hieuUng = null;
    await taiTran();
    if (tran.trang_thai === "dang_dau") baoLoi(T.trNuocSai); // trận đã đóng thì thông báo đóng trận đã hiện rồi
  }

  // Trận với máy trên thượng đài chạy như trận với máy: trình duyệt này tính nước cho máy (Web Worker, cùng mức, cùng thời gian
  // nghĩ, cùng cách chọn nước) rồi gửi lên như một nước đi; server chỉ kiểm luật. Người chơi đóng trang thì máy đứng chờ.
  let dangMay = false; // máy đang nghĩ hoặc đang gửi nước
  let soLanMayLoi = 0; // số lần liên tiếp server từ chối nước của máy, quá 3 thì thôi để khỏi lặp mãi
  const nghi = (ms: number) => new Promise((xong) => setTimeout(xong, ms));

  // Tới lượt máy (và mình là người thách đấu) thì tính nước cho máy rồi đi
  async function kiemTraLuotMay() {
    if (dangMay || dangGui || !the || !tran?.may_muc || tran.ban_cua !== "b") return;
    if (tran.trang_thai !== "dang_dau" || tran.den_luot !== "r" || soLanMayLoi >= 3) return;
    dangMay = true;
    const soNuoc: number = tran.nuoc.length;
    const muc: number = tran.may_muc;
    try {
      giuTrangThaiDen = Date.now() + thoiGianNghi(muc) + 2000;
      batTrangThai(T.mayNghi);
      const kq: any = await may!.tinh(the, { ...(MUC as any)[tc.ma][muc], thoiGianMs: thoiGianNghi(muc), lichSu: tran.nuoc });
      if (!kq) return;
      // Máy nghĩ song song với hiệu ứng nước vừa đi: đợi hiệu ứng chạy xong (và nước của mình gửi xong) rồi mới đi
      const conLai = hieuUng ? tongThoiGianHieuUng(hieuUng.chieu) - (Date.now() - hieuUng.batDau) : 0;
      if (conLai > 0) await nghi(conLai);
      while (dangGui) await nghi(50);
      if (tran?.trang_thai !== "dang_dau" || tran.nuoc.length !== soNuoc) return; // trận đổi trong lúc máy nghĩ
      const chonMay = chonTrongDinh(kq.xep);
      const m = chonMay && luat.timNuoc(the, chonMay.nuoc);
      if (!m) return;
      await diNuoc(m, "r");
      soLanMayLoi = tran.nuoc.length === soNuoc + 1 ? 0 : soLanMayLoi + 1;
    } finally {
      dangMay = false;
    }
    if (soLanMayLoi > 0 && soLanMayLoi < 3) setTimeout(() => void kiemTraLuotMay(), 1500);
  }

  // Nhấp vào bàn: chọn quân của mình, rồi nhấp vào ô đích để đi
  banEl.addEventListener("click", async (e) => {
    am.mo(); // mở ngữ cảnh âm thanh ngay trong lúc người dùng bấm (iPhone chỉ cho phép như vậy)
    const o = oBamDuoc(e);
    if (!o || !the || dangGui || dangChonPhong || xemLai.dangXem() || tran?.trang_thai !== "dang_dau" || tran.den_luot !== tran.ban_cua) return;
    const [r, c] = o;
    const benMinh = tran.ban_cua;
    const quan = the.b[r][c];

    if (chon) {
      const cacNuoc = gioDi.filter((x) => x.den[0] === r && x.den[1] === c);
      if (cacNuoc.length) {
        let m = cacNuoc[0];
        // Nhiều nước cùng ô đến: tốt phong cấp ở cờ vua, hỏi người chơi chọn quân
        if (cacNuoc.length > 1) {
          dangChonPhong = true;
          const soNuoc = tran.nuoc.length;
          m = await chonNuocPhong(cacNuoc, ve, benMinh, (l: string) => T["quan" + l]);
          dangChonPhong = false;
          if (!m || tran.nuoc.length !== soNuoc || tran.trang_thai !== "dang_dau") {
            chon = null;
            gioDi = [];
            return veBan();
          }
        }
        return void diNuoc(m);
      }
    }
    if (quan && quan[0] === benMinh) {
      chon = [r, c];
      gioDi = luat.nuocHopLe(the).filter((m: any) => m.tu[0] === r && m.tu[1] === c);
    } else {
      chon = null;
      gioDi = [];
    }
    veBan();
  });

  // Đọc trạng thái trận, dựng lại bàn và hiện đúng khối việc
  async function taiTran() {
    if (!ma) return hienKhoiTao();
    const { ok, status, data } = await goi(`/api/tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok) {
      batTrangThai(status === 404 ? T.trTranKhongTim : (T.loiMang || ""));
      return;
    }
    nhanTran(data);
    daBaoKetThuc = data.trang_thai === "ket_thuc"; // mở một trận đã xong thì không phát tiếng kết thúc
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  function hienKhoiTao() {
    $("tr-tao").hidden = false;
    $("tr-ten-tao-hang").hidden = !!docToken(); // đã đăng nhập thì dùng tên tài khoản
    batTrangThai("");
  }

  // Dòng "Đối thủ: X · Còn N giây" và dòng trạng thái, cập nhật mỗi giây khi trận đang đi.
  // Hết giờ thì không xử thua: bên đang chờ thấy ba lựa chọn, bên chậm thấy đang chờ đối thủ quyết định.
  function capNhatGio() {
    if (tran?.trang_thai !== "dang_dau") return;
    const toi = tran.den_luot === tran.ban_cua;
    const ten = tenBen(tran.ban_cua === "r" ? "b" : "r");
    let hetGio = false;
    let gio: string;
    if (!tran.han_nuoc) {
      gio = T.trKhongGioiHan;
    } else {
      const giay = Math.ceil((Date.parse(tran.han_nuoc) - (Date.now() + lechGio)) / 1000);
      hetGio = giay <= 0;
      gio = hetGio ? T.trHetGioNgan : f(T.trGioCon, { s: giay });
    }
    doiEl.textContent = [ten ? f(T.trDoi, { ten }) : "", gio].filter(Boolean).join(" · ");
    $("tr-het-gio").hidden = !(hetGio && !toi);
    if (Date.now() >= giuTrangThaiDen) {
      const minhDo = tran.ban_cua === "r";
      batTrangThai(hetGio ? (toi ? T.trHetGioChoQuyet : T.trHetGioBanQuyet) : `${toi ? T.trToiLuot : T.trDoiLuot} · ${minhDo ? T.trBanDo : T.trBanDen}`);
    }
  }

  // Sau khi trận xong: đường đi tiếp (về sảnh thượng đài, hoặc tạo trận khép kín mới), theo loại cờ của trận
  function hienBuocTiep() {
    const a = $("tr-tiep-a") as HTMLAnchorElement;
    a.href = `${tienTo}${tran.loai === "dai" ? tc.duong.dai : tc.duong.tran}`;
    a.textContent = tran.loai === "dai" ? T.trVeSanh : T.trTranMoi;
    $("tr-tiep").hidden = false;
  }

  // Lý do kết thúc trận, theo cách gọi của loại cờ
  function lyDo(ly: string) {
    const ma: Record<string, string> = {
      het_gio: T.trLyHetGio, dau_hang: T.trLyDauHang, bo_do: T.trLyBoDo, het_nuoc: T.trLyHetNuoc,
      het_nuoc_hoa: f(T.trLyHetNuocHoa, { n: luat.NUOC_TOI_DA }), chieu_het: T.trLyChieuHet, hoa_pat: T.trLyHoaPat,
      lap_3: T.trLyLap3, luat_50: T.trLyLuat50, thieu_quan: T.trLyThieuQuan,
    };
    return ma[ly] || T.trLyHetNuoc;
  }

  function hienKhoi() {
    // Khay và hàng nút loa, phóng to chỉ hiện khi veBan() vẽ được bàn; mọi trạng thái chờ (kể cả đài thượng đài) thì ẩn
    $("co-khung").hidden = true;
    $("tr-thanh-nut").hidden = true;
    $("tr-tao").hidden = true;
    $("tr-link").hidden = true;
    $("tr-roi-dai").hidden = true;
    $("tr-vao").hidden = true;
    $("tr-dieu-khien").hidden = true;
    $("tr-tiep").hidden = true;
    $("tr-het-gio").hidden = true;
    capNhatNutXem();
    $("tr-mo-ta").hidden = tran?.loai === "dai"; // đoạn mô tả nói về trận khép kín, không đúng với trận thượng đài
    // Tiêu đề theo loại trận để người chơi biết mình đang ở trận nào; chưa rõ loại thì dùng tiêu đề chung
    const tieuDe = tran?.loai === "dai" ? T.tdTieuDe : tran?.loai === "khep_kin" ? T.trTieuDeKhepKin : T.trTieuDe;
    $("tr-h1").textContent = `${tieuDe} · ${T.tenCo}`;
    document.title = tieuDe;
    doiEl.textContent = "";
    clearInterval(gioTimer);

    // Người ngoài: link còn chờ thì hiện nút vào chơi
    if (!tran.ban_cua) {
      if (tran.loai === "dai") return batTrangThai(T.trVaoTuSanh); // trận thượng đài chỉ vào từ sảnh, không qua link
      if (tran.trang_thai === "cho") {
        $("tr-vao").hidden = false;
        $("tr-mo-ta").hidden = true; // đoạn mô tả nói với người tạo link, người được mời đã có phần giới thiệu riêng
        $("tr-moi-vao").textContent = f(T.trMoiVao, { ten: tran.ten_do || "" });
        ($("tr-ten-vao").parentElement as HTMLElement).hidden = !!docToken();
        return batTrangThai("");
      }
      return batTrangThai(tran.trang_thai === "huy" ? T.trHetHan : T.trDaCoNguoi);
    }

    // Người tạo đang chờ người vào: hiện link để gửi (và tự cập nhật khi có người vào)
    if (tran.trang_thai === "cho" && tran.loai === "dai") {
      $("tr-roi-dai").hidden = false;
      batTrangThai(T.trChoDoiThu);
      return datPoll();
    }
    if (tran.trang_thai === "cho") {
      $("tr-link").hidden = false;
      ($("tr-link-o") as HTMLInputElement).value = `${location.origin}${location.pathname}?ma=${ma}`;
      batTrangThai(T.trChoBan);
      return datPoll();
    }

    // Trận đã đóng: link bị người tạo vô hiệu hóa, hoặc bị bỏ dở quá lâu
    if (tran.trang_thai === "huy") {
      if (tran.nuoc?.length) veBan();
      hienBuocTiep();
      return batTrangThai(tran.ly_do === "bo_do" ? T.trTranDong : T.trDaVoHieu);
    }

    // Trận đang đi hoặc đã xong
    veBan();
    const minhDo = tran.ban_cua === "r";
    if (tran.trang_thai === "dang_dau") {
      $("tr-dieu-khien").hidden = false;
      giuTrangThaiDen = 0;
      capNhatGio();
      gioTimer = window.setInterval(capNhatGio, 1000);
      void kiemTraLuotMay(); // trận với máy: tới lượt máy thì tính nước cho máy
      return datPoll();
    }
    // Đã kết thúc
    const ten = tenBen(minhDo ? "b" : "r");
    doiEl.textContent = ten ? f(T.trDoi, { ten }) : "";
    const kq = tran.ket_qua === "do" ? T.trKetDo : tran.ket_qua === "den" ? T.trKetDen : T.trKetHoa;
    let diem = T.trKhongTinh;
    if (tran.loai === "dai") {
      const d = diemCongVan(ketQuaChoBen(tran.ket_qua, tran.ban_cua), 0);
      diem = f(T.trDiemTran, { diem: `${d > 0 ? "+" : ""}${d}` });
    }
    batTrangThai(`${kq}${tran.ly_do ? ` (${lyDo(tran.ly_do)})` : ""}. ${diem}`);
    hienBuocTiep();
    if (!daBaoKetThuc) {
      daBaoKetThuc = true;
      const thang = (tran.ket_qua === "do" && minhDo) || (tran.ket_qua === "den" && !minhDo);
      am.phat(tran.ket_qua === "hoa" ? "hoa" : thang ? "thang" : "thua", THOI_GIAN.DI + 500); // sau tiếng đi quân và hiệu ứng
    }
    datPoll();
  }

  // Đối thủ vừa đi thì bàn cập nhật và chạy hiệu ứng như nước đi của máy
  async function docMoi() {
    const cu: number = tran?.nuoc?.length ?? 0;
    const trangThaiCu = tran?.trang_thai;
    const { ok, data } = await goi(`/api/tran?ma=${encodeURIComponent(ma)}`, { headers: yeuCau() });
    if (!ok || dangGui) return; // người chơi vừa đi trong lúc chờ: bỏ kết quả cũ này
    const moi: number = data.nuoc?.length ?? 0;
    if (moi === cu && data.trang_thai === trangThaiCu) {
      if (data.bay_gio) lechGio = Date.parse(data.bay_gio) - Date.now();
      if (data.han_nuoc !== tran.han_nuoc) {
        tran.han_nuoc = data.han_nuoc; // đối thủ vừa cho thêm giờ hoặc cho nghĩ thoải mái
        capNhatGio();
      }
      return;
    }
    // Đúng một nước mới của đối thủ: đi nước đó trên bàn đang có để quân trượt, có tiếng, có hiệu ứng
    if (trangThaiCu === "dang_dau" && moi === cu + 1 && the && the.s === benDenLuot(cu)) {
      const m = luat.timNuoc(the, data.nuoc[moi - 1]);
      if (m) {
        apMove(m);
        nhanTran(data);
        chon = null;
        gioDi = [];
        return hienKhoi();
      }
    }
    nhanTran(data);
    chon = null;
    gioDi = [];
    dungBan();
    hienKhoi();
  }

  // Chuông mang kèm tóm tắt trận (số nước, nước cuối, hạn nước, trạng thái): đối thủ vừa đi một nước, hoặc vừa cho thêm giờ,
  // thì làm luôn trên bàn mà không gọi server. Trường hợp khác (trận đổi trạng thái, lệch số nước...) trả false để đọc lại cả trận.
  function apTomTat(t: any): boolean {
    if (!t || !the || tran?.trang_thai !== "dang_dau" || t.trang_thai !== "dang_dau") return false;
    const cu: number = tran.nuoc.length;
    if (t.n === cu) {
      if (t.han !== tran.han_nuoc) {
        tran.han_nuoc = t.han;
        capNhatGio();
      }
      return true;
    }
    const s = benDenLuot(cu);
    if (t.n !== cu + 1 || s === tran.ban_cua || the.s !== s) return false; // nước của chính mình từ tab khác: đọc lại cho chắc
    const m = luat.timNuoc(the, t.ky);
    if (!m) return false;
    apMove(m);
    tran.nuoc = [...tran.nuoc, t.ky];
    tran.den_luot = doiBen(s);
    tran.han_nuoc = t.han;
    chon = null;
    gioDi = [];
    hienKhoi();
    // Độ trễ từ lúc đối thủ bấm tới lúc quân hiện ở đây (theo giờ server ước lượng ở hai máy, sai số cỡ vài chục ms)
    if (t.gui) console.info(`[choico] nước đối thủ tới sau ${Math.round(Date.now() + lechGio - t.gui)} ms`);
    return true;
  }

  // Chuông báo realtime của trận: đang nghe được thì chỉ đọc lại khi chuông rung, cộng một lần dự phòng thưa.
  // Không nghe được (trận cũ chưa có chuông, mạng chặn SSE...) thì quay về đọc lại theo nhịp như trước.
  const DU_PHONG_MS = 20000;
  let dangNghe = false;
  let chuongDangNghe = "";
  let dungNghe: (() => void) | null = null;
  function capNhatNghe(can: boolean) {
    const id: string = can ? tran?.tin_hieu || "" : "";
    if (id === chuongDangNghe) return;
    dungNghe?.();
    dungNghe = null;
    dangNghe = false;
    chuongDangNghe = id;
    if (!id) return;
    dungNghe = ngheTinHieu(
      id,
      (banGhi: any) => {
        if (dangGui) return;
        // Chuông rung: có tóm tắt dùng được thì đi quân ngay, không thì đọc trạng thái mới; rồi hẹn lại lần dự phòng
        if (apTomTat(banGhi?.tom_tat)) return datPoll();
        void docMoi().then(() => datPoll());
      },
      (ok: boolean) => {
        const doi = ok !== dangNghe;
        dangNghe = ok;
        if (doi) datPoll(); // đổi nhịp đọc dự phòng theo việc có nghe được chuông hay không
      },
    );
  }

  // Hẹn lần đọc lại tiếp theo: có chuông thì thưa (dự phòng); không có thì nhanh khi chờ đối thủ đi, chậm hơn khi đến lượt mình hoặc tab ẩn
  function datPoll() {
    clearTimeout(pollId);
    pollId = undefined;
    const caoNhat = tran?.ban_cua && (tran.trang_thai === "dang_dau" || tran.trang_thai === "cho");
    capNhatNghe(Boolean(caoNhat)); // trận xong thì thôi nghe
    if (!caoNhat) return;
    const luotMinh = tran.trang_thai === "dang_dau" && tran.den_luot === tran.ban_cua;
    const doTre = dangNghe ? DU_PHONG_MS : document.hidden ? 5000 : tran.trang_thai === "cho" || luotMinh ? 2500 : 1000;
    pollId = window.setTimeout(async () => {
      pollId = undefined;
      await docMoi();
      datPoll();
    }, doTre);
  }

  // Tạo link (tài khoản hoặc khách) cho loại cờ của trang, xong thì chuyển sang trang có mã
  nut("tr-nut-tao").addEventListener("click", () => void chay(nut("tr-nut-tao"), T.trDangTao, async () => {
    const tenKhach = ($("tr-ten-tao") as HTMLInputElement).value.trim();
    const tao = () => goi("/api/khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "tao", tro_choi: TRO_CHOI_TRANG, ten_khach: tenKhach }),
    });
    let { ok, status, data } = await tao();
    // Người mới đăng nhập chưa có tên: tạo tên từ tên Google (như trang chơi với máy) rồi tạo link lại
    if (status === 409 && data.loi === "chua_co_ten" && (await damBaoCoTen())) ({ ok, status, data } = await tao());
    if (ok && data.ma) {
      location.href = `${location.pathname}?ma=${data.ma}`;
      return true;
    }
    batTrangThai(status === 429 ? T.trTaoQuaNhieu : T.tdLoi);
  }));

  nut("tr-nut-chep").addEventListener("click", async () => {
    const o = $("tr-link-o") as HTMLInputElement;
    try {
      await navigator.clipboard.writeText(o.value);
      $("tr-nut-chep").textContent = T.trDaChep;
      setTimeout(() => ($("tr-nut-chep").textContent = T.trChepLink), 2000);
    } catch {
      o.select();
    }
  });

  // Vô hiệu hóa link: xong thì khối link biến mất và thông báo nháy lên
  nut("tr-nut-vo-hieu").addEventListener("click", () => void chay(nut("tr-nut-vo-hieu"), T.trDangXuLy, async () => {
    const { ok } = await goi("/api/khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "huy", ma }),
    });
    if (!ok) return void batTrangThai(T.tdLoi);
    await taiTran(); // trạng thái "huy": hiện thông báo link đã vô hiệu hóa
    batTrangThai(T.trDaVoHieu);
  }));

  nut("tr-nut-vao").addEventListener("click", () => void chay(nut("tr-nut-vao"), T.trDangXuLy, async () => {
    const tenKhach = ($("tr-ten-vao") as HTMLInputElement).value.trim();
    const { ok, data } = await goi("/api/khep-kin", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "vao", ma, ten_khach: tenKhach }),
    });
    if (ok) return void (await taiTran());
    batTrangThai(data.loi === "da_co_nguoi_vao" ? T.trDaCoNguoi : data.loi === "link_het_han" ? T.trHetHan : T.tdLoi);
  }));

  nut("tr-nut-dau-hang").addEventListener("click", () => void chay(nut("tr-nut-dau-hang"), T.trDangXuLy, async () => {
    const { ok, data } = await goi("/api/tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "dau_hang", ma }),
    });
    if (!ok) return void (await taiTran());
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }));

  // Đối thủ hết giờ: chọn cho nghĩ thêm 1 phút, nghĩ thoải mái hoặc xử thua
  async function xuHetGio(luaChon: string) {
    const { ok, data } = await goi("/api/tran", {
      method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "xu_het_gio", ma, lua_chon: luaChon }),
    });
    if (!ok) return void (await taiTran()); // trạng thái đã đổi (đối thủ vừa đi): tải lại cho đúng
    nhanTran(data);
    chon = null;
    gioDi = [];
    hienKhoi();
  }
  nut("tr-nut-them").addEventListener("click", () => void chay(nut("tr-nut-them"), T.trDangXuLy, () => xuHetGio("them_1_phut")));
  nut("tr-nut-thoai").addEventListener("click", () => void chay(nut("tr-nut-thoai"), T.trDangXuLy, () => xuHetGio("thoai_mai")));
  nut("tr-nut-xu").addEventListener("click", () => void chay(nut("tr-nut-xu"), T.trDangXuLy, () => xuHetGio("xu_thua")));

  // Rời đài khi chưa có ai thách đấu, rồi về sảnh của loại cờ đó
  nut("tr-nut-roi-dai").addEventListener("click", () => void chay(nut("tr-nut-roi-dai"), T.trDangXuLy, async () => {
    await goi("/api/dai", { method: "POST", headers: yeuCau(), body: JSON.stringify({ hanh_dong: "roi_dai", ma }) });
    location.href = `${tienTo}${tc.duong.dai}`;
    return true;
  }));

  void taiTran();
</script>
</Layout>

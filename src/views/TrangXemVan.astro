---
// Trang xem lại một ván cờ qua link (?ma=...), dùng chung cho mọi ngôn ngữ.
import Layout from "../layouts/Layout.astro";
import CoTuong from "../components/CoTuong.astro";
import { t } from "../i18n/strings.js";

const { lang = "vi" } = Astro.props;
---
<Layout lang={lang} tieuDe={t(lang, "xvTieuDe")} moTa={t(lang, "xvMoTa")}>
  <CoTuong lang={lang} xemVan />
</Layout>

---
// Trang xem lại một ván đấu máy qua link (?ma=...), dùng chung cho mọi ngôn ngữ. Bàn đổi theo loại cờ của ván được mở.
import Layout from "../layouts/Layout.astro";
import ChoiVoiMay from "../components/ChoiVoiMay.astro";
import { t } from "../i18n/strings.js";

const { lang = "vi", troChoi = "co_tuong" } = Astro.props;
---
<Layout lang={lang} tieuDe={t(lang, "xvTieuDe")} moTa={t(lang, "xvMoTa")} khongLapChiMuc>
  <ChoiVoiMay lang={lang} troChoi={troChoi} xemVan />
</Layout>
